@* Erforderliche Namespaces für Schnittstellen, UI-Helfer und Datenmodelle *@
@using StudyScope.Core.Interfaces
@using StudyScope.Core.Models
@using StudyScope.UI.Services
@using StudyScope.ViewModels
@using Microsoft.JSInterop

@* Dependency Injection: Bereitstellung der ViewModel-Logik und des nativen Dateiöffners *@
@inject DocumentListViewModel DocVm
@inject SettingsViewModel SettingsVm
@inject LayoutViewModel LayoutVm
@inject IFileOpenerService FileOpenerService
@inject IJSRuntime JS
@implements IDisposable

<!-- Linke Seitenleiste: Verwaltung von Profilen, Suchfilter und Dokumentenliste (ein-/ausklappbar, Strg+B) -->
<div class="ss-sidebar @(LayoutVm.IsSidebarCollapsed ? "collapsed" : "")" style="@WidthStyle">

<!-- Ziehbare Trennlinie: Maus (Pointer Events, studyscope-layout.js), Doppelklick = Standardbreite, Tastatur ← → Pos1 Ende -->
<div @ref="resizerRef" class="ss-sidebar-resizer" role="separator" aria-orientation="vertical"
     aria-label="@UiStrings.Sidebar_ResizerLabel" title="@UiStrings.Sidebar_ResizerTitle"
     aria-valuemin="@Px(LayoutViewModel.MinSidebarWidth)" aria-valuemax="@Px(LayoutVm.MaxSidebarWidthNow)" aria-valuenow="@Px(LayoutVm.EffectiveSidebarWidth)"
     tabindex="@(LayoutVm.IsSidebarCollapsed ? "-1" : "0")"
     @ondblclick="LayoutVm.ResetWidthAsync"></div>

<!-- Eingeklappt: schmale Leiste mit ▶ und Hinweis auf die aktiven Dokumente -->
<div class="ss-sidebar-rail" aria-hidden="@(LayoutVm.IsSidebarCollapsed ? "false" : "true")">
    <button type="button" class="ss-icon-btn ss-flip-rtl" title="@LayoutVm.ToggleTooltip" aria-label="@UiStrings.Sidebar_Show"
            tabindex="@(LayoutVm.IsSidebarCollapsed ? "0" : "-1")" @onclick="LayoutVm.ToggleAsync">▶</button>
    <button type="button" class="ss-rail-docs" title="@LayoutViewModel.DocumentBadgeTooltip(DocVm.CurrentProfileDisplayName, DocVm.Documents, DocVm.IsWebSearchActive)"
            aria-label="@UiStrings.Sidebar_ActiveDocsShow"
            tabindex="@(LayoutVm.IsSidebarCollapsed ? "0" : "-1")" @onclick="LayoutVm.ToggleAsync">
        <span class="ss-rail-icon">📄</span>
        <span>@LayoutViewModel.DocumentCount(DocVm.Documents)</span>
        @if (DocVm.IsWebSearchActive)
        {
            <span class="ss-rail-icon">🌐</span>
        }
    </button>
</div>

<div class="ss-sidebar-inner">

    <!-- 1. Profil-Kopfbereich -->
    <div style="margin-bottom: 5px;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <label style="font-weight: bold; font-size: 13px; color: var(--ss-text-2);">@UiStrings.Sidebar_ProfileLabel</label>
            <button type="button" class="ss-icon-btn ss-flip-rtl" title="@LayoutVm.ToggleTooltip" aria-label="@UiStrings.Sidebar_Hide"
                    @onclick="LayoutVm.ToggleAsync">◀</button>
        </div>

        <div style="display: flex; gap: 6px; margin-top: 6px; align-items: center;">
            <!-- Profil-Dropdown -->
            <select value="@DocVm.CurrentProfile"
                    @onchange="OnProfileChangedAsync"
                    style="flex: 1; height: 32px; padding: 0 8px; border-radius: 4px; border: 1px solid var(--ss-border); font-size: 13px; font-weight: bold; background: var(--ss-surface); outline: none; box-sizing: border-box;">
                @foreach (var profile in DocVm.AvailableProfiles)
                {
                    <option value="@profile">@DocVm.DisplayName(profile)</option>
                }
            </select>

            <!-- Button: Neues Profil erstellen (öffnet den modalen Dialog) -->
            <button type="button"
                    style="width: 32px; height: 32px; padding: 0; background: var(--ss-success); color: var(--ss-on-accent); border: none; border-radius: 4px; cursor: pointer; font-size: 19px; font-weight: bold; display: inline-flex; align-items: center; justify-content: center; line-height: 1; flex-shrink: 0;"
                    title="@UiStrings.Sidebar_NewProfile"
                    @onclick="OpenCreateProfileModal">
                +
            </button>

            <!-- Button: Aktuelles Profil löschen (deaktiviert bei 'Standard') -->
            @if (!ProfileDisplay.IsDefault(DocVm.CurrentProfile))
            {
                <button type="button"
                        style="width: 32px; height: 32px; padding: 0; background: var(--ss-danger); color: var(--ss-on-accent); border: none; border-radius: 4px; cursor: pointer; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; line-height: 1; flex-shrink: 0;"
                        title="@UiStrings.Sidebar_DeleteProfile"
                        @onclick="DeleteCurrentProfileAsync">
                    🗑️
                </button>
            }
        </div>
    </div>

    <!-- Websuche im Chat (je Profil, standardmäßig aus) – abgesetzt von den Dokumenten, unberührt von „Alle an/aus“ und Filter -->
    <div class="ss-websearch-row">
        <label class="ss-websearch-toggle" title="@(webSearchNotConfigured ? UiStrings.Sidebar_WebSearchSetupTitle : UiStrings.Sidebar_WebSearchTitle)">
            <input type="checkbox" checked="@DocVm.IsWebSearchActive" @onclick="OnWebSearchToggledAsync" @onclick:preventDefault="true" />
            <span>@UiStrings.Sidebar_WebSearch</span>
        </label>
        <!-- Außerhalb des label: ein Klick auf ⚙ schaltet das Häkchen nicht um -->
        <button type="button" class="ss-icon-btn ss-websearch-settings" title="@UiStrings.Sidebar_WebSearchSettings" aria-label="@UiStrings.Sidebar_WebSearchSettings"
                @onclick="() => OnOpenWebSearchSettings.InvokeAsync()">⚙</button>
    </div>

    <!-- 2. Bereich: Volltextsuche / Filter -->
    <div style="display: flex; align-items: center; border: 1px solid var(--ss-border); border-radius: 4px; background: var(--ss-surface); padding: 4px 8px;">
        <span style="margin-inline-end: 5px; color: var(--ss-text-muted);">🔍</span>
        <input type="text"
               placeholder="@UiStrings.Sidebar_SearchPlaceholder"
               style="border: none; outline: none; width: 100%; font-size: 13px; background: transparent; color: var(--ss-text);"
               @bind="DocVm.SearchText"
               @bind:event="oninput" />
    </div>

    <!-- 3. Bereich: Steuerbuttons (Alle an / Alle aus) -->
    <div style="display: flex; gap: 6px;">
        <button type="button"
                style="flex: 1; padding: 6px 8px; font-size: 12px; font-weight: 600; color: var(--ss-on-accent); background: var(--ss-primary); border: 1px solid var(--ss-primary); border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 4px;"
                title="@UiStrings.Sidebar_SelectAllTitle"
                @onclick="DocVm.SelectAllAsync">
            @UiStrings.Sidebar_SelectAll
        </button>
        <button type="button"
                style="flex: 1; padding: 6px 8px; font-size: 12px; font-weight: 600; color: var(--ss-link); background: var(--ss-surface); border: 1px solid var(--ss-primary); border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 4px;"
                title="@UiStrings.Sidebar_DeselectAllTitle"
                @onclick="DocVm.DeselectAllAsync">
            @UiStrings.Sidebar_DeselectAll
        </button>
    </div>

    <!-- 4. Bereich: Dokumentenliste -->
    <div style="flex: 1; overflow-y: auto; border: 1px solid var(--ss-border-faint); background: var(--ss-surface); border-radius: 4px; padding: 6px;">
        @if (!DocVm.FilteredDocuments.Any())
        {
            <div style="font-size: 12px; color: var(--ss-text-muted); text-align: center; margin-top: 20px;">
                @(DocVm.Documents.Any() ? Loc.Format(UiStrings.Sidebar_NoMatches, ("search", DocVm.SearchText)) : UiStrings.Sidebar_NoDocuments)
            </div>
        }
        else
        {
            @foreach (var doc in DocVm.FilteredDocuments)
            {
                <div style="display: flex; align-items: center; gap: 8px; padding: 6px; border-bottom: 1px solid var(--ss-border-faint); font-size: 13px; user-select: none;"
                     title="@Loc.Format(UiStrings.Sidebar_OpenHint, ("path", doc.FilePath))">

                    <input type="checkbox" checked="@doc.IsSelected" @onchange="e => DocVm.SetDocumentSelectedAsync(doc, e.Value is true)" />

                    <!-- Format-Icon und Dateiname -->
                    <span class="@(doc.IsMissing ? "strikethrough" : "")"
                          style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; display: flex; align-items: center; gap: 6px;"
                          @ondblclick="() => HandleDocumentDoubleClick(doc)">
                        <span>@(doc.IsMissing ? "⚠️" : GetFileIcon(doc.FilePath))</span>
                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@doc.FileName">@doc.FileName</span>
                    </span>

                    <button type="button"
                            style="background: none; border: none; cursor: pointer; color: var(--ss-danger-fg); font-size: 13px; padding: 0 4px;"
                            @onclick="() => DocVm.RemoveDocumentAsync(doc)"
                            title="@UiStrings.Sidebar_Remove">
                        ✕
                    </button>
                </div>
            }
        }
    </div>

    <!-- 5. Bereich: Hinzufügen-Aktion -->
    <button type="button"
            style="padding: 10px; background: var(--ss-success); color: var(--ss-on-accent); border: none; border-radius: 4px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 13px;"
            @onclick="AddDocumentFromDialogAsync">
        @UiStrings.Sidebar_AddDocument
    </button>
</div>
</div>

@if (showWebSearchNotice)
{
    <WebSearchNoticeDialog ProviderName="@DocVm.WebSearchProviderName" ProfileName="@DocVm.CurrentProfileDisplayName"
                           IsLocalAi="DocVm.IsLocalChatAi" OnAccept="AcceptWebSearchNoticeAsync" OnCancel="CancelWebSearchNotice" />
}

<!-- Modal-Dialog: Neues Profil anlegen -->
@if (showCreateModal)
{
    <div data-ss-dialog style="position: fixed; inset: 0; width: 100vw; height: 100vh; background: var(--ss-overlay); display: flex; align-items: center; justify-content: center; z-index: 2000;">
        <div style="background: var(--ss-surface); border-radius: 8px; width: 340px; padding: 20px; box-shadow: var(--ss-dialog-shadow); display: flex; flex-direction: column; gap: 12px; font-family: Segoe UI, sans-serif;">

            <h4 style="margin: 0; font-size: 15px; color: var(--ss-text);">@UiStrings.NewProfile_Title</h4>
            <span style="font-size: 12px; color: var(--ss-text-muted);">@UiStrings.NewProfile_Prompt</span>

            <input type="text"
                   placeholder="@UiStrings.Sidebar_NewProfilePlaceholder"
                   style="width: 100%; padding: 8px 10px; font-size: 13px; border: 1px solid @(profileNameError == null ? "var(--ss-primary)" : "var(--ss-danger)"); border-radius: 4px; outline: none; box-sizing: border-box;"
                   @bind="newProfileName"
                   @bind:event="oninput"
                   @bind:after="UpdateProfileNameError"
                   @onkeydown="HandleKeyDownAsync"
                   autofocus />

            @if (profileNameError != null)
            {
                <span id="profile-name-error" style="font-size: 12px; color: var(--ss-danger-fg); margin-top: -6px;">@profileNameError</span>
            }

            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 6px;">
                <button type="button" data-ss-dialog-close
                        style="padding: 6px 14px; background: var(--ss-secondary); color: var(--ss-on-accent); border: none; border-radius: 4px; cursor: pointer; font-size: 12px;"
                        @onclick="CancelCreateProfile">
                    @UiStrings.Common_Cancel
                </button>
                <button type="button"
                        style="padding: 6px 16px; background: var(--ss-success); color: var(--ss-on-accent); border: none; border-radius: 4px; font-weight: bold; cursor: @(CanCreateProfile ? "pointer" : "not-allowed"); opacity: @(CanCreateProfile ? "1" : "0.6"); font-size: 12px;"
                        disabled="@(!CanCreateProfile)"
                        @onclick="ConfirmCreateProfileAsync">
                    @UiStrings.Sidebar_CreateAndConfigure
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnOpenSettings { get; set; }

    /// <summary>Kein Suchdienst eingerichtet: Das Häkchen öffnet Einstellungen › Websuche statt einzuschalten.</summary>
    [Parameter] public EventCallback OnOpenWebSearchSettings { get; set; }

    private bool showWebSearchNotice;
    private bool webSearchNotConfigured;

    // Der Browser schaltet das Häkchen nicht selbst um (preventDefault): Es zeigt immer den gespeicherten Zustand –
    // auch wenn der Hinweis abgebrochen wird (Blazor würde ein unverändertes „aus“ sonst nicht zurücksetzen)
    private async Task OnWebSearchToggledAsync()
    {
        var result = await DocVm.RequestWebSearchAsync(!DocVm.IsWebSearchActive);
        webSearchNotConfigured = result == WebSearchToggleResult.NotConfigured;
        switch (result)
        {
            case WebSearchToggleResult.NeedsNotice:
                showWebSearchNotice = true;
                break;
            case WebSearchToggleResult.NotConfigured:
                if (OnOpenWebSearchSettings.HasDelegate)
                    await OnOpenWebSearchSettings.InvokeAsync();
                break;
        }
        // Das Häkchen zeigt immer den gespeicherten Zustand (bei Hinweis/Einstellungen bleibt es aus)
        StateHasChanged();
    }

    private async Task AcceptWebSearchNoticeAsync()
    {
        showWebSearchNotice = false;
        await DocVm.AcceptWebSearchNoticeAsync(DocVm.WebSearchProviderName);
    }

    private void CancelWebSearchNotice() => showWebSearchNotice = false;

    private ElementReference resizerRef;
    private DotNetObjectReference<SidebarPanel>? selfRef;

    // Zahlen für Stil und aria-Attribute immer mit Punkt (deutsche Kultur schreibt Kommas)
    private static string Px(double value) => Math.Round(value).ToString(System.Globalization.CultureInfo.InvariantCulture);
    private string WidthStyle => $"--ss-sidebar-width: {Px(LayoutVm.EffectiveSidebarWidth)}px";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("studyScopeLayout.attachResizer", resizerRef, selfRef, new
            {
                min = LayoutViewModel.MinSidebarWidth,
                minContent = LayoutViewModel.MinContentWidth,
                maxFraction = LayoutViewModel.MaxSidebarFraction,
                collapseBelow = LayoutViewModel.CollapseDragWidth
            });
        }
        catch (JSException)
        {
            // Skript nicht geladen – Breite bleibt, Doppelklick und Einklappen funktionieren weiter
        }
    }

    /// <summary>Ende des Ziehens (studyscope-layout.js): begrenzen und speichern bzw. einklappen; null = eingeklappt.</summary>
    [JSInvokable]
    public Task<double?> EndSidebarResize(double requestedWidth) => LayoutVm.EndResizeAsync(requestedWidth);

    /// <summary>Pfeil links/rechts, Pos1, Ende auf der fokussierten Trennlinie.</summary>
    [JSInvokable]
    public Task<bool> OnSeparatorKey(string key) => LayoutVm.HandleSeparatorKeyAsync(key);

    private bool showCreateModal = false;
    private string newProfileName = string.Empty;
    private string? profileNameError;

    // Prüfung liegt im ViewModel; die Komponente zeigt nur das Ergebnis an
    private bool CanCreateProfile => DocVm.ValidateProfileName(newProfileName) == null;

    private void UpdateProfileNameError()
    {
        // Leeres Feld nur sperren, nicht sofort als Fehler anzeigen
        profileNameError = string.IsNullOrWhiteSpace(newProfileName) ? null : DocVm.ValidateProfileName(newProfileName);
    }

    private string GetFileIcon(string filePath) => Path.GetExtension(filePath)?.ToLowerInvariant() switch
    {
        ".pdf" => "📄",
        ".txt" => "📝",
        ".csv" => "📊",
        _ => "📁"
    };

    private void OpenCreateProfileModal()
    {
        newProfileName = string.Empty;
        profileNameError = null;
        showCreateModal = true;
    }

    private void CancelCreateProfile()
    {
        newProfileName = string.Empty;
        profileNameError = null;
        showCreateModal = false;
    }

    private async Task ConfirmCreateProfileAsync()
    {
        // 1. ZUERST das neue Profil im ViewModel erstellen und aktivieren (ungültige Namen lehnt das ViewModel ab)
        if (!await DocVm.CreateNewProfileAsync(newProfileName))
        {
            profileNameError = DocVm.ValidateProfileName(newProfileName);
            return;
        }

        // 2. SettingsViewModel für das neue Profil frisch zurücksetzen
        SettingsVm.ResetForm();

        // 3. Modal schließen
        showCreateModal = false;
        newProfileName = string.Empty;

        // 4. Direkt die KI-Konfigurationsmaske für das neue Profil öffnen
        if (OnOpenSettings.HasDelegate)
        {
            await OnOpenSettings.InvokeAsync();
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        // Esc schließt über studyscope-layout.js (data-ss-dialog), wie bei allen Dialogen
        if (e.Key == "Enter" && CanCreateProfile)
        {
            await ConfirmCreateProfileAsync();
        }
    }

    private async Task OnProfileChangedAsync(ChangeEventArgs e)
    {
        var newProfile = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(newProfile))
        {
            await DocVm.SwitchProfileAsync(newProfile);
            await SettingsVm.InitializeAsync();
        }
    }

    private async Task DeleteCurrentProfileAsync()
    {
        var profileToDelete = DocVm.CurrentProfile;
        if (ProfileDisplay.IsDefault(profileToDelete))
            return;

        await DocVm.DeleteProfileAsync(profileToDelete);
        await SettingsVm.InitializeAsync();
    }

    private void HandleDocumentDoubleClick(DocumentItem doc)
    {
        FileOpenerService.OpenFile(doc.FilePath);
    }

    private async Task AddDocumentFromDialogAsync()
    {
        var selectedFilePath = await DesktopDialogs.OpenPdfAsync();
        if (!string.IsNullOrWhiteSpace(selectedFilePath))
        {
            await DocVm.AddDocumentAsync(selectedFilePath);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        DocVm.PropertyChanged += OnDocVmPropertyChanged;
        LayoutVm.PropertyChanged += OnDocVmPropertyChanged;

        if (!DocVm.AvailableProfiles.Any())
        {
            await DocVm.InitializeAsync();
        }
    }

    private void OnDocVmPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DocVm.PropertyChanged -= OnDocVmPropertyChanged;
        LayoutVm.PropertyChanged -= OnDocVmPropertyChanged;
        selfRef?.Dispose();
    }
}

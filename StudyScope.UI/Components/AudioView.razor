@using System.Globalization
@using Microsoft.JSInterop
@using StudyScope.Core.Interfaces
@using StudyScope.UI.Services
@inject AudioViewModel AuVm
@inject DocumentListViewModel DocVm
@inject BrowserSpeechService SystemSpeech
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="au-root">

    <div class="au-toolbar">
        <div>
            <h3 style="margin: 0; font-size: 16px; color: #212529;">Audio-Zusammenfassung: @DocVm.CurrentProfile</h3>
            <span style="font-size: 12px; color: #6c757d;">
                @(AuVm.Items.Count == 0 ? "Noch keine Beiträge" : AuVm.Items.Count == 1 ? "1 Beitrag" : $"{AuVm.Items.Count} Beiträge")
                · Grundlage: @ActiveDocumentsText
            </span>
        </div>
        @if (!AuVm.IsFormOpen && !AuVm.IsBusy)
        {
            <button type="button" class="au-btn" style="background: #007bff;" @onclick="AuVm.OpenForm">➕ Neuer Beitrag</button>
        }
    </div>

    @if (AuVm.IsBusy)
    {
        <div class="au-info">
            <div style="font-weight: 600; font-size: 13px;">🎧 KI liest die Dokumente und schreibt das Sprechskript (@AudioScriptFormats.DisplayName(AuVm.Format), @AudioScriptFormats.LengthName(AuVm.Length)) ...</div>
            <div class="au-progress"><div class="au-progress-bar"></div></div>
            <div style="display: flex; justify-content: center; gap: 10px; align-items: center; margin-top: 6px;">
                <span style="font-size: 11px; color: #6c757d;">Je nach Modell und Länge kann das etwas dauern.</span>
                <button type="button" class="au-btn" style="background: #6c757d; padding: 4px 10px;" @onclick="AuVm.Cancel">Abbrechen</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(AuVm.StatusMessage))
    {
        var (statusBg, statusBorder, statusText) = AuVm.IsError
            ? ("#f8d7da", "#f5c6cb", "#721c24")
            : AuVm.IsWarning ? ("#fff3cd", "#ffeeba", "#856404") : ("#d4edda", "#c3e6cb", "#155724");

        <div class="au-status" style="background: @statusBg; border-color: @statusBorder; color: @statusText;">
            <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 600;">@AuVm.StatusMessage</div>
                @if (AuVm.StatusTips.Count > 0)
                {
                    <ul style="margin: 4px 0 0 18px; line-height: 1.5;">
                        @foreach (var tip in AuVm.StatusTips)
                        {
                            <li>@tip</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrEmpty(AuVm.StatusDetails))
                {
                    <details style="margin-top: 6px;">
                        <summary style="cursor: pointer; font-size: 11px; opacity: 0.85;">Technische Details (Antwort der KI)</summary>
                        <pre class="au-details-raw">@AuVm.StatusDetails</pre>
                    </details>
                }
            </div>
            <button style="background: none; border: none; cursor: pointer; color: inherit; font-weight: bold; font-size: 14px; align-self: flex-start;" title="Meldung schließen" @onclick="AuVm.ClearStatus">✕</button>
        </div>
    }

    <div class="au-body">
        <!-- Linke Spalte: neuer Beitrag, Liste und Sprachausgabe -->
        <div class="au-side">
            @if (AuVm.IsFormOpen)
            {
                <div class="au-card" style="border-color: #9ec5fe;">
                    <h4>➕ Neuer Audio-Beitrag</h4>

                    <label class="au-label">Format</label>
                    <div class="au-choices">
                        @foreach (var format in AudioScriptFormats.All)
                        {
                            var current = format;
                            <button type="button" class="au-choice @(AuVm.Format == current ? "active" : "")" disabled="@AuVm.IsBusy" @onclick="() => AuVm.Format = current">
                                <span style="font-size: 18px;">@AudioScriptFormats.Icon(current)</span>
                                <span>
                                    <b>@AudioScriptFormats.DisplayName(current)</b>
                                    <span class="au-desc">@AudioScriptFormats.Description(current)</span>
                                </span>
                            </button>
                        }
                    </div>

                    <label class="au-label">Länge</label>
                    <div class="au-lengths">
                        @foreach (var length in AudioScriptFormats.AllLengths)
                        {
                            var current = length;
                            <button type="button" class="au-length @(AuVm.Length == current ? "active" : "")" disabled="@AuVm.IsBusy" @onclick="() => AuVm.Length = current">@AudioScriptFormats.LengthName(current)</button>
                        }
                    </div>

                    <label class="au-label">Schwerpunkt / Thema <span style="font-weight: normal; color: #6c757d;">(optional)</span></label>
                    <input class="au-input" placeholder="z. B. Photosynthese" @bind="AuVm.Topic" @bind:event="oninput" />
                    <div class="au-meta" style="margin-top: 3px;">Grenzt den Beitrag auf passende Textstellen ein; sonst wird das ganze Material berücksichtigt.</div>

                    <label class="au-label">Titel <span style="font-weight: normal; color: #6c757d;">(optional – sonst wählt die KI einen)</span></label>
                    <input class="au-input" @bind="AuVm.CustomTitle" @bind:event="oninput" />

                    <button type="button" class="au-btn" style="background: #28a745; width: 100%; justify-content: center; margin-top: 14px; padding: 9px;"
                            disabled="@(AuVm.IsBusy || ActiveDocumentCount == 0)" @onclick="GenerateAsync">
                        ✨ Skript erstellen
                    </button>
                    @if (ActiveDocumentCount == 0)
                    {
                        <div class="au-meta" style="color: #b02a37; margin-top: 6px;">Bitte links mindestens ein Dokument aktivieren.</div>
                    }
                    <div class="au-meta" style="margin-top: 6px;">Das Skript schreibt die KI aus Ihren Einstellungen; vorgelesen wird es mit der gewählten Sprachausgabe.</div>
                    @if (AuVm.Items.Count > 0 && !AuVm.IsBusy)
                    {
                        <button type="button" class="au-link" style="margin-top: 8px;" @onclick="() => AuVm.IsFormOpen = false">Abbrechen</button>
                    }
                </div>
            }

            @if (AuVm.Items.Count > 0)
            {
                <div class="au-card">
                    <h4>🎧 Gespeicherte Beiträge</h4>
                    @foreach (var item in AuVm.Items)
                    {
                        var it = item;
                        var isSelected = AuVm.SelectedSummary?.Id == it.Id && !AuVm.IsFormOpen;
                        <div class="au-item @(isSelected ? "active" : "")" @onclick="() => SelectItem(it.Id)">
                            <span style="font-size: 16px;">@AudioScriptFormats.Icon(it.Format)</span>
                            <div style="flex: 1; min-width: 0;">
                                @if (renameId == it.Id)
                                {
                                    <input class="au-input" style="padding: 3px 6px;" @bind="renameText" @bind:event="oninput" @onclick:stopPropagation="true"
                                           @onkeydown="e => RenameKeyAsync(e, it.Id)" />
                                }
                                else
                                {
                                    <div class="au-item-title" title="@it.Title">@it.Title</div>
                                }
                                <div class="au-meta">@AudioScriptFormats.DisplayName(it.Format) · @AudioScriptFormats.FormatMinutes(it.EstimatedMinutes) · @it.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                            <div style="display: flex; gap: 2px; flex-shrink: 0;" @onclick:stopPropagation="true">
                                @if (renameId == it.Id)
                                {
                                    <button class="au-icon" title="Übernehmen" @onclick="() => RenameAsync(it.Id)">✔</button>
                                    <button class="au-icon" title="Abbrechen" @onclick="() => renameId = null">✕</button>
                                }
                                else if (confirmDeleteId == it.Id)
                                {
                                    <button class="au-btn" style="background: #dc3545; padding: 2px 8px; font-size: 12px;" @onclick="() => DeleteAsync(it.Id)">Löschen?</button>
                                    <button class="au-icon" title="Nicht löschen" @onclick="() => confirmDeleteId = null">✕</button>
                                }
                                else
                                {
                                    <button class="au-icon" title="Umbenennen" @onclick="() => StartRename(it)">✏️</button>
                                    <button class="au-icon" title="Beitrag löschen (samt Audiodatei)" @onclick="() => confirmDeleteId = it.Id">🗑️</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @SpeechPanel()
        </div>

        <!-- Rechte Spalte: Player und Skript -->
        <div class="au-main">

            @if (AuVm.SelectedSummary is { } summary && !AuVm.IsFormOpen)
            {
                <div class="au-card au-head">
                    <div style="display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: flex-start;">
                        <div style="min-width: 0;">
                            <div style="font-size: 15px; font-weight: 700; color: #212529;">@summary.Title</div>
                            <div class="au-meta">
                                @AudioScriptFormats.DisplayName(summary.Format) · @summary.Segments.Count Abschnitte · @summary.WordCount Wörter · @AudioScriptFormats.FormatMinutes(summary.EstimatedMinutes)
                                @if (!string.IsNullOrWhiteSpace(summary.Topic))
                                {
                                    <span> · Schwerpunkt: @summary.Topic</span>
                                }
                                @if (summary.SourceDocuments.Count > 0)
                                {
                                    <span> · Quellen: @string.Join(", ", summary.SourceDocuments)</span>
                                }
                            </div>
                        </div>
                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                            <button type="button" class="au-btn" style="background: #495057;" disabled="@(!AuVm.CanExportScript)" title="Skript als Textdatei speichern" @onclick="() => ExportScriptAsync(AudioScriptExportFormat.Text)">📄 Text</button>
                            <button type="button" class="au-btn" style="background: #17a2b8;" disabled="@(!AuVm.CanExportScript)" title="Skript als Markdown speichern" @onclick="() => ExportScriptAsync(AudioScriptExportFormat.Markdown)">📝 Markdown</button>
                        </div>
                    </div>

                    <!-- Player -->
                    <div class="au-player">
                        <button class="au-play-btn" title="Vorheriger Abschnitt" disabled="@(!AuVm.CanPlay || !AuVm.CanGoPrevious)" @onclick="AuVm.PreviousAsync">⏮</button>
                        <button class="au-play-btn main" title="@(AuVm.PlayDisabledReason ?? (AuVm.IsPlaying && !AuVm.IsPaused ? "Pause" : "Abspielen"))"
                                disabled="@(!AuVm.CanPlay)" @onclick="AuVm.TogglePlayPauseAsync">
                            @(AuVm.IsPlaying && !AuVm.IsPaused ? "⏸" : "▶")
                        </button>
                        <button class="au-play-btn" title="Nächster Abschnitt" disabled="@(!AuVm.CanPlay || !AuVm.CanGoNext)" @onclick="AuVm.NextAsync">⏭</button>
                        <button class="au-play-btn" title="Stopp" disabled="@(!AuVm.IsPlaying)" @onclick="AuVm.StopAsync">⏹</button>
                        <div style="flex: 1; min-width: 160px;">
                            <div class="au-bar"><div class="au-bar-fill" style="width: @(Percent(AuVm.Progress))%;"></div></div>
                            <div class="au-meta" style="margin-top: 3px;">@AuVm.ProgressText @(AuVm.IsPaused ? "· pausiert" : "")</div>
                        </div>
                        <label class="au-meta" style="display: inline-flex; align-items: center; gap: 6px;" title="Sprechgeschwindigkeit">
                            Tempo
                            <select class="au-select" value="@AuVm.Rate.ToString("0.##", CultureInfo.InvariantCulture)" @onchange="RateChangedAsync">
                                @foreach (var rate in Rates)
                                {
                                    <option value="@rate.ToString("0.##", CultureInfo.InvariantCulture)">@rate.ToString("0.##", CultureInfo.GetCultureInfo("de-DE"))×</option>
                                }
                            </select>
                        </label>
                    </div>
                    @if (AuVm.PlayDisabledReason is { } playReason)
                    {
                        <div class="au-hint">🔇 @playReason</div>
                    }
                </div>

                <!-- Skript -->
                <div class="au-script">
                    @for (var i = 0; i < summary.Segments.Count; i++)
                    {
                        var index = i;
                        var segment = summary.Segments[index];
                        var speakerIndex = SpeakerIndex(summary, segment.Speaker);
                        var isCurrent = index == AuVm.CurrentSegmentIndex;
                        <div id="au-seg-@index" class="au-seg @(isCurrent ? "current" : "")">
                            <div class="au-seg-head">
                                @if (editSpeakerIndex == index)
                                {
                                    <select class="au-select" value="@segment.Speaker" @onchange="e => SpeakerChangedAsync(index, e)" @onblur="() => editSpeakerIndex = null">
                                        @foreach (var choice in AuVm.SpeakerChoices)
                                        {
                                            <option value="@choice">@choice</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <button class="au-speaker s@(speakerIndex)" title="Sprecher ändern" @onclick="() => editSpeakerIndex = index">@segment.Speaker</button>
                                }
                                @if (isCurrent && AuVm.IsPlaying)
                                {
                                    <span class="au-meta" style="color: #0d6efd; font-weight: 600;">@(AuVm.IsPaused ? "⏸ pausiert" : "🔊 spricht …")</span>
                                }
                                <span style="flex: 1;"></span>
                                <span class="au-seg-tools">
                                    <button class="au-icon small" title="Ab hier vorlesen" disabled="@(!AuVm.CanPlay)" @onclick="() => PlayFromAsync(index)">▶</button>
                                    <button class="au-icon small" title="Text bearbeiten" @onclick="() => StartEdit(index, segment.Text)">✏️</button>
                                    <button class="au-icon small" title="Abschnitt danach einfügen" @onclick="() => AddSegmentAsync(index)">➕</button>
                                    @if (confirmDeleteSegment == index)
                                    {
                                        <button class="au-btn" style="background: #dc3545; padding: 1px 6px; font-size: 11px;" @onclick="() => DeleteSegmentAsync(index)">Löschen?</button>
                                        <button class="au-icon small" title="Nicht löschen" @onclick="() => confirmDeleteSegment = null">✕</button>
                                    }
                                    else
                                    {
                                        <button class="au-icon small" title="Abschnitt löschen" @onclick="() => confirmDeleteSegment = index">🗑️</button>
                                    }
                                </span>
                            </div>
                            @if (editIndex == index)
                            {
                                <textarea id="au-editor" class="au-input" rows="@(Math.Clamp(editText.Length / 90 + 2, 3, 14))" @bind="editText" @bind:event="oninput"
                                          @onkeydown="EditKeyAsync"></textarea>
                                <div style="display: flex; gap: 6px; margin-top: 4px; align-items: center;">
                                    <button class="au-btn" style="background: #28a745; padding: 3px 10px;" @onclick="CommitEditAsync">Übernehmen</button>
                                    <button class="au-link" @onclick="() => editIndex = null">Abbrechen</button>
                                    <span class="au-meta">Strg+Enter übernimmt, Esc bricht ab.</span>
                                </div>
                            }
                            else
                            {
                                <div class="au-seg-text" title="Doppelklick zum Bearbeiten" @ondblclick="() => StartEdit(index, segment.Text)">@segment.Text</div>
                            }
                        </div>
                    }
                    <button class="au-link" style="margin: 6px 0 12px 4px;" @onclick="() => AddSegmentAsync(summary.Segments.Count - 1)">➕ Abschnitt am Ende anfügen</button>
                </div>
            }
            else if (!AuVm.IsFormOpen)
            {
                <div class="au-empty">Wählen Sie links einen Beitrag aus oder erstellen Sie einen neuen.</div>
            }
        </div>
    </div>

    <style>
        .au-root { flex: 1; display: flex; flex-direction: column; background: #f8f9fa; padding: 20px; height: 100%; min-height: 0; box-sizing: border-box; }
        .au-toolbar { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 12px 18px; border-radius: 8px; border: 1px solid #dee2e6; flex-wrap: wrap; gap: 12px; }
        .au-btn { padding: 6px 11px; color: #fff; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 12.5px; display: inline-flex; align-items: center; gap: 5px; }
        .au-btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .au-link { background: none; border: none; color: #007bff; cursor: pointer; font-size: 12px; padding: 0; }
        .au-icon { background: none; border: 1px solid transparent; border-radius: 4px; cursor: pointer; font-size: 13px; padding: 2px 5px; }
        .au-icon.small { font-size: 11px; padding: 1px 3px; }
        .au-icon:hover:not(:disabled) { background: #f1f3f5; border-color: #dee2e6; }
        .au-icon:disabled { opacity: 0.35; cursor: not-allowed; }
        .au-info { margin-top: 14px; padding: 14px 20px; background: #e8f4fd; border: 1px solid #b8daff; border-radius: 8px; text-align: center; color: #004085; }
        .au-progress { width: 100%; max-width: 480px; height: 6px; background: #cce5ff; border-radius: 4px; margin: 10px auto 4px auto; overflow: hidden; position: relative; }
        .au-progress-bar { width: 40%; height: 100%; background: linear-gradient(90deg, #007bff, #0056b3); border-radius: 4px; position: absolute; animation: au-slide 1.4s ease-in-out infinite; }
        @@keyframes au-slide { 0% { left: -40%; } 100% { left: 100%; } }
        .au-status { margin-top: 12px; padding: 10px 14px; border: 1px solid; border-radius: 6px; font-size: 12px; display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
        .au-details-raw { margin-top: 4px; max-height: 160px; overflow: auto; padding: 8px; background: rgba(255,255,255,0.6); border-radius: 4px; font-family: Consolas, "DejaVu Sans Mono", monospace; font-size: 11px; white-space: pre-wrap; word-break: break-word; color: #343a40; }
        .au-body { flex: 1; min-height: 0; display: flex; gap: 14px; margin-top: 16px; }
        .au-side { width: 320px; flex-shrink: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
        .au-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px; min-height: 0; overflow-y: auto; }
        .au-card { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 14px 16px; }
        .au-card h4 { margin: 0 0 8px 0; font-size: 14px; color: #212529; }
        .au-head { padding: 10px 14px; }
        .au-label { font-size: 12px; font-weight: 600; color: #495057; margin: 12px 0 4px 0; display: block; }
        .au-input { width: 100%; box-sizing: border-box; padding: 6px 8px; border: 1px solid #ced4da; border-radius: 4px; font-size: 13px; font-family: inherit; }
        .au-select { padding: 3px 6px; border: 1px solid #ced4da; border-radius: 4px; font-size: 12px; font-family: inherit; background: #fff; max-width: 100%; }
        .au-choices { display: flex; flex-direction: column; gap: 6px; }
        .au-choice { display: flex; gap: 10px; align-items: flex-start; text-align: left; padding: 7px 10px; border: 2px solid #dee2e6; border-radius: 6px; background: #fff; cursor: pointer; font-size: 13px; color: #212529; font-family: inherit; }
        .au-choice.active { border-color: #007bff; background: #f0f7ff; }
        .au-choice b { display: block; }
        .au-lengths { display: flex; gap: 6px; flex-wrap: wrap; }
        .au-length { padding: 5px 9px; border: 2px solid #dee2e6; border-radius: 6px; background: #fff; cursor: pointer; font-size: 12px; font-family: inherit; }
        .au-length.active { border-color: #007bff; background: #f0f7ff; font-weight: 600; }
        .au-desc { display: block; font-size: 11.5px; color: #6c757d; line-height: 1.35; }
        .au-meta { font-size: 11px; color: #6c757d; }
        .au-item { display: flex; gap: 8px; align-items: flex-start; padding: 8px 6px; border-radius: 6px; cursor: pointer; border: 1px solid transparent; }
        .au-item:hover { background: #f8f9fa; }
        .au-item.active { background: #f0f7ff; border-color: #9ec5fe; }
        .au-item-title { font-size: 13px; font-weight: 600; color: #212529; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .au-providers { display: flex; gap: 8px; flex-wrap: wrap; }
        .au-provider { flex: 1 1 240px; display: flex; gap: 8px; align-items: flex-start; text-align: left; padding: 8px 10px; border: 2px solid #dee2e6; border-radius: 6px; background: #fff; cursor: pointer; font-size: 12.5px; font-family: inherit; color: #212529; }
        .au-provider.active { border-color: #007bff; background: #f0f7ff; }
        .au-provider:disabled { cursor: not-allowed; background: #f1f3f5; color: #868e96; }
        .au-provider b { display: block; }
        .au-avail { font-size: 11px; display: block; margin-top: 2px; line-height: 1.35; }
        .au-avail.ok { color: #198754; }
        .au-avail.warn { color: #946200; }
        .au-avail.bad { color: #b02a37; }
        .au-avail.wait { color: #6c757d; }
        .au-note { margin-top: 8px; padding: 6px 10px; border-radius: 4px; font-size: 12px; line-height: 1.45; }
        .au-note.info { background: #e8f4fd; border: 1px solid #b8daff; color: #004085; }
        .au-note.warn { background: #fff3cd; border: 1px solid #ffeeba; color: #856404; }
        .au-note.privacy { background: #f3f0ff; border: 1px solid #d0bfff; color: #4c2a85; }
        .au-voice-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-top: 8px; font-size: 12px; color: #495057; }
        .au-voice-row label { display: flex; flex-direction: column; gap: 3px; width: 100%; }
        .au-voice-row .au-select { width: 100%; }
        .au-player { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-top: 10px; padding-top: 10px; border-top: 1px solid #edf0f2; }
        .au-play-btn { width: 34px; height: 34px; border-radius: 50%; border: 1px solid #ced4da; background: #fff; cursor: pointer; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; }
        .au-play-btn.main { width: 42px; height: 42px; background: #0d6efd; color: #fff; border-color: #0d6efd; font-size: 17px; }
        .au-play-btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .au-bar { height: 6px; background: #e9ecef; border-radius: 3px; overflow: hidden; }
        .au-bar-fill { height: 100%; background: #0d6efd; transition: width 0.3s; }
        .au-hint { margin-top: 8px; font-size: 12px; color: #856404; background: #fff8e1; border: 1px solid #ffe8a1; border-radius: 4px; padding: 5px 9px; }
        .au-script { display: flex; flex-direction: column; gap: 6px; }
        .au-seg { background: #fff; border: 1px solid #dee2e6; border-left: 4px solid #dee2e6; border-radius: 6px; padding: 8px 12px; transition: background 0.2s, border-color 0.2s; }
        .au-seg.current { background: #fff9db; border-color: #fcc419; border-left-color: #f59f00; box-shadow: 0 0 0 2px rgba(252,196,25,0.25); }
        .au-seg-head { display: flex; gap: 8px; align-items: center; margin-bottom: 3px; }
        .au-seg-tools { display: inline-flex; gap: 1px; opacity: 0.35; }
        .au-seg:hover .au-seg-tools { opacity: 1; }
        .au-seg-text { font-size: 13.5px; line-height: 1.55; color: #212529; white-space: pre-wrap; cursor: text; }
        .au-speaker { border: none; border-radius: 10px; padding: 1px 9px; font-size: 11px; font-weight: 700; cursor: pointer; font-family: inherit; }
        .au-speaker.s0 { background: #dbe9ff; color: #0b4fb3; }
        .au-speaker.s1 { background: #ffe3cc; color: #a14800; }
        .au-empty { margin: auto; text-align: center; color: #6c757d; max-width: 480px; background: #fff; padding: 30px; border-radius: 8px; border: 1px dashed #ced4da; }
    </style>
</div>

@code {
    private static readonly double[] Rates = { 0.75, 0.9, 1.0, 1.1, 1.25, 1.5, 1.75, 2.0 };

    private string? renameId;
    private string renameText = string.Empty;
    private string? confirmDeleteId;
    private int? editIndex;
    private string editText = string.Empty;
    private bool focusEditor;
    private int? editSpeakerIndex;
    private int? confirmDeleteSegment;
    private int lastScrolledIndex = -1;

    private int ActiveDocumentCount => DocVm.Documents.Count(d => d.IsSelected && !d.IsMissing);

    private string ActiveDocumentsText => ActiveDocumentCount switch
    {
        0 => "kein Dokument aktiviert",
        1 => "1 aktiviertes Dokument",
        var n => $"{n} aktivierte Dokumente"
    };

    private static string Percent(double value) => (value * 100).ToString("0.#", CultureInfo.InvariantCulture);

    private static int SpeakerIndex(AudioSummary summary, string speaker)
    {
        var index = summary.Speakers.FindIndex(s => string.Equals(s, speaker, StringComparison.OrdinalIgnoreCase));
        return index <= 0 ? 0 : index % 2;
    }

    private static (string Css, string Icon) AvailabilityStyle(SpeechAvailability availability) => availability.Status switch
    {
        SpeechAvailabilityStatus.Ready => ("ok", "✅"),
        SpeechAvailabilityStatus.ReadyWithWarning => ("warn", "⚠️"),
        SpeechAvailabilityStatus.Checking => ("wait", "⏳"),
        _ => ("bad", "⛔")
    };

    /// <summary>Auswahl der Sprachausgabe mit Status je Anbieter, Hinweisen und Stimmen.</summary>
    private RenderFragment SpeechPanel() => __builder =>
    {
        var current = AuVm.CurrentAvailability;
        var (currentCss, currentIcon) = AvailabilityStyle(current);
        var podcast = AuVm.SelectedSummary is { } s && s.Speakers.Count > 1;

        <div class="au-card">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                <h4 style="margin: 0;">🔊 Sprachausgabe</h4>
                <button class="au-link" title="Verfügbarkeit und Stimmen neu prüfen (z. B. nach Installation einer Stimme)" @onclick="RecheckAsync">↻ Neu prüfen</button>
            </div>
            <div class="au-providers" style="margin-top: 8px;">
                @foreach (var service in AuVm.SpeechServices)
                {
                    var provider = service.Provider;
                    var availability = AuVm.AvailabilityOf(provider);
                    var (css, icon) = AvailabilityStyle(availability);
                    var selectable = AuVm.CanSelectProvider(provider);
                    <button type="button" class="au-provider @(AuVm.SelectedProvider == provider ? "active" : "")" disabled="@(!selectable)"
                            title="@(selectable ? service.DisplayName : $"Nicht verfügbar: {availability.Message} {availability.Hint}")"
                            @onclick="() => AuVm.SetProviderAsync(provider)">
                        <span style="font-size: 16px;">@(provider == SpeechProviderType.SystemVoice ? "🖥️" : "☁️")</span>
                        <span>
                            <b>@service.DisplayName</b>
                            <span class="au-avail @css">@icon @availability.Message</span>
                        </span>
                    </button>
                }
            </div>

            <div class="au-meta" style="margin-top: 8px;">
                Aktuell: <b>@(AuVm.CurrentSpeechService?.DisplayName ?? "–")</b> · <span class="au-avail @currentCss" style="display: inline;">@currentIcon @current.Message</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(current.Hint))
            {
                <div class="au-note @(current.Status == SpeechAvailabilityStatus.Unavailable ? "warn" : "info")">💡 @current.Hint</div>
            }

            @if (AuVm.SelectedProvider == SpeechProviderType.SystemVoice)
            {
                @if (AuVm.SystemVoices.Count > 0)
                {
                    <div class="au-voice-row">
                        <label>Stimme @(podcast ? "Sprecher 1" : "")
                            <select class="au-select" value="@AuVm.SpeechSettings.SystemVoicePrimary" @onchange="e => VoiceChangedAsync(0, e)">
                                <option value="">Automatisch (@VoiceName(AuVm.VoiceForSpeakerIndex(0)))</option>
                                @foreach (var voice in AuVm.SystemVoices)
                                {
                                    <option value="@voice.Id">@VoiceLabel(voice)</option>
                                }
                            </select>
                        </label>
                        @if (podcast)
                        {
                            <label>Sprecher 2
                                <select class="au-select" value="@AuVm.SpeechSettings.SystemVoiceSecondary" @onchange="e => VoiceChangedAsync(1, e)">
                                    <option value="">Automatisch (@VoiceName(AuVm.VoiceForSpeakerIndex(1)))</option>
                                    @foreach (var voice in AuVm.SystemVoices)
                                    {
                                        <option value="@voice.Id">@VoiceLabel(voice)</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                }
                <div class="au-meta" style="margin-top: 6px;">💾 Dateiexport: @AudioViewModel.NoFileExportHint</div>
            }
            else if (AuVm.SelectedProvider == SpeechProviderType.GeminiTts)
            {
                <div class="au-note info">☁️ Gemini TTS erzeugt eine Audiodatei (WAV), beim Podcast mit zwei Stimmen. Die Erzeugung der Audiodatei folgt im nächsten Ausbauschritt.</div>
            }

            @if (AuVm.ShowPrivacyHint)
            {
                <div class="au-note privacy">🔒 @AudioViewModel.GeminiPrivacyHint</div>
            }
            @if (AuVm.IsLocalChatAi)
            {
                <div class="au-note info">ℹ️ @AudioViewModel.LocalAiHint Ollama und LM Studio selbst können keine Sprache erzeugen.</div>
            }
        </div>
    };

    private string VoiceName(string id) =>
        AuVm.SystemVoices.FirstOrDefault(v => v.Id == id)?.Name ?? "Standard";

    private static string VoiceLabel(SpeechVoice voice) =>
        $"{voice.Name} ({voice.Language}{(voice.IsLocal ? "" : ", online")})";

    protected override async Task OnInitializedAsync()
    {
        AuVm.PropertyChanged += OnVmChanged;
        DocVm.PropertyChanged += OnDocVmChanged;
        DocVm.Documents.CollectionChanged += OnDocumentsChanged;
        await AuVm.EnsureLoadedForProfileAsync(DocVm.CurrentProfile);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !SystemSpeech.IsAttached)
        {
            SystemSpeech.Attach(JSRuntime);
            await AuVm.RefreshAvailabilityAsync();
        }
        else if (firstRender)
        {
            await AuVm.RefreshAvailabilityAsync();
        }

        if (focusEditor)
        {
            focusEditor = false;
            await EvalAsync("(function(){var e=document.getElementById('au-editor'); if(e){e.focus();}})()");
        }

        // Gerade gesprochenen Abschnitt sichtbar halten
        var index = AuVm.CurrentSegmentIndex;
        if (AuVm.IsPlaying && index >= 0 && index != lastScrolledIndex)
        {
            lastScrolledIndex = index;
            await EvalAsync($"(function(){{var e=document.getElementById('au-seg-{index}'); if(e){{e.scrollIntoView({{block:'nearest', behavior:'smooth'}});}}}})()");
        }
        else if (!AuVm.IsPlaying)
        {
            lastScrolledIndex = -1;
        }
    }

    private async Task EvalAsync(string script)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", script);
        }
        catch
        {
            // Fokus und Scrollen sind nur Bequemlichkeit
        }
    }

    private void OnVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OnDocumentsChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private async void OnDocVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(DocVm.CurrentProfile))
        {
            ResetEditing();
            await AuVm.LoadForProfileAsync(DocVm.CurrentProfile);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ResetEditing()
    {
        renameId = null;
        confirmDeleteId = null;
        editIndex = null;
        editSpeakerIndex = null;
        confirmDeleteSegment = null;
    }

    private void SelectItem(string id)
    {
        ResetEditing();
        AuVm.SelectSummary(id);
    }

    private Task GenerateAsync() => AuVm.GenerateAsync(DocVm.Documents);

    private async Task RecheckAsync()
    {
        SystemSpeech.Refresh();
        await AuVm.RefreshAvailabilityAsync();
    }

    private async Task VoiceChangedAsync(int speakerIndex, ChangeEventArgs e) =>
        await AuVm.SetSystemVoiceAsync(speakerIndex, e.Value?.ToString() ?? string.Empty);

    private async Task RateChangedAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var rate))
            await AuVm.SetRateAsync(rate);
    }

    private async Task PlayFromAsync(int index)
    {
        await AuVm.GoToSegmentAsync(index);
        if (!AuVm.IsPlaying)
            await AuVm.PlayAsync();
    }

    // ---------------- Bearbeiten ----------------

    private void StartEdit(int index, string text)
    {
        editIndex = index;
        editText = text;
        focusEditor = true;
    }

    private async Task CommitEditAsync()
    {
        if (editIndex is not { } index) return;
        editIndex = null;
        await AuVm.SetSegmentTextAsync(index, editText);
    }

    private async Task EditKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey) await CommitEditAsync();
        else if (e.Key == "Escape") editIndex = null;
    }

    private async Task SpeakerChangedAsync(int index, ChangeEventArgs e)
    {
        editSpeakerIndex = null;
        await AuVm.SetSegmentSpeakerAsync(index, e.Value?.ToString() ?? string.Empty);
    }

    private async Task AddSegmentAsync(int afterIndex)
    {
        ResetEditing();
        var index = await AuVm.AddSegmentAfterAsync(afterIndex);
        if (index >= 0 && AuVm.SelectedSummary != null)
            StartEdit(index, AuVm.SelectedSummary.Segments[index].Text);
    }

    private async Task DeleteSegmentAsync(int index)
    {
        confirmDeleteSegment = null;
        editIndex = null;
        await AuVm.DeleteSegmentAsync(index);
    }

    // ---------------- Beiträge ----------------

    private void StartRename(AudioSummary item)
    {
        renameId = item.Id;
        renameText = item.Title;
    }

    private async Task RenameAsync(string id)
    {
        if (await AuVm.RenameAsync(id, renameText))
            renameId = null;
    }

    private async Task RenameKeyAsync(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter") await RenameAsync(id);
        else if (e.Key == "Escape") renameId = null;
    }

    private async Task DeleteAsync(string id)
    {
        confirmDeleteId = null;
        await AuVm.DeleteAsync(id);
    }

    // ---------------- Export ----------------

    private async Task ExportScriptAsync(AudioScriptExportFormat format)
    {
        try
        {
            var extension = AudioViewModel.Extension(format);
            var path = await DesktopDialogs.SaveFileAsync(
                AuVm.SuggestFileName(extension),
                filterExtension: extension,
                filterDescription: AudioViewModel.FormatDescription(format),
                title: "Skript speichern als...");

            if (string.IsNullOrWhiteSpace(path))
                return;

            if (!path.EndsWith("." + extension, StringComparison.OrdinalIgnoreCase))
                path += "." + extension;

            await AuVm.ExportScriptAsync(format, path);
        }
        catch (Exception ex)
        {
            AuVm.ShowStatus($"⚠️ Fehler beim Export: {ex.Message}", isError: true);
        }
    }

    public void Dispose()
    {
        AuVm.PropertyChanged -= OnVmChanged;
        DocVm.PropertyChanged -= OnDocVmChanged;
        DocVm.Documents.CollectionChanged -= OnDocumentsChanged;
    }
}

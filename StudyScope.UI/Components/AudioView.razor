@using System.Globalization
@using Microsoft.JSInterop
@using StudyScope.Core.Interfaces
@using StudyScope.UI.Services
@inject AudioViewModel AuVm
@inject DocumentListViewModel DocVm
@inject BrowserSpeechService SystemSpeech
@inject BrowserAudioPlayer FilePlayer
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="au-root">

    <div class="au-toolbar">
        <div>
            <h3 style="margin: 0; font-size: 16px; color: var(--ss-text);">Audio-Zusammenfassung: @DocVm.CurrentProfile</h3>
            <span style="font-size: 12px; color: var(--ss-text-muted);">
                @(AuVm.Items.Count == 0 ? "Noch keine Beiträge" : AuVm.Items.Count == 1 ? "1 Beitrag" : $"{AuVm.Items.Count} Beiträge")
                · Grundlage: @ActiveDocumentsText
            </span>
        </div>
        @if (!AuVm.IsFormOpen && !AuVm.IsBusy)
        {
            <button type="button" class="au-btn" style="background: var(--ss-primary);" @onclick="AuVm.OpenForm">➕ Neuer Beitrag</button>
        }
    </div>

    @if (AuVm.IsExportingMp3)
    {
        <div class="au-info">
            <div style="font-weight: 600; font-size: 13px;">🎵 MP3 wird gespeichert … @((int)(AuVm.Mp3Progress * 100)) %</div>
            <div class="au-bar" style="margin-top: 8px;"><div class="au-bar-fill" style="width: @(Percent(AuVm.Mp3Progress))%;"></div></div>
            <div style="display: flex; justify-content: center; gap: 10px; align-items: center; margin-top: 6px;">
                <span style="font-size: 11px; color: var(--ss-text-muted);">Beim Abbrechen entsteht keine halbe Datei.</span>
                <button type="button" class="au-btn" style="background: var(--ss-secondary); padding: 4px 10px;" @onclick="AuVm.CancelMp3Export">Abbrechen</button>
            </div>
        </div>
    }
    else if (AuVm.IsGeneratingAudio)
    {
        <div class="au-info">
            <div style="font-weight: 600; font-size: 13px;">🎙️ @(AuVm.CurrentSpeechService?.DisplayName ?? "Sprachausgabe") erzeugt die Audiodatei … @AuVm.AudioProgressText</div>
            <div class="au-bar" style="margin-top: 8px;"><div class="au-bar-fill" style="width: @(Percent(AuVm.AudioProgress))%;"></div></div>
            <div style="display: flex; justify-content: center; gap: 10px; align-items: center; margin-top: 6px;">
                <span style="font-size: 11px; color: var(--ss-text-muted);">Lange Skripte werden in mehreren Teilen erzeugt. Beim Abbrechen wird keine Datei gespeichert.</span>
                <button type="button" class="au-btn" style="background: var(--ss-secondary); padding: 4px 10px;" @onclick="AuVm.CancelAudioGeneration">Abbrechen</button>
            </div>
        </div>
    }
    else if (AuVm.IsBusy)
    {
        <div class="au-info">
            <div style="font-weight: 600; font-size: 13px;">🎧 KI liest die Dokumente und schreibt das Sprechskript (@AudioScriptFormats.DisplayName(AuVm.Format), @AudioScriptFormats.LengthName(AuVm.Length)) ...</div>
            <div class="au-progress"><div class="au-progress-bar"></div></div>
            <div style="display: flex; justify-content: center; gap: 10px; align-items: center; margin-top: 6px;">
                <span style="font-size: 11px; color: var(--ss-text-muted);">Je nach Modell und Länge kann das etwas dauern.</span>
                <button type="button" class="au-btn" style="background: var(--ss-secondary); padding: 4px 10px;" @onclick="AuVm.Cancel">Abbrechen</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(AuVm.StatusMessage))
    {
        var (statusBg, statusBorder, statusText) = AuVm.IsError
            ? ("var(--ss-danger-bg)", "var(--ss-danger-border)", "var(--ss-danger-text)")
            : AuVm.IsWarning ? ("var(--ss-warning-bg)", "var(--ss-warning-border)", "var(--ss-warning-text)") : ("var(--ss-success-bg)", "var(--ss-success-border)", "var(--ss-success-text)");

        <div class="au-status" style="background: @statusBg; border-color: @statusBorder; color: @statusText;">
            <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 600;">@AuVm.StatusMessage</div>
                @if (AuVm.StatusTips.Count > 0)
                {
                    <ul style="margin: 4px 0 0 18px; line-height: 1.5;">
                        @foreach (var tip in AuVm.StatusTips)
                        {
                            <li>@tip</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrEmpty(AuVm.StatusDetails))
                {
                    <details style="margin-top: 6px;">
                        <summary style="cursor: pointer; font-size: 11px; opacity: 0.85;">Technische Details</summary>
                        <pre class="au-details-raw">@AuVm.StatusDetails</pre>
                    </details>
                }
            </div>
            <button style="background: none; border: none; cursor: pointer; color: inherit; font-weight: bold; font-size: 14px; align-self: flex-start;" title="Meldung schließen" @onclick="AuVm.ClearStatus">✕</button>
        </div>
    }

    <div class="au-body">
        <!-- Linke Spalte: neuer Beitrag, Liste und Sprachausgabe -->
        <div class="au-side">
            @if (AuVm.IsFormOpen)
            {
                <div class="au-card" style="border-color: var(--ss-selected-border);">
                    <h4>➕ Neuer Audio-Beitrag</h4>

                    <label class="au-label">Format</label>
                    <div class="au-choices">
                        @foreach (var format in AudioScriptFormats.All)
                        {
                            var current = format;
                            <button type="button" class="au-choice @(AuVm.Format == current ? "active" : "")" disabled="@AuVm.IsBusy" @onclick="() => AuVm.Format = current">
                                <span style="font-size: 18px;">@AudioScriptFormats.Icon(current)</span>
                                <span>
                                    <b>@AudioScriptFormats.DisplayName(current)</b>
                                    <span class="au-desc">@AudioScriptFormats.Description(current)</span>
                                </span>
                            </button>
                        }
                    </div>

                    <label class="au-label">Länge</label>
                    <div class="au-lengths">
                        @foreach (var length in AudioScriptFormats.AllLengths)
                        {
                            var current = length;
                            <button type="button" class="au-length @(AuVm.Length == current ? "active" : "")" disabled="@AuVm.IsBusy" @onclick="() => AuVm.Length = current">@AudioScriptFormats.LengthName(current)</button>
                        }
                    </div>

                    <label class="au-label">Schwerpunkt / Thema <span style="font-weight: normal; color: var(--ss-text-muted);">(optional)</span></label>
                    <input class="au-input" placeholder="z. B. Photosynthese" @bind="AuVm.Topic" @bind:event="oninput" />
                    <div class="au-meta" style="margin-top: 3px;">Grenzt den Beitrag auf passende Textstellen ein; sonst wird das ganze Material berücksichtigt.</div>

                    <label class="au-label">Titel <span style="font-weight: normal; color: var(--ss-text-muted);">(optional – sonst wählt die KI einen)</span></label>
                    <input class="au-input" @bind="AuVm.CustomTitle" @bind:event="oninput" />

                    <button type="button" class="au-btn" style="background: var(--ss-success); width: 100%; justify-content: center; margin-top: 14px; padding: 9px;"
                            disabled="@(AuVm.IsBusy || ActiveDocumentCount == 0)" @onclick="GenerateAsync">
                        ✨ Skript erstellen
                    </button>
                    @if (ActiveDocumentCount == 0)
                    {
                        <div class="au-meta" style="color: var(--ss-danger-fg); margin-top: 6px;">Bitte links mindestens ein Dokument aktivieren.</div>
                    }
                    <div class="au-meta" style="margin-top: 6px;">Das Skript schreibt die KI aus Ihren Einstellungen; vorgelesen wird es mit der gewählten Sprachausgabe.</div>
                    @if (AuVm.Items.Count > 0 && !AuVm.IsBusy)
                    {
                        <button type="button" class="au-link" style="margin-top: 8px;" @onclick="() => AuVm.IsFormOpen = false">Abbrechen</button>
                    }
                </div>
            }

            @if (AuVm.Items.Count > 0)
            {
                <div class="au-card">
                    <h4>🎧 Gespeicherte Beiträge</h4>
                    @foreach (var item in AuVm.Items)
                    {
                        var it = item;
                        var isSelected = AuVm.SelectedSummary?.Id == it.Id && !AuVm.IsFormOpen;
                        <div class="au-item @(isSelected ? "active" : "")" @onclick="() => SelectItem(it.Id)">
                            <span style="font-size: 16px;">@AudioScriptFormats.Icon(it.Format)</span>
                            <div style="flex: 1; min-width: 0;">
                                @if (renameId == it.Id)
                                {
                                    <input class="au-input" style="padding: 3px 6px;" @bind="renameText" @bind:event="oninput" @onclick:stopPropagation="true"
                                           @onkeydown="e => RenameKeyAsync(e, it.Id)" />
                                }
                                else
                                {
                                    <div class="au-item-title" title="@it.Title">@it.Title</div>
                                }
                                <div class="au-meta">@AudioScriptFormats.DisplayName(it.Format) · @AudioScriptFormats.FormatMinutes(it.EstimatedMinutes) · @it.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                            <div style="display: flex; gap: 2px; flex-shrink: 0;" @onclick:stopPropagation="true">
                                @if (renameId == it.Id)
                                {
                                    <button class="au-icon" title="Übernehmen" @onclick="() => RenameAsync(it.Id)">✔</button>
                                    <button class="au-icon" title="Abbrechen" @onclick="() => renameId = null">✕</button>
                                }
                                else if (confirmDeleteId == it.Id)
                                {
                                    <button class="au-btn" style="background: var(--ss-danger); padding: 2px 8px; font-size: 12px;" @onclick="() => DeleteAsync(it.Id)">Löschen?</button>
                                    <button class="au-icon" title="Nicht löschen" @onclick="() => confirmDeleteId = null">✕</button>
                                }
                                else
                                {
                                    <button class="au-icon" title="Umbenennen" @onclick="() => StartRename(it)">✏️</button>
                                    <button class="au-icon" title="Beitrag löschen (samt Audiodatei)" @onclick="() => confirmDeleteId = it.Id">🗑️</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @SpeechPanel()
        </div>

        <!-- Rechte Spalte: Player und Skript -->
        <div class="au-main">

            @if (AuVm.SelectedSummary is { } summary && !AuVm.IsFormOpen)
            {
                <div class="au-card au-head">
                    <div style="display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: flex-start;">
                        <div style="min-width: 0;">
                            <div style="font-size: 15px; font-weight: 700; color: var(--ss-text);">@summary.Title</div>
                            <div class="au-meta">
                                @AudioScriptFormats.DisplayName(summary.Format) · @summary.Segments.Count Abschnitte · @summary.WordCount Wörter · @AudioScriptFormats.FormatMinutes(summary.EstimatedMinutes)
                                @if (!string.IsNullOrWhiteSpace(summary.Topic))
                                {
                                    <span> · Schwerpunkt: @summary.Topic</span>
                                }
                                @if (summary.SourceDocuments.Count > 0)
                                {
                                    <span> · Quellen: @string.Join(", ", summary.SourceDocuments)</span>
                                }
                            </div>
                        </div>
                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                            <button type="button" class="au-btn" style="background: var(--ss-strong);" disabled="@(!AuVm.CanExportScript)" title="Skript als Textdatei speichern" @onclick="() => ExportScriptAsync(AudioScriptExportFormat.Text)">📄 Text</button>
                            <button type="button" class="au-btn" style="background: var(--ss-info);" disabled="@(!AuVm.CanExportScript)" title="Skript als Markdown speichern" @onclick="() => ExportScriptAsync(AudioScriptExportFormat.Markdown)">📝 Markdown</button>
                        </div>
                    </div>

                    <!-- Player -->
                    <div class="au-player">
                        <button class="au-play-btn" title="Vorheriger Abschnitt" disabled="@(!AuVm.CanPlay || !AuVm.CanGoPrevious)" @onclick="AuVm.PreviousAsync">⏮</button>
                        <button class="au-play-btn main" title="@(AuVm.PlayDisabledReason ?? (AuVm.IsPlaying && !AuVm.IsPaused ? "Pause" : "Abspielen"))"
                                disabled="@(!AuVm.CanPlay)" @onclick="AuVm.TogglePlayPauseAsync">
                            @(AuVm.IsPlaying && !AuVm.IsPaused ? "⏸" : "▶")
                        </button>
                        <button class="au-play-btn" title="Nächster Abschnitt" disabled="@(!AuVm.CanPlay || !AuVm.CanGoNext)" @onclick="AuVm.NextAsync">⏭</button>
                        <button class="au-play-btn" title="Stopp" disabled="@(!AuVm.IsPlaying)" @onclick="AuVm.StopAsync">⏹</button>
                        <div style="flex: 1; min-width: 160px;">
                            <div class="au-bar"><div class="au-bar-fill" style="width: @(Percent(AuVm.Progress))%;"></div></div>
                            <div class="au-meta" style="margin-top: 3px;">@AuVm.ProgressText @(AuVm.IsPaused ? "· pausiert" : "")</div>
                        </div>
                        <label class="au-meta" style="display: inline-flex; align-items: center; gap: 6px;" title="Sprechgeschwindigkeit">
                            Tempo
                            <select class="au-select" value="@AuVm.Rate.ToString("0.##", CultureInfo.InvariantCulture)" @onchange="RateChangedAsync">
                                @foreach (var rate in Rates)
                                {
                                    <option value="@rate.ToString("0.##", CultureInfo.InvariantCulture)">@rate.ToString("0.##", CultureInfo.GetCultureInfo("de-DE"))×</option>
                                }
                            </select>
                        </label>
                    </div>
                    @if (AuVm.PlayDisabledReason is { } playReason)
                    {
                        <div class="au-hint">🔇 @playReason</div>
                    }

                    @AudioFilePanel(summary)
                </div>

                <!-- Skript -->
                <div class="au-script">
                    @for (var i = 0; i < summary.Segments.Count; i++)
                    {
                        var index = i;
                        var segment = summary.Segments[index];
                        var speakerIndex = SpeakerIndex(summary, segment.Speaker);
                        var isCurrent = index == AuVm.CurrentSegmentIndex;
                        <div id="au-seg-@index" class="au-seg @(isCurrent ? "current" : "")">
                            <div class="au-seg-head">
                                @if (editSpeakerIndex == index)
                                {
                                    <select class="au-select" value="@segment.Speaker" @onchange="e => SpeakerChangedAsync(index, e)" @onblur="() => editSpeakerIndex = null">
                                        @foreach (var choice in AuVm.SpeakerChoices)
                                        {
                                            <option value="@choice">@choice</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <button class="au-speaker s@(speakerIndex)" title="Sprecher ändern" @onclick="() => editSpeakerIndex = index">@segment.Speaker</button>
                                }
                                @if (isCurrent && AuVm.IsPlaying)
                                {
                                    <span class="au-meta" style="color: var(--ss-link); font-weight: 600;">@(AuVm.IsPaused ? "⏸ pausiert" : "🔊 spricht …")</span>
                                }
                                <span style="flex: 1;"></span>
                                <span class="au-seg-tools">
                                    <button class="au-icon small" title="Ab hier vorlesen" disabled="@(!AuVm.CanPlay)" @onclick="() => PlayFromAsync(index)">▶</button>
                                    <button class="au-icon small" title="Text bearbeiten" @onclick="() => StartEdit(index, segment.Text)">✏️</button>
                                    <button class="au-icon small" title="Abschnitt danach einfügen" @onclick="() => AddSegmentAsync(index)">➕</button>
                                    @if (confirmDeleteSegment == index)
                                    {
                                        <button class="au-btn" style="background: var(--ss-danger); padding: 1px 6px; font-size: 11px;" @onclick="() => DeleteSegmentAsync(index)">Löschen?</button>
                                        <button class="au-icon small" title="Nicht löschen" @onclick="() => confirmDeleteSegment = null">✕</button>
                                    }
                                    else
                                    {
                                        <button class="au-icon small" title="Abschnitt löschen" @onclick="() => confirmDeleteSegment = index">🗑️</button>
                                    }
                                </span>
                            </div>
                            @if (editIndex == index)
                            {
                                <textarea id="au-editor" class="au-input" rows="@(Math.Clamp(editText.Length / 90 + 2, 3, 14))" @bind="editText" @bind:event="oninput"
                                          @onkeydown="EditKeyAsync"></textarea>
                                <div style="display: flex; gap: 6px; margin-top: 4px; align-items: center;">
                                    <button class="au-btn" style="background: var(--ss-success); padding: 3px 10px;" @onclick="CommitEditAsync">Übernehmen</button>
                                    <button class="au-link" @onclick="() => editIndex = null">Abbrechen</button>
                                    <span class="au-meta">Strg+Enter übernimmt, Esc bricht ab.</span>
                                </div>
                            }
                            else
                            {
                                <div class="au-seg-text" title="Doppelklick zum Bearbeiten" @ondblclick="() => StartEdit(index, segment.Text)">@segment.Text</div>
                            }
                        </div>
                    }
                    <button class="au-link" style="margin: 6px 0 12px 4px;" @onclick="() => AddSegmentAsync(summary.Segments.Count - 1)">➕ Abschnitt am Ende anfügen</button>
                </div>
            }
            else if (!AuVm.IsFormOpen)
            {
                <div class="au-empty">Wählen Sie links einen Beitrag aus oder erstellen Sie einen neuen.</div>
            }
        </div>
    </div>

    <style>
        .au-root { flex: 1; display: flex; flex-direction: column; background: var(--ss-panel-light); padding: 20px; height: 100%; min-height: 0; box-sizing: border-box; }
        .au-toolbar { display: flex; justify-content: space-between; align-items: center; background: var(--ss-surface); padding: 12px 18px; border-radius: 8px; border: 1px solid var(--ss-border-light); flex-wrap: wrap; gap: 12px; }
        .au-btn { padding: 6px 11px; color: var(--ss-on-accent); border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 12.5px; display: inline-flex; align-items: center; gap: 5px; }
        .au-btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .au-link { background: none; border: none; color: var(--ss-link); cursor: pointer; font-size: 12px; padding: 0; }
        .au-icon { background: none; border: 1px solid transparent; border-radius: 4px; cursor: pointer; font-size: 13px; padding: 2px 5px; }
        .au-icon.small { font-size: 11px; padding: 1px 3px; }
        .au-icon:hover:not(:disabled) { background: var(--ss-hover); border-color: var(--ss-border-light); }
        .au-icon:disabled { opacity: 0.35; cursor: not-allowed; }
        .au-info { margin-top: 14px; padding: 14px 20px; background: var(--ss-info-bg); border: 1px solid var(--ss-info-border); border-radius: 8px; text-align: center; color: var(--ss-info-text); }
        .au-progress { width: 100%; max-width: 480px; height: 6px; background: var(--ss-info-bg-strong); border-radius: 4px; margin: 10px auto 4px auto; overflow: hidden; position: relative; }
        .au-progress-bar { width: 40%; height: 100%; background: linear-gradient(90deg, var(--ss-primary), var(--ss-primary-hover)); border-radius: 4px; position: absolute; animation: au-slide 1.4s ease-in-out infinite; }
        @@keyframes au-slide { 0% { left: -40%; } 100% { left: 100%; } }
        .au-status { margin-top: 12px; padding: 10px 14px; border: 1px solid; border-radius: 6px; font-size: 12px; display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
        .au-details-raw { margin-top: 4px; max-height: 160px; overflow: auto; padding: 8px; background: var(--ss-raw-bg); border-radius: 4px; font-family: Consolas, "DejaVu Sans Mono", monospace; font-size: 11px; white-space: pre-wrap; word-break: break-word; color: var(--ss-text); }
        .au-body { flex: 1; min-height: 0; display: flex; gap: 14px; margin-top: 16px; }
        .au-side { width: 320px; flex-shrink: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
        .au-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px; min-height: 0; overflow-y: auto; }
        .au-card { background: var(--ss-surface); border: 1px solid var(--ss-border-light); border-radius: 8px; padding: 14px 16px; }
        .au-card h4 { margin: 0 0 8px 0; font-size: 14px; color: var(--ss-text); }
        .au-head { padding: 10px 14px; }
        .au-label { font-size: 12px; font-weight: 600; color: var(--ss-text-2); margin: 12px 0 4px 0; display: block; }
        .au-input { width: 100%; box-sizing: border-box; padding: 6px 8px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 13px; font-family: inherit; }
        .au-select { padding: 3px 6px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 12px; font-family: inherit; background: var(--ss-surface); max-width: 100%; }
        .au-choices { display: flex; flex-direction: column; gap: 6px; }
        .au-choice { display: flex; gap: 10px; align-items: flex-start; text-align: left; padding: 7px 10px; border: 2px solid var(--ss-border-light); border-radius: 6px; background: var(--ss-surface); cursor: pointer; font-size: 13px; color: var(--ss-text); font-family: inherit; }
        .au-choice.active { border-color: var(--ss-primary); background: var(--ss-selected-bg); }
        .au-choice b { display: block; }
        .au-lengths { display: flex; gap: 6px; flex-wrap: wrap; }
        .au-length { padding: 5px 9px; border: 2px solid var(--ss-border-light); border-radius: 6px; background: var(--ss-surface); cursor: pointer; font-size: 12px; font-family: inherit; }
        .au-length.active { border-color: var(--ss-primary); background: var(--ss-selected-bg); font-weight: 600; }
        .au-desc { display: block; font-size: 11.5px; color: var(--ss-text-muted); line-height: 1.35; }
        .au-meta { font-size: 11px; color: var(--ss-text-muted); }
        .au-item { display: flex; gap: 8px; align-items: flex-start; padding: 8px 6px; border-radius: 6px; cursor: pointer; border: 1px solid transparent; }
        .au-item:hover { background: var(--ss-panel-light); }
        .au-item.active { background: var(--ss-selected-bg); border-color: var(--ss-selected-border); }
        .au-item-title { font-size: 13px; font-weight: 600; color: var(--ss-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .au-providers { display: flex; gap: 8px; flex-wrap: wrap; }
        .au-provider { flex: 1 1 240px; display: flex; gap: 8px; align-items: flex-start; text-align: left; padding: 8px 10px; border: 2px solid var(--ss-border-light); border-radius: 6px; background: var(--ss-surface); cursor: pointer; font-size: 12.5px; font-family: inherit; color: var(--ss-text); }
        .au-provider.active { border-color: var(--ss-primary); background: var(--ss-selected-bg); }
        .au-provider:disabled { cursor: not-allowed; background: var(--ss-hover); color: var(--ss-text-muted); }
        .au-provider b { display: block; }
        .au-avail { font-size: 11px; display: block; margin-top: 2px; line-height: 1.35; }
        .au-avail.ok { color: var(--ss-success-text); }
        .au-avail.warn { color: var(--ss-warning-text); }
        .au-avail.bad { color: var(--ss-danger-fg); }
        .au-avail.wait { color: var(--ss-text-muted); }
        .au-note { margin-top: 8px; padding: 6px 10px; border-radius: 4px; font-size: 12px; line-height: 1.45; }
        .au-note.info { background: var(--ss-info-bg); border: 1px solid var(--ss-info-border); color: var(--ss-info-text); }
        .au-note.warn { background: var(--ss-warning-bg); border: 1px solid var(--ss-warning-border); color: var(--ss-warning-text); }
        .au-note.privacy { background: var(--ss-purple-bg); border: 1px solid var(--ss-purple-border); color: var(--ss-purple-text); }
        .au-voice-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-top: 8px; font-size: 12px; color: var(--ss-text-2); }
        .au-voice-row label { display: flex; flex-direction: column; gap: 3px; width: 100%; }
        .au-voice-row .au-select { width: 100%; }
        .au-player { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--ss-border-faint); }
        .au-play-btn { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--ss-border); background: var(--ss-surface); cursor: pointer; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; }
        .au-play-btn.main { width: 42px; height: 42px; background: var(--ss-primary); color: var(--ss-on-accent); border-color: var(--ss-primary); font-size: 17px; }
        .au-play-btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .au-bar { height: 6px; background: var(--ss-panel); border-radius: 3px; overflow: hidden; }
        .au-bar-fill { height: 100%; background: var(--ss-primary); transition: width 0.3s; }
        .au-file { margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--ss-border-light); font-size: 13px; }
        .au-confirm { background: var(--ss-purple-bg); border: 1px solid var(--ss-purple-border); border-radius: 6px; padding: 9px 12px; }
        .au-hint { margin-top: 8px; font-size: 12px; color: var(--ss-warning-text); background: var(--ss-highlight-bg); border: 1px solid var(--ss-warning-border); border-radius: 4px; padding: 5px 9px; }
        .au-script { display: flex; flex-direction: column; gap: 6px; }
        .au-seg { background: var(--ss-surface); border: 1px solid var(--ss-border-light); border-left: 4px solid var(--ss-border-light); border-radius: 6px; padding: 8px 12px; transition: background 0.2s, border-color 0.2s; }
        .au-seg.current { background: var(--ss-highlight-bg); border-color: var(--ss-highlight-border); border-left-color: var(--ss-amber); box-shadow: 0 0 0 2px rgba(252,196,25,0.25); }
        .au-seg-head { display: flex; gap: 8px; align-items: center; margin-bottom: 3px; }
        .au-seg-tools { display: inline-flex; gap: 1px; opacity: 0.35; }
        .au-seg:hover .au-seg-tools { opacity: 1; }
        .au-seg-text { font-size: 13.5px; line-height: 1.55; color: var(--ss-text); white-space: pre-wrap; cursor: text; }
        .au-speaker { border: none; border-radius: 10px; padding: 1px 9px; font-size: 11px; font-weight: 700; cursor: pointer; font-family: inherit; }
        .au-speaker.s0 { background: var(--ss-info-bg-strong); color: var(--ss-info-text); }
        .au-speaker.s1 { background: var(--ss-orange-bg); color: var(--ss-orange-text); }
        .au-empty { margin: auto; text-align: center; color: var(--ss-text-muted); max-width: 480px; background: var(--ss-surface); padding: 30px; border-radius: 8px; border: 1px dashed var(--ss-border); }
    </style>
</div>

@code {
    private static readonly double[] Rates = { 0.75, 0.9, 1.0, 1.1, 1.25, 1.5, 1.75, 2.0 };

    private string? renameId;
    private string renameText = string.Empty;
    private string? confirmDeleteId;
    private int? editIndex;
    private string editText = string.Empty;
    private bool focusEditor;
    private int? editSpeakerIndex;
    private int? confirmDeleteSegment;
    private int lastScrolledIndex = -1;

    private int ActiveDocumentCount => DocVm.Documents.Count(d => d.IsSelected && !d.IsMissing);

    private string ActiveDocumentsText => ActiveDocumentCount switch
    {
        0 => "kein Dokument aktiviert",
        1 => "1 aktiviertes Dokument",
        var n => $"{n} aktivierte Dokumente"
    };

    private static string Percent(double value) => (value * 100).ToString("0.#", CultureInfo.InvariantCulture);

    private static int SpeakerIndex(AudioSummary summary, string speaker) => AudioViewModel.SpeakerSlot(summary, speaker);

    private static (string Css, string Icon) AvailabilityStyle(SpeechAvailability availability) => availability.Status switch
    {
        SpeechAvailabilityStatus.Ready => ("ok", "✅"),
        SpeechAvailabilityStatus.ReadyWithWarning => ("warn", "⚠️"),
        SpeechAvailabilityStatus.Checking => ("wait", "⏳"),
        _ => ("bad", "⛔")
    };

    /// <summary>Auswahl der Sprachausgabe mit Status je Anbieter, Hinweisen und Stimmen.</summary>
    private RenderFragment SpeechPanel() => __builder =>
    {
        var current = AuVm.CurrentAvailability;
        var (currentCss, currentIcon) = AvailabilityStyle(current);
        var podcast = AuVm.SelectedSummary is { } s && s.Speakers.Count > 1;

        <div class="au-card">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                <h4 style="margin: 0;">🔊 Sprachausgabe</h4>
                <button class="au-link" title="Verfügbarkeit und Stimmen neu prüfen (z. B. nach Installation einer Stimme)" @onclick="RecheckAsync">↻ Neu prüfen</button>
            </div>
            <div class="au-providers" style="margin-top: 8px;">
                @foreach (var service in AuVm.SpeechServices)
                {
                    var provider = service.Provider;
                    var availability = AuVm.AvailabilityOf(provider);
                    var (css, icon) = AvailabilityStyle(availability);
                    var selectable = AuVm.CanSelectProvider(provider);
                    <button type="button" class="au-provider @(AuVm.SelectedProvider == provider ? "active" : "")" disabled="@(!selectable)"
                            title="@(selectable ? service.DisplayName : $"Nicht verfügbar: {availability.Message} {availability.Hint}")"
                            @onclick="() => AuVm.SetProviderAsync(provider)">
                        <span style="font-size: 16px;">@(provider == SpeechProviderType.SystemVoice ? "🖥️" : "☁️")</span>
                        <span>
                            <b>@service.DisplayName</b>
                            <span class="au-avail @css">@icon @availability.Message</span>
                        </span>
                    </button>
                }
            </div>

            <div class="au-meta" style="margin-top: 8px;">
                Aktuell: <b>@(AuVm.CurrentSpeechService?.DisplayName ?? "–")</b> · <span class="au-avail @currentCss" style="display: inline;">@currentIcon @current.Message</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(current.Hint))
            {
                <div class="au-note @(current.Status == SpeechAvailabilityStatus.Unavailable ? "warn" : "info")">💡 @current.Hint</div>
            }
            @if (AuVm.AvailabilityOf(SpeechProviderType.GeminiTts).Status == SpeechAvailabilityStatus.Unavailable)
            {
                <button type="button" class="au-link" style="margin-top: 6px;" @onclick="() => OnOpenSpeechSettings.InvokeAsync()">⚙️ Gemini TTS einrichten (Einstellungen › Sprachausgabe)</button>
            }

            @if (AuVm.SelectedProvider == SpeechProviderType.SystemVoice)
            {
                @if (AuVm.SystemVoices.Count > 0)
                {
                    <div class="au-voice-row">
                        <label>Stimme @(podcast ? AuVm.SpeakerRoleName(0) : "")
                            <select class="au-select" value="@AuVm.SpeechSettings.SystemVoicePrimary" @onchange="e => VoiceChangedAsync(0, e)">
                                <option value="">Automatisch (@VoiceName(AuVm.VoiceForSpeakerIndex(0)))</option>
                                @foreach (var voice in AuVm.SystemVoices)
                                {
                                    <option value="@voice.Id">@VoiceLabel(voice)</option>
                                }
                            </select>
                        </label>
                        @if (podcast)
                        {
                            <label>@AuVm.SpeakerRoleName(1)
                                <select class="au-select" value="@AuVm.SpeechSettings.SystemVoiceSecondary" @onchange="e => VoiceChangedAsync(1, e)">
                                    <option value="">Automatisch (@VoiceName(AuVm.VoiceForSpeakerIndex(1)))</option>
                                    @foreach (var voice in AuVm.SystemVoices)
                                    {
                                        <option value="@voice.Id">@VoiceLabel(voice)</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                    @if (podcast && AuVm.VoiceAssignmentHint is { } voiceHint)
                    {
                        <div class="au-note info">💡 @voiceHint</div>
                    }
                }
                <div class="au-meta" style="margin-top: 6px;">💾 Dateiexport: @AudioViewModel.NoFileExportHint</div>
            }
            else if (AuVm.SelectedProvider == SpeechProviderType.GeminiTts)
            {
                <div class="au-note info">☁️ Gemini TTS erzeugt eine Audiodatei (WAV), beim Podcast mit zwei Stimmen (Sprecherin/Moderatorin: <b>@AuVm.SpeechSettings.GeminiVoicePrimary</b>, Experte: <b>@AuVm.SpeechSettings.GeminiVoiceSecondary</b>).</div>
                <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px;">
                    <button type="button" class="au-btn" style="background: var(--ss-info);" disabled="@(!AuVm.CurrentAvailability.IsAvailable || AuVm.IsTestingConnection)"
                            title="Prüft Schlüssel und Modell über die kostenlose Modellabfrage – es wird keine Sprache erzeugt" @onclick="AuVm.TestSpeechConnectionAsync">
                        @(AuVm.IsTestingConnection ? "Prüfe …" : "🔌 Verbindung testen")
                    </button>
                    <button type="button" class="au-btn" style="background: var(--ss-secondary);" title="Schlüssel, Modell und Stimmen ändern" @onclick="() => OnOpenSpeechSettings.InvokeAsync()">⚙️ Schlüssel, Modell, Stimmen</button>
                </div>
            }

            @if (AuVm.ShowPrivacyHint)
            {
                <div class="au-note privacy">🔒 @AudioViewModel.GeminiPrivacyHint</div>
            }
            @if (AuVm.IsLocalChatAi)
            {
                <div class="au-note info">ℹ️ @AudioViewModel.LocalAiHint Ollama und LM Studio selbst können keine Sprache erzeugen.</div>
            }
        </div>
    };

    [Parameter] public EventCallback OnOpenSpeechSettings { get; set; }

    /// <summary>Einstellungen im Abschnitt „Export“ (ffmpeg für MP3) öffnen.</summary>
    [Parameter] public EventCallback OnOpenExportSettings { get; set; }

    private bool confirmGenerateAudio;
    private bool confirmDeleteAudio;

    /// <summary>Audiodatei: vorhandene Datei (Infos, Export, Löschen) und Erzeugen mit Kostenschätzung und Bestätigung.</summary>
    private RenderFragment AudioFilePanel(AudioSummary summary) => __builder =>
    {
        var service = AuVm.CurrentSpeechService;
        var canCreateFiles = service is { SupportsFileExport: true };
        if (!summary.HasAudioFile && !canCreateFiles)
            return;

        <div class="au-file">
            @if (summary.HasAudioFile)
            {
                var exists = AuVm.SelectedAudioFilePath != null;
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <span style="font-weight: 600;">🎵 Audiodatei:</span>
                    <span class="au-meta" style="font-size: 12px;">
                        @summary.AudioFileName
                        @if (summary.AudioDurationSeconds > 0) { <span> · @Clock(summary.AudioDurationSeconds) Min.</span> }
                        @if (summary.AudioCreatedAt is { } created) { <span> · erzeugt am @created.ToString("dd.MM.yyyy HH:mm")</span> }
                        @if (!string.IsNullOrWhiteSpace(summary.AudioCreatedWith)) { <span> · @summary.AudioCreatedWith</span> }
                    </span>
                    <span style="flex: 1;"></span>
                    <button type="button" class="au-btn" style="background: var(--ss-success);" disabled="@(!AuVm.CanExportAudio)" title="Audiodatei (WAV) speichern unter …" @onclick="ExportAudioAsync">💾 WAV exportieren</button>
                    <button type="button" class="au-btn" style="background: var(--ss-primary);" disabled="@(!AuVm.CanExportMp3)"
                            title="@(AuVm.Mp3DisabledReason ?? $"Als MP3 speichern – {AuVm.Mp3EstimateText}")" @onclick="ExportMp3Async">🎵 MP3 exportieren</button>
                    @if (confirmDeleteAudio)
                    {
                        <button type="button" class="au-btn" style="background: var(--ss-danger);" @onclick="DeleteAudioFileAsync">Audiodatei löschen?</button>
                        <button class="au-icon" title="Nicht löschen" @onclick="() => confirmDeleteAudio = false">✕</button>
                    }
                    else
                    {
                        <button class="au-icon" title="Nur die Audiodatei löschen (das Skript bleibt)" disabled="@AuVm.IsBusy" @onclick="() => confirmDeleteAudio = true">🗑️</button>
                    }
                </div>
                @if (exists && AuVm.Mp3DisabledReason is { } mp3Reason && !AuVm.IsBusy)
                {
                    <div class="au-meta" style="font-size: 11.5px; margin-top: 4px;">
                        🎵 MP3: @mp3Reason
                        <button type="button" class="au-link" @onclick="() => OnOpenExportSettings.InvokeAsync()">⚙️ ffmpeg einrichten</button>
                    </div>
                }
                @if (!exists)
                {
                    <div class="au-hint">⚠️ Die Audiodatei wurde nicht gefunden (verschoben oder gelöscht). Erzeugen Sie sie bei Bedarf neu.</div>
                }
                else if (summary.IsAudioOutdated)
                {
                    <div class="au-hint">✏️ Das Skript wurde nach dem Erzeugen geändert – die Audiodatei enthält noch die alte Fassung. Erzeugen Sie sie neu, damit Ton und Text übereinstimmen.</div>
                }
                else if (!AuVm.UsesFilePlayback && service is { SupportsLivePlayback: true })
                {
                    <div class="au-meta" style="margin-top: 4px;">▶ liest mit der Systemstimme vor. Zum Abspielen der Audiodatei oben „Gemini TTS“ wählen.</div>
                }
            }

            @if (canCreateFiles)
            {
                <div style="margin-top: @(summary.HasAudioFile ? "8px" : "0");">
                    @if (confirmGenerateAudio && AuVm.CanGenerateAudio)
                    {
                        <div class="au-confirm">
                            <div style="font-weight: 600;">🎙️ Audiodatei mit @service!.DisplayName erzeugen?</div>
                            @if (AuVm.AudioEstimateText is { } estimate)
                            {
                                <div class="au-meta" style="margin-top: 3px; font-size: 12px;">Geschätzt: @estimate</div>
                            }
                            @if (summary.HasAudioFile)
                            {
                                <div class="au-meta" style="margin-top: 3px;">Die vorhandene Audiodatei wird erst ersetzt, wenn die neue vollständig erzeugt ist.</div>
                            }
                            <div class="au-meta" style="margin-top: 3px;">🔒 Der Skripttext wird dazu an Google gesendet.</div>
                            <div style="display: flex; gap: 6px; margin-top: 8px;">
                                <button type="button" class="au-btn" style="background: var(--ss-success);" @onclick="GenerateAudioAsync">Jetzt erzeugen</button>
                                <button type="button" class="au-link" @onclick="() => confirmGenerateAudio = false">Abbrechen</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            <button type="button" class="au-btn" style="background: var(--ss-purple);" disabled="@(!AuVm.CanGenerateAudio)"
                                    title="@(AuVm.GenerateAudioDisabledReason ?? "Audiodatei erzeugen (vorher werden Kosten und Größe angezeigt)")"
                                    @onclick="() => { confirmGenerateAudio = true; confirmDeleteAudio = false; }">
                                🎙️ @(summary.HasAudioFile ? "Audiodatei neu erzeugen" : "Audiodatei erzeugen")
                            </button>
                            @if (AuVm.AudioEstimateText is { } estimate)
                            {
                                <span class="au-meta">@estimate</span>
                            }
                        </div>
                        @if (AuVm.GenerateAudioDisabledReason is { } reason && !AuVm.IsBusy)
                        {
                            <div class="au-hint">🔇 @reason</div>
                        }
                    }
                </div>
            }
        </div>
    };

    private static string Clock(double seconds)
    {
        var t = TimeSpan.FromSeconds(Math.Round(seconds));
        return t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");
    }

    private async Task GenerateAudioAsync()
    {
        confirmGenerateAudio = false;
        await AuVm.GenerateAudioAsync();
    }

    private async Task DeleteAudioFileAsync()
    {
        confirmDeleteAudio = false;
        await AuVm.DeleteAudioFileAsync();
    }

    private async Task ExportAudioAsync()
    {
        var path = await DesktopDialogs.SaveFileAsync(AuVm.SuggestFileName("wav"), filterExtension: "wav",
            filterDescription: "WAV-Audiodatei (*.wav)", title: "Audiodatei speichern als...");
        if (string.IsNullOrWhiteSpace(path))
            return;
        if (!path.EndsWith(".wav", StringComparison.OrdinalIgnoreCase))
            path += ".wav";
        await AuVm.ExportAudioAsync(path);
    }

    private async Task ExportMp3Async()
    {
        var path = await DesktopDialogs.SaveFileAsync(AuVm.SuggestFileName("mp3"), filterExtension: "mp3",
            filterDescription: "MP3-Audiodatei (*.mp3)", title: "Als MP3 speichern unter...");
        if (string.IsNullOrWhiteSpace(path))
            return;
        if (!path.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase))
            path += ".mp3";
        await AuVm.ExportMp3Async(path);
    }

    private string VoiceName(string id) =>
        AuVm.SystemVoices.FirstOrDefault(v => v.Id == id)?.Name ?? "Standard";

    private static string VoiceLabel(SpeechVoice voice) =>
        $"{voice.Name} ({voice.Language}{(voice.IsLocal ? "" : ", online")})";

    protected override async Task OnInitializedAsync()
    {
        AuVm.PropertyChanged += OnVmChanged;
        DocVm.PropertyChanged += OnDocVmChanged;
        DocVm.Documents.CollectionChanged += OnDocumentsChanged;
        await AuVm.EnsureLoadedForProfileAsync(DocVm.CurrentProfile);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            FilePlayer.Attach(JSRuntime);

        if (firstRender && !SystemSpeech.IsAttached)
        {
            SystemSpeech.Attach(JSRuntime);
            await AuVm.RefreshAvailabilityAsync();
        }
        else if (firstRender)
        {
            await AuVm.RefreshAvailabilityAsync();
        }

        if (focusEditor)
        {
            focusEditor = false;
            await EvalAsync("(function(){var e=document.getElementById('au-editor'); if(e){e.focus();}})()");
        }

        // Gerade gesprochenen Abschnitt sichtbar halten
        var index = AuVm.CurrentSegmentIndex;
        if (AuVm.IsPlaying && index >= 0 && index != lastScrolledIndex)
        {
            lastScrolledIndex = index;
            await EvalAsync($"(function(){{var e=document.getElementById('au-seg-{index}'); if(e){{e.scrollIntoView({{block:'nearest', behavior:'smooth'}});}}}})()");
        }
        else if (!AuVm.IsPlaying)
        {
            lastScrolledIndex = -1;
        }
    }

    private async Task EvalAsync(string script)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", script);
        }
        catch
        {
            // Fokus und Scrollen sind nur Bequemlichkeit
        }
    }

    private void OnVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OnDocumentsChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private async void OnDocVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(DocVm.CurrentProfile))
        {
            ResetEditing();
            await AuVm.LoadForProfileAsync(DocVm.CurrentProfile);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ResetEditing()
    {
        renameId = null;
        confirmDeleteId = null;
        editIndex = null;
        editSpeakerIndex = null;
        confirmDeleteSegment = null;
    }

    private void SelectItem(string id)
    {
        ResetEditing();
        AuVm.SelectSummary(id);
    }

    private Task GenerateAsync() => AuVm.GenerateAsync(DocVm.Documents);

    private async Task RecheckAsync()
    {
        SystemSpeech.Refresh();
        await AuVm.RefreshAvailabilityAsync();
    }

    private async Task VoiceChangedAsync(int speakerIndex, ChangeEventArgs e) =>
        await AuVm.SetSystemVoiceAsync(speakerIndex, e.Value?.ToString() ?? string.Empty);

    private async Task RateChangedAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var rate))
            await AuVm.SetRateAsync(rate);
    }

    private async Task PlayFromAsync(int index)
    {
        await AuVm.GoToSegmentAsync(index);
        if (!AuVm.IsPlaying)
            await AuVm.PlayAsync();
    }

    // ---------------- Bearbeiten ----------------

    private void StartEdit(int index, string text)
    {
        editIndex = index;
        editText = text;
        focusEditor = true;
    }

    private async Task CommitEditAsync()
    {
        if (editIndex is not { } index) return;
        editIndex = null;
        await AuVm.SetSegmentTextAsync(index, editText);
    }

    private async Task EditKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey) await CommitEditAsync();
        else if (e.Key == "Escape") editIndex = null;
    }

    private async Task SpeakerChangedAsync(int index, ChangeEventArgs e)
    {
        editSpeakerIndex = null;
        await AuVm.SetSegmentSpeakerAsync(index, e.Value?.ToString() ?? string.Empty);
    }

    private async Task AddSegmentAsync(int afterIndex)
    {
        ResetEditing();
        var index = await AuVm.AddSegmentAfterAsync(afterIndex);
        if (index >= 0 && AuVm.SelectedSummary != null)
            StartEdit(index, AuVm.SelectedSummary.Segments[index].Text);
    }

    private async Task DeleteSegmentAsync(int index)
    {
        confirmDeleteSegment = null;
        editIndex = null;
        await AuVm.DeleteSegmentAsync(index);
    }

    // ---------------- Beiträge ----------------

    private void StartRename(AudioSummary item)
    {
        renameId = item.Id;
        renameText = item.Title;
    }

    private async Task RenameAsync(string id)
    {
        if (await AuVm.RenameAsync(id, renameText))
            renameId = null;
    }

    private async Task RenameKeyAsync(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter") await RenameAsync(id);
        else if (e.Key == "Escape") renameId = null;
    }

    private async Task DeleteAsync(string id)
    {
        confirmDeleteId = null;
        await AuVm.DeleteAsync(id);
    }

    // ---------------- Export ----------------

    private async Task ExportScriptAsync(AudioScriptExportFormat format)
    {
        try
        {
            var extension = AudioViewModel.Extension(format);
            var path = await DesktopDialogs.SaveFileAsync(
                AuVm.SuggestFileName(extension),
                filterExtension: extension,
                filterDescription: AudioViewModel.FormatDescription(format),
                title: "Skript speichern als...");

            if (string.IsNullOrWhiteSpace(path))
                return;

            if (!path.EndsWith("." + extension, StringComparison.OrdinalIgnoreCase))
                path += "." + extension;

            await AuVm.ExportScriptAsync(format, path);
        }
        catch (Exception ex)
        {
            AuVm.ShowStatus($"⚠️ Fehler beim Export: {ex.Message}", isError: true);
        }
    }

    public void Dispose()
    {
        AuVm.PropertyChanged -= OnVmChanged;
        DocVm.PropertyChanged -= OnDocVmChanged;
        DocVm.Documents.CollectionChanged -= OnDocumentsChanged;
    }
}

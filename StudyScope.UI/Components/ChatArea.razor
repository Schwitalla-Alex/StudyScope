@using Microsoft.JSInterop
@using StudyScope.Core.Models
@using StudyScope.UI.Services
@inject ChatViewModel ChatVm
@inject StudyScope.Core.Interfaces.IExternalLinkOpener LinkOpener
@inject IJSRuntime Js
@implements IDisposable

<div style="flex: 1; display: flex; flex-direction: column; background: var(--ss-surface); height: 100%;">
    <!-- Kopfzeile mit Export-Aktion -->
    <div style="padding: 10px 15px; border-bottom: 1px solid var(--ss-border-light); display: flex; justify-content: space-between; align-items: center;">
        <h4 style="font-size: 14px; margin: 0; color: var(--ss-text-2);">@Loc.Format(UiStrings.Chat_Header, ("count", ChatVm.Messages.Count))</h4>

        <div style="display: flex; gap: 8px;">
            @if (ChatVm.Messages.Any())
            {
                <button type="button"
                        style="padding: 4px 8px; font-size: 11px; background: var(--ss-danger); color: var(--ss-on-accent); border: none; border-radius: 4px; cursor: pointer;"
                        disabled="@ChatVm.IsBusy"
                        @onclick="ChatVm.ClearConversation">
                    @UiStrings.Chat_Clear
                </button>
            }
            <button type="button"
                    style="padding: 4px 12px; font-size: 12px; background: var(--ss-secondary); color: var(--ss-on-accent); border: none; border-radius: 4px; cursor: pointer;"
                    disabled="@ChatVm.IsBusy"
                    @onclick="HandleExportAsync">
                @UiStrings.Chat_Export
            </button>
        </div>
    </div>

    <!-- Statusmeldung bei Export oder Fehlern -->
    @if (!string.IsNullOrEmpty(ChatVm.ExportStatusMessage))
    {
        <div style="margin: 8px 15px; padding: 8px 12px; background-color: var(--ss-neutral-bg); border-inline-start: 4px solid var(--ss-neutral-text); border-radius: 4px; font-size: 12px; display: flex; justify-content: space-between; align-items: center;">
            <span style="white-space: pre-wrap;">@ChatVm.ExportStatusMessage</span>
            <button type="button"
                    style="background: none; border: none; cursor: pointer; font-size: 14px; color: var(--ss-neutral-text);"
                    aria-label="@UiStrings.Common_Dismiss" title="@UiStrings.Common_Dismiss"
                    @onclick="() => ChatVm.ExportStatusMessage = string.Empty">
                ✕
            </button>
        </div>
    }

    <!-- Nachrichtenliste -->
    <div style="flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 12px;">
        @if (!ChatVm.Messages.Any())
        {
            <div style="color: var(--ss-text-faint); font-size: 13px; text-align: center; margin-top: 40px;">
                @UiStrings.Chat_Empty
            </div>
        }
        else
        {
            @foreach (var msg in ChatVm.Messages)
            {
                <div style="max-width: 80%; padding: 10px 14px; border-radius: 8px; font-size: 13px; line-height: 1.4;
                    align-self: @(msg.Role == MessageRole.User ? "flex-end" : "flex-start");
                    background-color: @(msg.Role == MessageRole.User ? "var(--ss-primary)" : (msg.Role == MessageRole.System ? "var(--ss-warning-bg)" : "var(--ss-hover)"));
                    color: @(msg.Role == MessageRole.User ? "var(--ss-on-accent)" : (msg.Role == MessageRole.System ? "var(--ss-warning-text)" : "var(--ss-text)"));">

                    <div style="font-weight: bold; font-size: 11px; margin-bottom: 3px; opacity: 0.8;">@RoleLabel(msg.Role):</div>
                    <div style="white-space: pre-wrap;">@msg.Content</div>

                    <!-- Quellen einer Antwort mit Websuche: Unterlagen und Internet getrennt; Web-Quellen öffnen im System-Browser -->
                    @if (msg.Sources.Count > 0)
                    {
                        var documentSources = msg.Sources.Where(s => s.Kind == ChatSourceKind.Document).ToList();
                        var webSources = msg.Sources.Where(s => s.Kind == ChatSourceKind.Web).ToList();
                        <div class="ss-chat-sources">
                            @if (documentSources.Count > 0)
                            {
                                <div class="ss-chat-sources-group">
                                    <div class="ss-chat-sources-head">@UiStrings.Chat_SourcesDocuments</div>
                                    @foreach (var source in documentSources)
                                    {
                                        <div class="ss-chat-source">[@source.Label] @source.Name</div>
                                    }
                                </div>
                            }
                            @if (webSources.Count > 0)
                            {
                                <div class="ss-chat-sources-group">
                                    <div class="ss-chat-sources-head">@UiStrings.Chat_SourcesWeb</div>
                                    @foreach (var source in webSources)
                                    {
                                        <button type="button" class="ss-link-btn ss-chat-source" title="@Loc.Format(UiStrings.Chat_SourceOpenTitle, ("url", source.Url ?? string.Empty))"
                                                @onclick="() => OpenSource(source)">[@source.Label] @source.Name (@source.Domain)</button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Aktionsleiste bei Assistenten-Nachrichten (Kopieren, Bewerten, Neu generieren) -->
                    @if (msg.Role == MessageRole.Assistant)
                    {
                        <div style="margin-top: 8px; padding-top: 6px; border-top: 1px solid var(--ss-border-faint); display: flex; gap: 12px; align-items: center; font-size: 12px;">
                            <button type="button"
                                    style="border: none; background: transparent; cursor: pointer; padding: 0; color: var(--ss-text-2);"
                                    title="@UiStrings.Chat_CopyTitle"
                                    @onclick="() => CopyToClipboardAsync(msg.Id, msg.Content)">
                                @(_copiedMessageId == msg.Id ? UiStrings.Chat_Copied : UiStrings.Chat_Copy)
                            </button>

                            <button type="button"
                                    style="border: none; background: transparent; cursor: pointer; padding: 0;"
                                    title="@UiStrings.Chat_Helpful"
                                    @onclick="() => ChatVm.RateMessage(msg, true)">
                                @(msg.IsLiked == true ? "👍" : "👍🏻")
                            </button>

                            <button type="button"
                                    style="border: none; background: transparent; cursor: pointer; padding: 0;"
                                    title="@UiStrings.Chat_NotHelpful"
                                    @onclick="() => ChatVm.RateMessage(msg, false)">
                                @(msg.IsLiked == false ? "👎" : "👎🏻")
                            </button>

                            @if (msg == ChatVm.Messages.LastOrDefault(m => m.Role == MessageRole.Assistant) && !ChatVm.IsBusy)
                            {
                                <button type="button"
                                        style="border: none; background: transparent; cursor: pointer; padding: 0; color: var(--ss-link);"
                                        title="@UiStrings.Chat_RegenerateTitle"
                                        @onclick="ChatVm.RegenerateLastResponseAsync">
                                    @UiStrings.Chat_Regenerate
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        }

        <!-- Lade-Indikator mit Abbruch-Schaltfläche -->
        @if (ChatVm.IsBusy)
        {
            <div style="align-self: flex-start; display: flex; flex-direction: column; gap: 8px; padding: 10px 14px; background: var(--ss-panel-light); border: 1px solid var(--ss-border-faint); border-radius: 8px; min-width: 280px; max-width: 360px;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
                    <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--ss-text-2);">
                        <span class="loading-spinner-dark"></span>
                        <span>@UiStrings.Chat_Thinking</span>
                    </div>

                    <!-- Abbruch-Button -->
                    <button type="button"
                            style="padding: 2px 8px; font-size: 11px; background: var(--ss-danger); color: var(--ss-on-accent); border: none; border-radius: 4px; cursor: pointer; font-weight: bold;"
                            title="@UiStrings.Chat_CancelTitle"
                            @onclick="ChatVm.CancelPrompt">
                        @UiStrings.Chat_Cancel
                    </button>
                </div>

                <!-- Animierte Indeterminate-Laufleiste -->
                <div class="progress-bar-indeterminate" style="width: 100%;">
                    <div class="progress-bar-value"></div>
                </div>
            </div>
        }
    </div>

    <!-- Eingabezeile -->
    <div style="padding: 12px; border-top: 1px solid var(--ss-border-light); display: flex; gap: 10px; background: var(--ss-sidebar-bg);">
        <input type="text"
               placeholder="@(ChatVm.IsBusy ? UiStrings.Chat_PlaceholderBusy : UiStrings.Chat_Placeholder)"
               disabled="@ChatVm.IsBusy"
               style="flex: 1; padding: 8px 12px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 13px; outline: none; cursor: @(ChatVm.IsBusy ? "wait" : "text"); background: @(ChatVm.IsBusy ? "var(--ss-hover)" : "var(--ss-surface)");"
               @bind="ChatVm.CurrentInputPrompt"
               @bind:event="oninput"
               @onkeyup="@(async (e) => { if (e.Key == "Enter" && !ChatVm.IsBusy) await ChatVm.SendPromptAsync(); })" />

        <button type="button"
                style="padding: 8px 20px; background: @(ChatVm.IsBusy ? "var(--ss-secondary)" : "var(--ss-primary)"); color: var(--ss-on-accent); border: none; border-radius: 4px; font-weight: bold; cursor: @(ChatVm.IsBusy ? "wait" : "pointer"); display: flex; align-items: center; gap: 6px;"
                disabled="@ChatVm.IsBusy"
                @onclick="ChatVm.SendPromptAsync">
            @if (ChatVm.IsBusy)
            {
                <span class="loading-spinner"></span>
                <span>@UiStrings.Chat_Answering</span>
            }
            else
            {
                <span>@UiStrings.Chat_Send</span>
            }
        </button>
    </div>
</div>

<style>
    .ss-chat-sources { margin-top: 8px; padding-top: 6px; border-top: 1px solid var(--ss-border-faint); display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--ss-text-2); }
    .ss-chat-sources-group { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
    .ss-chat-sources-head { font-weight: 600; }
    /* Eine Quelle je Zeile (Unterlagen und Web), lange Titel brechen um */
    .ss-chat-source { display: block; padding-inline-start: 18px; font-size: 12px; text-align: start; overflow-wrap: anywhere; }
</style>

@code {
    private Guid? _copiedMessageId;

    private static string RoleLabel(MessageRole role) => role switch
    {
        MessageRole.User => UiStrings.Chat_Role_User,
        MessageRole.Assistant => UiStrings.Chat_Role_Assistant,
        MessageRole.System => UiStrings.Chat_Role_System,
        _ => role.ToString()
    };

    protected override void OnInitialized()
    {
        ChatVm.PropertyChanged += OnChatVmPropertyChanged;
    }

    private void OnChatVmPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CopyToClipboardAsync(Guid messageId, string content)
    {
        if (string.IsNullOrEmpty(content))
            return;

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", content);
            _copiedMessageId = messageId;
            StateHasChanged();

            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                _copiedMessageId = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            ChatVm.ExportStatusMessage = Loc.Format(UiStrings.Chat_CopyFailed, ("error", ex.Message));
        }
    }

    /// <summary>Web-Quelle im System-Browser öffnen – nur Adressen aus den Suchtreffern, nie aus dem Antworttext.</summary>
    private void OpenSource(ChatSource source)
    {
        if (string.IsNullOrEmpty(source.Url) || !LinkOpener.OpenUrl(source.Url))
            ChatVm.ExportStatusMessage = Loc.Format(UiStrings.Chat_SourceOpenFailed, ("url", source.Url ?? string.Empty));
    }

    private async Task HandleExportAsync()
    {
        if (!ChatVm.Messages.Any())
        {
            ChatVm.ExportStatusMessage = UiStrings.Chat_NothingToExport;
            StateHasChanged();
            return;
        }

        await ChatVm.ExportConversationToFileAsync();
    }

    public void Dispose()
    {
        ChatVm.PropertyChanged -= OnChatVmPropertyChanged;
    }
}
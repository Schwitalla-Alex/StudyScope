@using Microsoft.JSInterop
@using StudyScope.Core.Models
@using StudyScope.UI.Services
@inject ChatViewModel ChatVm
@inject IJSRuntime Js
@implements IDisposable

<div style="flex: 1; display: flex; flex-direction: column; background: #fff; height: 100%;">
    <!-- Kopfzeile mit Export-Aktion -->
    <div style="padding: 10px 15px; border-bottom: 1px solid #dee2e6; display: flex; justify-content: space-between; align-items: center;">
        <h4 style="font-size: 14px; margin: 0; color: #495057;">Gesprächsverlauf (@ChatVm.Messages.Count Nachrichten)</h4>

        <div style="display: flex; gap: 8px;">
            @if (ChatVm.Messages.Any())
            {
                <button type="button"
                        style="padding: 4px 8px; font-size: 11px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;"
                        disabled="@ChatVm.IsBusy"
                        @onclick="ChatVm.ClearConversation">
                    Verlauf leeren
                </button>
            }
            <button type="button"
                    style="padding: 4px 12px; font-size: 12px; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;"
                    disabled="@ChatVm.IsBusy"
                    @onclick="HandleExportAsync">
                Protokoll exportieren
            </button>
        </div>
    </div>

    <!-- Statusmeldung bei Export oder Fehlern -->
    @if (!string.IsNullOrEmpty(ChatVm.ExportStatusMessage))
    {
        <div style="margin: 8px 15px; padding: 8px 12px; background-color: #e2e3e5; border-left: 4px solid #383d41; border-radius: 4px; font-size: 12px; display: flex; justify-content: space-between; align-items: center;">
            <span style="white-space: pre-wrap;">@ChatVm.ExportStatusMessage</span>
            <button type="button"
                    style="background: none; border: none; cursor: pointer; font-size: 14px; color: #383d41;"
                    @onclick="() => ChatVm.ExportStatusMessage = string.Empty">
                ✕
            </button>
        </div>
    }

    <!-- Nachrichtenliste -->
    <div style="flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 12px;">
        @if (!ChatVm.Messages.Any())
        {
            <div style="color: #adb5bd; font-size: 13px; text-align: center; margin-top: 40px;">
                Stelle eine Frage zu den aktivierten PDF-Dokumenten...
            </div>
        }
        else
        {
            @foreach (var msg in ChatVm.Messages)
            {
                <div style="max-width: 80%; padding: 10px 14px; border-radius: 8px; font-size: 13px; line-height: 1.4;
                    align-self: @(msg.Role == MessageRole.User ? "flex-end" : "flex-start");
                    background-color: @(msg.Role == MessageRole.User ? "#007bff" : (msg.Role == MessageRole.System ? "#fff3cd" : "#f1f3f5"));
                    color: @(msg.Role == MessageRole.User ? "#ffffff" : (msg.Role == MessageRole.System ? "#856404" : "#212529"));">

                    <div style="font-weight: bold; font-size: 11px; margin-bottom: 3px; opacity: 0.8;">@msg.Role:</div>
                    <div style="white-space: pre-wrap;">@msg.Content</div>

                    <!-- Aktionsleiste bei Assistenten-Nachrichten (Kopieren, Bewerten, Neu generieren) -->
                    @if (msg.Role == MessageRole.Assistant)
                    {
                        <div style="margin-top: 8px; padding-top: 6px; border-top: 1px solid rgba(0,0,0,0.06); display: flex; gap: 12px; align-items: center; font-size: 12px;">
                            <button type="button"
                                    style="border: none; background: transparent; cursor: pointer; padding: 0; color: #495057;"
                                    title="In Zwischenablage kopieren"
                                    @onclick="() => CopyToClipboardAsync(msg.Id, msg.Content)">
                                @(_copiedMessageId == msg.Id ? "✓ Kopiert!" : "📋 Kopieren")
                            </button>

                            <button type="button"
                                    style="border: none; background: transparent; cursor: pointer; padding: 0;"
                                    title="Hilfreich"
                                    @onclick="() => ChatVm.RateMessage(msg, true)">
                                @(msg.IsLiked == true ? "👍" : "👍🏻")
                            </button>

                            <button type="button"
                                    style="border: none; background: transparent; cursor: pointer; padding: 0;"
                                    title="Nicht hilfreich"
                                    @onclick="() => ChatVm.RateMessage(msg, false)">
                                @(msg.IsLiked == false ? "👎" : "👎🏻")
                            </button>

                            @if (msg == ChatVm.Messages.LastOrDefault(m => m.Role == MessageRole.Assistant) && !ChatVm.IsBusy)
                            {
                                <button type="button"
                                        style="border: none; background: transparent; cursor: pointer; padding: 0; color: #007bff;"
                                        title="Neu generieren"
                                        @onclick="ChatVm.RegenerateLastResponseAsync">
                                    ↻ Neu generieren
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        }

        <!-- Lade-Indikator mit Abbruch-Schaltfläche -->
        @if (ChatVm.IsBusy)
        {
            <div style="align-self: flex-start; display: flex; flex-direction: column; gap: 8px; padding: 10px 14px; background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; min-width: 280px; max-width: 360px;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
                    <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #495057;">
                        <span class="loading-spinner-dark"></span>
                        <span>StudyScope denkt nach...</span>
                    </div>

                    <!-- Abbruch-Button -->
                    <button type="button"
                            style="padding: 2px 8px; font-size: 11px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;"
                            title="Aktuelle Anfrage abbrechen"
                            @onclick="ChatVm.CancelPrompt">
                        ✕ Abbrechen
                    </button>
                </div>

                <!-- Animierte Indeterminate-Laufleiste -->
                <div class="progress-bar-indeterminate" style="width: 100%;">
                    <div class="progress-bar-value"></div>
                </div>
            </div>
        }
    </div>

    <!-- Eingabezeile -->
    <div style="padding: 12px; border-top: 1px solid #dee2e6; display: flex; gap: 10px; background: #fafafa;">
        <input type="text"
               placeholder="@(ChatVm.IsBusy ? "Bitte warten, Antwort wird generiert..." : "Geben Sie hier Ihre Frage an den KI-Chatbot ein...")"
               disabled="@ChatVm.IsBusy"
               style="flex: 1; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; font-size: 13px; outline: none; cursor: @(ChatVm.IsBusy ? "wait" : "text"); background: @(ChatVm.IsBusy ? "#f1f3f5" : "#fff");"
               @bind="ChatVm.CurrentInputPrompt"
               @bind:event="oninput"
               @onkeyup="@(async (e) => { if (e.Key == "Enter" && !ChatVm.IsBusy) await ChatVm.SendPromptAsync(); })" />

        <button type="button"
                style="padding: 8px 20px; background: @(ChatVm.IsBusy ? "#6c757d" : "#007bff"); color: white; border: none; border-radius: 4px; font-weight: bold; cursor: @(ChatVm.IsBusy ? "wait" : "pointer"); display: flex; align-items: center; gap: 6px;"
                disabled="@ChatVm.IsBusy"
                @onclick="ChatVm.SendPromptAsync">
            @if (ChatVm.IsBusy)
            {
                <span class="loading-spinner"></span>
                <span>Antwortet...</span>
            }
            else
            {
                <span>Senden</span>
            }
        </button>
    </div>
</div>

@code {
    private Guid? _copiedMessageId;

    protected override void OnInitialized()
    {
        ChatVm.PropertyChanged += OnChatVmPropertyChanged;
    }

    private void OnChatVmPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CopyToClipboardAsync(Guid messageId, string content)
    {
        if (string.IsNullOrEmpty(content))
            return;

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", content);
            _copiedMessageId = messageId;
            StateHasChanged();

            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                _copiedMessageId = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            ChatVm.ExportStatusMessage = $"Fehler beim Kopieren: {ex.Message}";
        }
    }

    private async Task HandleExportAsync()
    {
        if (!ChatVm.Messages.Any())
        {
            ChatVm.ExportStatusMessage = "Hinweis: Es ist noch kein Gesprächsverlauf vorhanden, der exportiert werden kann.";
            StateHasChanged();
            return;
        }

        await ChatVm.ExportConversationToFileAsync();
    }

    public void Dispose()
    {
        ChatVm.PropertyChanged -= OnChatVmPropertyChanged;
    }
}
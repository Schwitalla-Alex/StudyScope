@using Microsoft.JSInterop
@using StudyScope.Core.Models
@using StudyScope.UI.Services
@inject ChatViewModel ChatVm
@inject IJSRuntime Js
@implements IDisposable

<div style="flex: 1; display: flex; flex-direction: column; background: #fff; height: 100%;">
    <!-- Kopfzeile mit Export-Aktion -->
    <div style="padding: 10px 15px; border-bottom: 1px solid #dee2e6; display: flex; justify-content: space-between; align-items: center;">
        <h4 style="font-size: 14px; margin: 0; color: #495057;">Gesprächsverlauf (@ChatVm.Messages.Count Nachrichten)</h4>

        <div style="display: flex; gap: 8px;">
            @if (ChatVm.Messages.Any())
            {
                <button style="padding: 4px 8px; font-size: 11px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;"
                        disabled="@ChatVm.IsBusy"
                        @onclick="ChatVm.ClearConversation">
                    Verlauf leeren
                </button>
            }
            <button type="button"
                    style="padding: 4px 12px; font-size: 12px; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;"
                    disabled="@ChatVm.IsBusy"
                    @onclick="HandleExportAsync">
                Protokoll exportieren
            </button>
        </div>
    </div>

    <!-- Statusmeldung bei Export oder Fehlern -->
    @if (!string.IsNullOrEmpty(ChatVm.ExportStatusMessage))
    {
        <div style="margin: 8px 15px; padding: 8px 12px; background-color: #e2e3e5; border-left: 4px solid #383d41; border-radius: 4px; font-size: 12px; display: flex; justify-content: space-between; align-items: center;">
            <span style="white-space: pre-wrap;">@ChatVm.ExportStatusMessage</span>
            <button style="background: none; border: none; cursor: pointer; font-size: 14px; color: #383d41;"
                    @onclick="() => ChatVm.ExportStatusMessage = string.Empty">
                ✕
            </button>
        </div>
    }

    <!-- Nachrichtenliste -->
    <div style="flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 12px;">
        @if (!ChatVm.Messages.Any())
        {
            <div style="color: #adb5bd; font-size: 13px; text-align: center; margin-top: 40px;">
                Stelle eine Frage zu den aktivierten Dokumenten...
            </div>
        }
        else
        {
            @foreach (var msg in ChatVm.Messages)
            {
                <div style="max-width: 80%; padding: 10px 14px; border-radius: 8px; font-size: 13px; line-height: 1.4;
                    align-self: @(msg.Role == MessageRole.User ? "flex-end" : "flex-start");
                    background-color: @(msg.Role == MessageRole.User ? "#007bff" : (msg.Role == MessageRole.System ? "#fff3cd" : "#f1f3f5"));
                    color: @(msg.Role == MessageRole.User ? "#ffffff" : (msg.Role == MessageRole.System ? "#856404" : "#212529"));">

                    <div style="font-weight: bold; font-size: 11px; margin-bottom: 3px; opacity: 0.8;">@msg.Role:</div>
                    <div style="white-space: pre-wrap;">@msg.Content</div>

                    <!-- Aktionsleiste für Assistenten-Nachrichten -->
                    @if (msg.Role == MessageRole.Assistant)
                    {
                        <div style="display: flex; gap: 10px; margin-top: 8px; align-items: center; border-top: 1px solid #dee2e6; padding-top: 6px; font-size: 12px;">
                            <!-- In Zwischenablage kopieren -->
                            <button style="background: none; border: none; cursor: pointer; color: #6c757d; padding: 2px 4px; display: flex; align-items: center; gap: 3px;"
                                    title="In Zwischenablage kopieren"
                                    @onclick="() => CopyToClipboardAsync(msg.Id, msg.Content)">
                                <span>📋</span>
                                <span>@(_copiedMessageId == msg.Id ? "Kopiert!" : "Kopieren")</span>
                            </button>

                            <!-- Daumen hoch -->
                            <button style="background: none; border: none; cursor: pointer; padding: 2px 4px; font-size: 13px; opacity: @(msg.IsLiked == true ? "1" : "0.5");"
                                    title="Gute Antwort"
                                    @onclick="() => ChatVm.RateMessage(msg, true)">
                                👍
                            </button>

                            <!-- Daumen runter -->
                            <button style="background: none; border: none; cursor: pointer; padding: 2px 4px; font-size: 13px; opacity: @(msg.IsLiked == false ? "1" : "0.5");"
                                    title="Schlechte Antwort"
                                    @onclick="() => ChatVm.RateMessage(msg, false)">
                                👎
                            </button>

                            <!-- Neu generieren (nur bei der letzten Antwort) -->
                            @if (msg == ChatVm.Messages.LastOrDefault(m => m.Role == MessageRole.Assistant))
                            {
                                <button style="margin-left: auto; background: none; border: none; cursor: pointer; color: #007bff; padding: 2px 4px; display: flex; align-items: center; gap: 4px;"
                                        title="Antwort neu generieren"
                                        disabled="@ChatVm.IsBusy"
                                        @onclick="ChatVm.RegenerateLastResponseAsync">
                                    <span>↻</span>
                                    <span>Neu generieren</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        }

        <!-- Animierter Lade-Indikator, wenn KI rechnet -->
        @if (ChatVm.IsBusy)
        {
            <div style="align-self: flex-start; display: flex; flex-direction: column; gap: 8px; padding: 12px 16px; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 10px; width: 300px; box-shadow: 0 2px 6px rgba(0,0,0,0.04);">
                <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: #495057; font-weight: 500;">
                    <span class="loading-spinner-dark"></span>
                    <span>StudyScope denkt nach</span>
                    <span class="typing-dots">
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                    </span>
                </div>
                <!-- Animierter Indeterminate-Laufbalken -->
                <div class="chat-progress-container">
                    <div class="chat-progress-indeterminate"></div>
                </div>
            </div>
        }
    </div>

    <!-- Eingabezeile -->
    <div style="padding: 12px; border-top: 1px solid #dee2e6; display: flex; gap: 10px; background: #fafafa;">
        <input type="text" placeholder="@(ChatVm.IsBusy ? "Bitte warten, Antwort wird generiert..." : "Geben Sie hier Ihre Frage an den KI-Chatbot ein...")"
               disabled="@ChatVm.IsBusy"
               style="flex: 1; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; font-size: 13px; outline: none; cursor: @(ChatVm.IsBusy ? "wait" : "text"); background: @(ChatVm.IsBusy ? "#f1f3f5" : "#fff");"
               @bind="ChatVm.CurrentInputPrompt"
               @bind:event="oninput"
               @onkeyup="@(async (e) => { if (e.Key == "Enter" && !ChatVm.IsBusy) await ChatVm.SendPromptAsync(); })" />

        <button style="padding: 8px 20px; background: @(ChatVm.IsBusy ? "#6c757d" : "#007bff"); color: white; border: none; border-radius: 4px; font-weight: bold; cursor: @(ChatVm.IsBusy ? "wait" : "pointer"); display: flex; align-items: center; gap: 6px;"
                disabled="@ChatVm.IsBusy"
                @onclick="ChatVm.SendPromptAsync">
            @if (ChatVm.IsBusy)
            {
                <span class="loading-spinner"></span>
                <span>Antwortet...</span>
            }
            else
            {
                <span>Senden</span>
            }
        </button>
    </div>

    <style>
            /* Dunkler Ladekreis für die Denk-Box */
            .loading-spinner-dark {
                display: inline-block;
                width: 13px;
                height: 13px;
                border: 2px solid rgba(0, 123, 255, 0.25);
                border-radius: 50%;
                border-top-color: #007bff;
                animation: spin 0.8s linear infinite;
            }

            /* Weißer Ladekreis für den Senden-Button */
            .loading-spinner {
                display: inline-block;
                width: 13px;
                height: 13px;
                border: 2px solid rgba(255, 255, 255, 0.35);
                border-radius: 50%;
                border-top-color: #ffffff;
                animation: spin 0.8s linear infinite;
            }

            @@keyframes spin {
                0% {
                    transform: rotate(0deg);
                }

                100% {
                    transform: rotate(360deg);
                }
            }

            /* Hüpfende Typing-Dots */
            .typing-dots {
                display: inline-flex;
                align-items: center;
                gap: 3px;
                margin-left: 2px;
            }

            .typing-dot {
                width: 4px;
                height: 4px;
                background-color: #007bff;
                border-radius: 50%;
                display: inline-block;
                animation: typingBounce 1.4s infinite ease-in-out both;
            }

                .typing-dot:nth-child(1) {
                    animation-delay: -0.32s;
                }

                .typing-dot:nth-child(2) {
                    animation-delay: -0.16s;
                }

            @@keyframes typingBounce {
                0%, 80%, 100% {
                    transform: scale(0.6);
                    opacity: 0.3;
                }

                40% {
                    transform: scale(1.15);
                    opacity: 1;
                }
            }

            /* Animierter Fortschrittsbalken im Chat */
            .chat-progress-container {
                width: 100%;
                height: 4px;
                background-color: #e9ecef;
                border-radius: 3px;
                overflow: hidden;
                position: relative;
            }

            .chat-progress-indeterminate {
                width: 35%;
                height: 100%;
                background: linear-gradient(90deg, #007bff, #0056b3);
                border-radius: 3px;
                position: absolute;
                animation: chatSlide 1.3s ease-in-out infinite;
            }

            @@keyframes chatSlide {
                0% {
                    left: -35%;
                }

                50% {
                    left: 45%;
                    width: 45%;
                }

                100% {
                    left: 100%;
                    width: 35%;
                }
            }
    </style>
</div>

@code {
    private Guid? _copiedMessageId;

    protected override void OnInitialized()
    {
        ChatVm.PropertyChanged += OnChatVmPropertyChanged;
    }

    private void OnChatVmPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CopyToClipboardAsync(Guid messageId, string content)
    {
        if (string.IsNullOrEmpty(content))
            return;

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", content);
            _copiedMessageId = messageId;
            StateHasChanged();

            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                _copiedMessageId = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            ChatVm.ExportStatusMessage = $"Fehler beim Kopieren: {ex.Message}";
        }
    }

    private async Task HandleExportAsync()
    {
        if (!ChatVm.Messages.Any())
        {
            ChatVm.ExportStatusMessage = "Hinweis: Es ist noch kein Gesprächsverlauf vorhanden, der exportiert werden kann.";
            StateHasChanged();
            return;
        }

        var defaultName = $"ChatProtokoll_{DateTime.Now:yyyyMMdd_HHmmss}.txt";
        var selectedPath = await DesktopDialogs.SaveFileAsync(defaultName, "txt");

        if (string.IsNullOrWhiteSpace(selectedPath))
        {
            return;
        }

        await ChatVm.ExportConversationToCustomFileAsync(selectedPath);
        StateHasChanged();
    }

    public void Dispose()
    {
        ChatVm.PropertyChanged -= OnChatVmPropertyChanged;
    }
}
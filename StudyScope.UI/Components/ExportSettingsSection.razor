@using StudyScope.Core.Models
@using StudyScope.ViewModels
@inject ExportSettingsViewModel ExportVm
@implements IDisposable

@* Einstellungen › „🎞️ Export“: ffmpeg für MP4- und MP3-Export (optional, wird nicht mitgeliefert) *@

<div style="display: flex; flex-direction: column; gap: 14px;">
    <div style="font-size: 12px; color: #495057; line-height: 1.5;">@ExportVm.Purpose</div>

    @if (ExportVm.Status is { } status)
    {
        <div style="font-size: 12px; padding: 8px 10px; border-radius: 4px; line-height: 1.45; word-break: break-word;
                    background: @(status.IsAvailable ? "#d4edda" : "#fff3cd"); color: @(status.IsAvailable ? "#155724" : "#664d03");
                    border: 1px solid @(status.IsAvailable ? "#c3e6cb" : "#ffe69c");">
            @(status.IsAvailable ? "✅ " : "⚠️ ")@status.Message
            @if (status.Hint is { } hint)
            {
                <div style="margin-top: 4px;">@hint</div>
            }
        </div>
    }
    else
    {
        <div class="ss-hint">ffmpeg wird gesucht …</div>
    }

    <div>
        <label class="ss-label">Pfad zu ffmpeg (optional):</label>
        <input type="text" class="ss-input" placeholder="leer = automatisch suchen (PATH@(ExportVm.IsLinux ? ", /usr/bin" : ", WinGet-Ordner"))"
               @bind="ExportVm.FfmpegPath" @bind:event="oninput" />
        <div class="ss-hint">
            Nur nötig, wenn ffmpeg nicht automatisch gefunden wird – z. B. <code>@(ExportVm.IsLinux ? "/opt/ffmpeg/bin/ffmpeg" : @"C:\ffmpeg\bin\ffmpeg.exe")</code> oder der Ordner, in dem ffmpeg liegt.
        </div>
    </div>

    <div style="font-size: 12px; padding: 8px 10px; border-radius: 4px; background: #f1f3f5; color: #495057; border: 1px solid #dee2e6; line-height: 1.5;">
        <b>ffmpeg installieren</b><br />
        Windows: Eingabeaufforderung öffnen und <code>@FfmpegInfo.WindowsInstall</code> eingeben, danach StudyScope neu starten (oder hier „ffmpeg suchen/testen“).<br />
        Linux (Ubuntu/Debian): <code>@FfmpegInfo.LinuxInstall</code>, Fedora: <code>sudo dnf install ffmpeg</code>.
    </div>

    @if (!string.IsNullOrEmpty(ExportVm.StatusMessage))
    {
        <div style="font-size: 12px; padding: 7px 10px; border-radius: 4px; background: @(ExportVm.IsSuccess ? "#d4edda" : "#f8d7da"); color: @(ExportVm.IsSuccess ? "#155724" : "#721c24"); border: 1px solid @(ExportVm.IsSuccess ? "#c3e6cb" : "#f5c6cb");">
            @ExportVm.StatusMessage
        </div>
    }
</div>

<div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: center; gap: 8px;">
    <button type="button" class="ss-btn" style="background: #17a2b8;" disabled="@ExportVm.IsTesting"
            title="Sucht ffmpeg mit dem eingegebenen Pfad (leer = automatisch) und prüft MP4/MP3 – ohne zu speichern"
            @onclick="ExportVm.TestAsync">
        @(ExportVm.IsTesting ? "Suche …" : "🔎 ffmpeg suchen/testen")
    </button>
    <div style="display: flex; gap: 8px;">
        <button type="button" class="ss-btn" style="background: #6c757d; font-weight: normal;" @onclick="() => OnClose.InvokeAsync()">Schließen</button>
        <button type="button" class="ss-btn" style="background: #007bff;" @onclick="SaveAsync">Speichern</button>
    </div>
</div>

<style>
    .ss-label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: #495057; }
    .ss-input { width: 100%; padding: 7px; border: 1px solid #ced4da; border-radius: 4px; font-size: 13px; box-sizing: border-box; background: #fff; margin-top: 3px; }
    .ss-hint { font-size: 11.5px; color: #6c757d; margin-top: 4px; line-height: 1.4; }
    .ss-btn { padding: 7px 14px; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 13px; font-weight: bold; white-space: nowrap; }
    .ss-btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ExportVm.PropertyChanged += OnChanged;
        await ExportVm.LoadAsync();
    }

    private void OnChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private async Task SaveAsync()
    {
        if (await ExportVm.SaveAsync() && ExportVm.Status is { IsAvailable: true })
            await OnClose.InvokeAsync();
    }

    public void Dispose() => ExportVm.PropertyChanged -= OnChanged;
}

@using StudyScope.Core.Models
@using StudyScope.ViewModels
@inject SettingsViewModel SettingsVm

<div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: white; border-radius: 8px; width: 500px; padding: 22px; box-shadow: 0 4px 20px rgba(0,0,0,0.25); display: flex; flex-direction: column; font-family: Segoe UI, sans-serif;">

        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #dee2e6; padding-bottom: 10px; margin-bottom: 15px;">
            <h3 style="margin: 0; font-size: 17px; color: #212529;">⚙️ KI-Konfiguration</h3>
            <button style="border: none; background: transparent; font-size: 16px; cursor: pointer; color: #6c757d;" @onclick="() => OnClose.InvokeAsync()">✕</button>
        </div>

        <div style="display: flex; flex-direction: column; gap: 14px;">

            <!-- KI-Provider Auswahl -->
            <div>
                <label style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: #495057;">KI-Modell / Provider:</label>
                <select style="width: 100%; padding: 7px; border: 1px solid #ced4da; border-radius: 4px; background: #fff; font-size: 13px;"
                        @bind="SettingsVm.SelectedProvider">
                    <option value="@AiProviderType.FakeAi">Fake-KI (Testmodus)</option>
                    <option value="@AiProviderType.OllamaLocal">Ollama (Lokal)</option>
                    <option value="@AiProviderType.LmStudioLocal">LM Studio (Lokal)</option>
                    <option value="@AiProviderType.GoogleGemini">Google Gemini</option>
                    <option value="@AiProviderType.OpenAiGpt4">OpenAI (GPT-4)</option>
                    <option value="@AiProviderType.CustomOpenAi">Benutzerdefiniert (OpenAI-kompatibel)</option>
                </select>
            </div>

            <!-- Server-URL & Modellwahl (Ollama, LM Studio & Custom) -->
            @if (SettingsVm.IsLocalProvider)
            {
                <div>
                    <label style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: #495057;">
                        @(SettingsVm.IsCustomProvider ? "API-Endpunkt (Base-URL):" : "Server-Endpunkt:")
                    </label>
                    <div style="display: flex; gap: 6px;">
                        <input type="text"
                               placeholder="@(SettingsVm.IsCustomProvider ? "z. B. https://api.groq.com/openai/v1 oder http://localhost:1234/v1" : "http://localhost:...")"
                               style="flex: 1; padding: 7px; border: 1px solid #ced4da; border-radius: 4px; font-size: 13px;"
                               @bind="SettingsVm.LocalEndpointUrl" />
                        <button style="padding: 7px 12px; background: #17a2b8; color: white; border: none; border-radius: 4px; font-size: 12px; font-weight: bold; cursor: pointer; white-space: nowrap;"
                                disabled="@SettingsVm.IsTestingConnection"
                                @onclick="SettingsVm.TestConnectionAndFetchModelsAsync">
                            @(SettingsVm.IsTestingConnection ? "Suche..." : "Modelle suchen")
                        </button>
                    </div>
                </div>

                <!-- Modell-Eingabe / Auswahl -->
                @if (SettingsVm.AvailableModels.Any())
                {
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: #495057;">Installiertes Modell wählen:</label>
                        <select style="width: 100%; padding: 7px; border: 1px solid #ced4da; border-radius: 4px; background: #fff; font-size: 13px;"
                                @bind="SettingsVm.SelectedModelName">
                            @foreach (var model in SettingsVm.AvailableModels)
                            {
                                <option value="@model">@model</option>
                            }
                        </select>
                    </div>
                }
                else if (SettingsVm.IsCustomProvider)
                {
                    <!-- Manuelles Modell-Eingabefeld bei benutzerdefinierten Anbietern (falls API /models nicht unterstützt) -->
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: #495057;">Modellname (ID):</label>
                        <input type="text"
                               placeholder="z. B. llama-3.1-8b-instant, mistral-large-latest, deepseek-chat..."
                               style="width: 100%; padding: 7px; border: 1px solid #ced4da; border-radius: 4px; font-size: 13px; box-sizing: border-box;"
                               @bind="SettingsVm.SelectedModelName" />
                    </div>
                }
            }

            <!-- API-Schlüssel -->
            <div>
                <label style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: @(SettingsVm.IsApiKeyRequired ? "#212529" : "#6c757d");">
                    API-Schlüssel @(SettingsVm.IsCustomProvider ? "(für Cloud-Dienste nötig / bei lokaler KI leer lassen):" : "(OpenAI / Gemini):")
                </label>
                <input type="password"
                       disabled="@(!SettingsVm.IsApiKeyRequired)"
                       placeholder="@(SettingsVm.IsApiKeyRequired ? "sk-... oder Bearer Token" : "Kein API-Schlüssel für lokales Modell erforderlich")"
                       style="width: 100%; padding: 7px; border: 1px solid #ced4da; border-radius: 4px; box-sizing: border-box; background-color: @(SettingsVm.IsApiKeyRequired ? "#fff" : "#e9ecef"); cursor: @(SettingsVm.IsApiKeyRequired ? "text" : "not-allowed"); font-size: 13px;"
                       @bind="SettingsVm.ApiKey" />
            </div>

            <!-- Statusmeldung -->
            @if (!string.IsNullOrEmpty(SettingsVm.ConnectionStatusMessage))
            {
                <div style="font-size: 12px; padding: 7px 10px; border-radius: 4px; background: @(SettingsVm.ConnectionSuccess ? "#d4edda" : "#f8f9fa"); color: @(SettingsVm.ConnectionSuccess ? "#155724" : "#721c24"); border: 1px solid @(SettingsVm.ConnectionSuccess ? "#c3e6cb" : "#f5c6cb");">
                    @SettingsVm.ConnectionStatusMessage
                </div>
            }
        </div>

        <!-- Aktionen -->
        <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
            <button style="padding: 7px 14px; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 13px;"
                    @onclick="() => OnClose.InvokeAsync()">
                Schließen
            </button>
            <button style="padding: 7px 16px; background: #007bff; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 13px;"
                    disabled="@SettingsVm.IsSaving"
                    @onclick="SettingsVm.SaveAndConnectAsync">
                @(SettingsVm.IsSaving ? "Verbinde..." : "Speichern & Verbinden")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
}
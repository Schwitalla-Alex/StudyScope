@using StudyScope.Core.Models
@using StudyScope.ViewModels
@inject SettingsViewModel SettingsVm
@inject DocumentListViewModel DocVm
@implements IDisposable

<div data-ss-dialog style="position: fixed; inset: 0; width: 100vw; height: 100vh; background: var(--ss-overlay); display: flex; align-items: center; justify-content: center; z-index: 1000;">
    <div style="background: var(--ss-surface); border-radius: 8px; width: min(640px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow: hidden; box-sizing: border-box; box-shadow: var(--ss-dialog-shadow); display: flex; flex-direction: column; font-family: Segoe UI, sans-serif;">

        <!-- Kopf (Titel, Reiter) bleibt stehen; nur .st-body scrollt, die Knopfleiste .st-footer klebt unten -->
        <div style="flex: 0 0 auto; padding: 22px 22px 0;">
        <!-- Header mit Anzeige des Zielprofils -->
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--ss-border-light); padding-bottom: 10px; margin-bottom: 15px;">
            <div>
                <h3 style="margin: 0; font-size: 17px; color: var(--ss-text);">@UiStrings.Settings_Title</h3>
                <span style="font-size: 11px; color: var(--ss-text-muted);">@UiStrings.Settings_Profile <strong>@DocVm.CurrentProfileDisplayName</strong></span>
            </div>
            <button type="button" data-ss-dialog-close
                    style="border: none; background: transparent; font-size: 16px; cursor: pointer; color: var(--ss-text-muted);"
                    aria-label="@UiStrings.Common_Close" title="@UiStrings.Common_Close"
                    @onclick="() => OnClose.InvokeAsync()">
                ✕
            </button>
        </div>

        <!-- Abschnitte: KI-Modell (Chat/Skripte) und Sprachausgabe (Audio) -->
        <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 14px; border-bottom: 1px solid var(--ss-border-light);">
            <button type="button" class="st-tab @(section == "ai" ? "active" : "")" @onclick='() => section = "ai"'>@UiStrings.Settings_Tab_Ai</button>
            <button type="button" class="st-tab @(section == "speech" ? "active" : "")" @onclick='() => section = "speech"'>@UiStrings.Settings_Tab_Speech</button>
            <button type="button" class="st-tab @(section == "export" ? "active" : "")" @onclick='() => section = "export"'>@UiStrings.Settings_Tab_Export</button>
            <button type="button" class="st-tab @(section == "websearch" ? "active" : "")" @onclick='() => section = "websearch"'>@UiStrings.Settings_Tab_WebSearch</button>
            <button type="button" class="st-tab @(section == "appearance" ? "active" : "")" @onclick='() => section = "appearance"'>@UiStrings.Settings_Tab_Appearance</button>
        </div>
        </div>

        <div class="st-body">
        @if (section == "appearance")
        {
            <AppearanceSettingsSection OnClose="() => OnClose.InvokeAsync()" />
        }
        else if (section == "speech")
        {
            <SpeechSettingsSection OnClose="() => OnClose.InvokeAsync()" />
        }
        else if (section == "export")
        {
            <ExportSettingsSection OnClose="() => OnClose.InvokeAsync()" />
        }
        else if (section == "websearch")
        {
            <WebSearchSettingsSection OnClose="() => OnClose.InvokeAsync()" />
        }
        else
        {
        <div style="display: flex; flex-direction: column; gap: 14px;">

            <!-- 1. KI-Provider Auswahl -->
            <div>
                <label style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: var(--ss-text-2);">
                    @SettingsVm.NumberedLabel(SettingsField.Provider, UiStrings.Settings_Provider)
                </label>
                <select style="width: 100%; padding: 7px; border: 1px solid var(--ss-border); border-radius: 4px; background: var(--ss-surface); font-size: 13px;"
                        @bind="SettingsVm.SelectedProvider">
                    <option value="@AiProviderType.FakeAi">@UiStrings.Settings_Provider_FakeAi</option>
                    <option value="@AiProviderType.OllamaLocal">@UiStrings.Settings_Provider_Ollama</option>
                    <option value="@AiProviderType.LmStudioLocal">@UiStrings.Settings_Provider_LmStudio</option>
                    <option value="@AiProviderType.GoogleGemini">Google Gemini</option>
                    <option value="@AiProviderType.OpenAiGpt4">OpenAI (GPT-4)</option>
                    <option value="@AiProviderType.MistralAi">@UiStrings.Settings_Provider_Mistral</option>
                    <option value="@AiProviderType.CustomOpenAi">@UiStrings.Settings_Provider_Custom</option>
                </select>
            </div>

            <!-- 2. Server-Endpunkt (nur für lokale Provider und Custom) -->
            @if (SettingsVm.ShowsServer)
            {
                <div>
                    <label style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: var(--ss-text-2);">
                        @SettingsVm.NumberedLabel(SettingsField.Server, SettingsVm.IsCustomProvider ? UiStrings.Settings_ServerCustom : UiStrings.Settings_Server)
                    </label>
                    <div style="display: flex; gap: 6px;">
                        <input type="text"
                               placeholder="@(SettingsVm.IsCustomProvider ? UiStrings.Settings_ServerCustomPlaceholder : "http://localhost:11434")"
                               style="flex: 1; padding: 7px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 13px; box-sizing: border-box;"
                               @bind="SettingsVm.LocalEndpointUrl"
                               @bind:event="oninput" />

                        <button type="button"
                                style="padding: 7px 12px; background: var(--ss-info); color: var(--ss-on-accent); border: none; border-radius: 4px; font-size: 12px; font-weight: bold; cursor: pointer; white-space: nowrap;"
                                disabled="@(string.IsNullOrWhiteSpace(SettingsVm.LocalEndpointUrl) || SettingsVm.IsTestingConnection)"
                                @onclick="SettingsVm.TestConnectionAndFetchModelsAsync">
                            @(SettingsVm.IsTestingConnection ? UiStrings.Settings_Checking : UiStrings.Settings_FindModels)
                        </button>
                    </div>
                </div>
            }

            <!-- 3. API-Schlüssel (für Cloud-Dienste oder optional bei Custom) -->
            @if (SettingsVm.ShowsApiKey)
            {
                <div>
                    <label style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: var(--ss-text);">
                        @SettingsVm.NumberedLabel(SettingsField.ApiKey, SettingsVm.IsCustomProvider ? UiStrings.Settings_ApiKeyOptional : Loc.Format(UiStrings.Settings_ApiKey, ("provider", SettingsVm.SelectedModelDisplayName)))
                    </label>
                    <div style="display: flex; gap: 6px;">
                        <input type="password"
                               placeholder="@UiStrings.Settings_ApiKeyPlaceholder"
                               style="flex: 1; padding: 7px; border: 1px solid var(--ss-border); border-radius: 4px; box-sizing: border-box; background-color: var(--ss-surface); font-size: 13px;"
                               @bind="SettingsVm.ApiKey"
                               @bind:event="oninput" />

                        @if (SettingsVm.SelectedProvider == AiProviderType.GoogleGemini || SettingsVm.SelectedProvider == AiProviderType.OpenAiGpt4 || SettingsVm.SelectedProvider == AiProviderType.MistralAi)
                        {
                            <button type="button"
                                    style="padding: 7px 12px; background: @(string.IsNullOrWhiteSpace(SettingsVm.ApiKey) ? "var(--ss-secondary)" : "var(--ss-info)"); color: var(--ss-on-accent); border: none; border-radius: 4px; font-size: 12px; font-weight: bold; cursor: @(string.IsNullOrWhiteSpace(SettingsVm.ApiKey) ? "not-allowed" : "pointer"); white-space: nowrap;"
                                    disabled="@(string.IsNullOrWhiteSpace(SettingsVm.ApiKey) || SettingsVm.IsTestingConnection)"
                                    @onclick="SettingsVm.TestConnectionAndFetchModelsAsync">
                                @(SettingsVm.IsTestingConnection ? UiStrings.Settings_Checking : UiStrings.Settings_FetchModels)
                            </button>
                        }
                    </div>
                    <KeyProtectionNote NeedsReentry="SettingsVm.ApiKeyNeedsReentry" ProtectionText="@SettingsVm.KeyProtectionText"
                                       IsFallback="SettingsVm.IsKeyProtectionFallback" OnDiscard="SettingsVm.DiscardUnreadableApiKeyAsync" />
                </div>
            }

            <!-- 4. Modell-Auswahl -->
            <div>
                <label style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: var(--ss-text-2);">
                    @SettingsVm.NumberedLabel(SettingsField.Model, UiStrings.Settings_Model)
                </label>

                @if (SettingsVm.AvailableModels.Any())
                {
                    <select style="width: 100%; padding: 7px; border: 1px solid var(--ss-success); border-radius: 4px; background: var(--ss-surface); font-size: 13px; font-weight: bold; color: var(--ss-success-text);"
                            @bind="SettingsVm.SelectedModelName">
                        @foreach (var model in SettingsVm.AvailableModels)
                        {
                            @* Die Fake-KI speichert einen deutschen Modellnamen; angezeigt wird der übersetzte *@
                            <option value="@model">@(model == AiConfig.FakeModelName ? UiStrings.Settings_Provider_FakeAi : model)</option>
                        }
                    </select>
                }
                else if (SettingsVm.SelectedProvider == AiProviderType.FakeAi)
                {
                    <input type="text" disabled value="@UiStrings.Settings_Provider_FakeAi" style="width: 100%; padding: 7px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 13px; background: var(--ss-panel); box-sizing: border-box;" />
                }
                else if (SettingsVm.IsCustomProvider)
                {
                    <input type="text"
                           placeholder="@UiStrings.Settings_ModelCustomPlaceholder"
                           style="width: 100%; padding: 7px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 13px; box-sizing: border-box;"
                           @bind="SettingsVm.SelectedModelName"
                           @bind:event="oninput" />
                }
                else if (SettingsVm.IsLocalProvider)
                {
                    <div style="padding: 8px 12px; background: var(--ss-warning-bg); border: 1px solid var(--ss-warning-border); border-radius: 4px; font-size: 12px; color: var(--ss-warning-text);">
                        @LocHtml.Format(UiStrings.Settings_LocalHint, ("provider", SettingsVm.SelectedModelDisplayName))
                    </div>
                }
                else
                {
                    <div style="padding: 8px 12px; background: var(--ss-warning-bg); border: 1px solid var(--ss-warning-border); border-radius: 4px; font-size: 12px; color: var(--ss-warning-text);">
                        @LocHtml.Format(UiStrings.Settings_CloudHint)
                    </div>
                }
            </div>

            <!-- Sprache der KI-Ergebnisse (je Profil, sofort beim Ändern gespeichert – unabhängig von der Verbindung) -->
            <div>
                <label for="st-output-language" style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: var(--ss-text-2);">
                    @SettingsVm.NumberedLabel(SettingsField.OutputLanguage, UiStrings.Settings_OutputLanguage)
                </label>
                <select id="st-output-language" aria-describedby="st-output-language-hint"
                        style="width: 100%; padding: 7px; border: 1px solid var(--ss-border); border-radius: 4px; background: var(--ss-surface); font-size: 13px;"
                        value="@SettingsVm.OutputLanguage"
                        @onchange="e => SettingsVm.ChangeOutputLanguageAsync(e.Value?.ToString())">
                    @foreach (var (value, label) in SettingsVm.OutputLanguageOptions)
                    {
                        <option value="@value" selected="@(value == SettingsVm.OutputLanguage)">@label</option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(SettingsVm.OutputLanguageStatus))
                {
                    <div role="status" style="font-size: 12px; margin-top: 4px; color: @(SettingsVm.OutputLanguageSaveFailed ? "var(--ss-danger-fg)" : "var(--ss-success-fg)");">@SettingsVm.OutputLanguageStatus</div>
                }
                <div id="st-output-language-hint" style="font-size: 11px; color: var(--ss-text-muted); margin-top: 4px;">
                    @VmStrings.OutputLanguage_Hint
                    @if (!string.IsNullOrEmpty(SettingsVm.OutputLanguageDocumentsHint))
                    {
                        <div style="margin-top: 2px;">@SettingsVm.OutputLanguageDocumentsHint</div>
                    }
                </div>
            </div>

            <!-- Statusmeldung -->
            @if (!string.IsNullOrEmpty(SettingsVm.ConnectionStatusMessage))
            {
                <div style="font-size: 12px; padding: 7px 10px; border-radius: 4px; background: @(SettingsVm.ConnectionSuccess ? "var(--ss-success-bg)" : "var(--ss-danger-bg)"); color: @(SettingsVm.ConnectionSuccess ? "var(--ss-success-text)" : "var(--ss-danger-text)"); border: 1px solid @(SettingsVm.ConnectionSuccess ? "var(--ss-success-border)" : "var(--ss-danger-border)");">
                    @SettingsVm.ConnectionStatusMessage
                </div>
            }
        </div>

        <!-- Aktionen -->
        <div class="st-footer">
            <button type="button"
                    style="padding: 7px 12px; background: var(--ss-surface); color: var(--ss-danger-fg); border: 1px solid var(--ss-danger); border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 500;"
                    title="@UiStrings.Settings_ResetTitle"
                    @onclick="SettingsVm.ResetForm">
                @UiStrings.Settings_Reset
            </button>

            <div style="display: flex; gap: 8px;">
                <button type="button"
                        style="padding: 7px 14px; background: var(--ss-secondary); color: var(--ss-on-accent); border: none; border-radius: 4px; cursor: pointer; font-size: 13px;"
                        @onclick="() => OnClose.InvokeAsync()">
                    @UiStrings.Common_Close
                </button>
                <button type="button"
                        style="padding: 7px 16px; background: @(SettingsVm.CanSaveAndConnect ? "var(--ss-primary)" : "var(--ss-secondary)"); color: var(--ss-on-accent); border: none; border-radius: 4px; font-weight: bold; cursor: @(SettingsVm.CanSaveAndConnect ? "pointer" : "not-allowed"); font-size: 13px;"
                        disabled="@(!SettingsVm.CanSaveAndConnect)"
                        @onclick="HandleSaveAndCloseAsync">
                    @(SettingsVm.IsSaving ? UiStrings.Settings_Connecting : UiStrings.Settings_SaveConnect)
                </button>
            </div>
        </div>
        }
        </div>
    </div>
</div>

<style>
    /* Inhalt scrollt, Kopf und Knopfleiste bleiben sichtbar (gilt für alle Abschnitte) */
    .st-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 0 22px; }
    .st-footer { position: sticky; inset-block-end: 0; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-block-start: 16px; padding-block: 12px 18px; background: var(--ss-surface); border-block-start: 1px solid var(--ss-border-light); }
    .st-footer-end { justify-content: flex-end; }
    .st-tab { border: 1px solid transparent; border-bottom: none; background: transparent; padding: 6px 10px; white-space: nowrap; font-size: 13px; cursor: pointer; border-start-start-radius: 4px; border-start-end-radius: 4px; color: var(--ss-text-2); margin-bottom: -1px; }
    .st-tab.active { background: var(--ss-surface); border-color: var(--ss-border-light); font-weight: bold; color: var(--ss-text); }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Abschnitt beim Öffnen: „ai“ (KI-Modell), „speech“ (Sprachausgabe), „export“ (ffmpeg), „websearch“ (Websuche) oder „appearance“ (Darstellung).</summary>
    [Parameter] public string InitialSection { get; set; } = "ai";

    private string section = "ai";

    protected override void OnInitialized() => section = InitialSection is "speech" or "export" or "websearch" or "appearance" ? InitialSection : "ai";

    protected override Task OnInitializedAsync()
    {
        SettingsVm.PropertyChanged += OnSettingsPropertyChanged;
        return Task.CompletedTask;
    }

    // WICHTIG: Feuert zuverlässig jedes Mal, wenn das Fenster sichtbar geschaltet wird
    protected override async Task OnParametersSetAsync()
    {
        await SettingsVm.InitializeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnSettingsPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleSaveAndCloseAsync()
    {
        var success = await SettingsVm.SaveAndConnectAsync();
        if (success)
        {
            // Statusleiste sofort live mit dem neuen Modellnamen des aktiven Profils aktualisieren
            await DocVm.RefreshCurrentAiModelAsync();
            await OnClose.InvokeAsync();
        }
    }

    public void Dispose()
    {
        SettingsVm.PropertyChanged -= OnSettingsPropertyChanged;
    }
}
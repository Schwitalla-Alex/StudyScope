@using Microsoft.JSInterop
@using StudyScope.Core.Common
@using StudyScope.Core.Interfaces
@inject IExternalLinkOpener LinkOpener
@inject IJSRuntime JS

@* Hilfe › „StudyScope unterstützen ❤“: kurzer Spendenaufruf; die Spendenseite öffnet sich im System-Browser. *@
<div class="ss-dialog-overlay" @onclick="CloseAsync">
    <div class="ss-dialog" style="width: 460px; padding: 0; overflow: hidden;" role="dialog" aria-modal="true" aria-labelledby="ss-support-title"
         @onclick:stopPropagation="true" @onkeydown="KeyAsync">
        <div style="padding: 14px 18px; border-bottom: 1px solid #dee2e6; display: flex; justify-content: space-between; align-items: center; background: #f8f9fa;">
            <h4 id="ss-support-title" style="margin: 0; font-size: 15px; color: #212529;">❤ StudyScope unterstützen</h4>
            <button type="button" aria-label="Schließen" style="background: none; border: none; font-size: 16px; cursor: pointer; color: #6c757d; font-weight: bold;"
                    @onclick="CloseAsync">✕</button>
        </div>

        <div style="padding: 18px 20px; font-size: 13px; color: #495057; line-height: 1.55; display: flex; flex-direction: column; gap: 10px;">
            <p style="margin: 0;">
                StudyScope ist ein freies Open-Source-Projekt unter der Apache License 2.0. Die Software bleibt kostenlos –
                ohne Werbung, ohne Abo und ohne Funktionen, die erst nach einer Spende freigeschaltet werden.
            </p>
            <p style="margin: 0;">
                Wenn Ihnen StudyScope beim Lernen hilft, freue ich mich über eine freiwillige Unterstützung. Sie hilft,
                das Programm weiterzuentwickeln und für Windows und Linux zu pflegen.
            </p>
            <p style="margin: 0; font-size: 12px; color: #6c757d;">
                Die Spende läuft über PayPal. Der Knopf öffnet die Spendenseite in Ihrem Browser; StudyScope selbst
                überträgt dabei keine Daten.
            </p>
            @if (openFailed)
            {
                <div role="alert" style="background: #fff3cd; color: #856404; border: 1px solid #ffe69c; border-radius: 4px; padding: 8px 10px; font-size: 12px;">
                    Der Browser konnte nicht geöffnet werden. Sie können die Adresse kopieren:
                    <div style="user-select: all; word-break: break-all; margin-top: 4px; font-family: Consolas, monospace;">@AppInfo.DonationUrl</div>
                </div>
            }
        </div>

        <div style="padding: 10px 18px; border-top: 1px solid #dee2e6; display: flex; justify-content: flex-end; gap: 8px; background: #f8f9fa;">
            <button type="button" style="padding: 6px 14px; background: #6c757d; color: white; border: none; border-radius: 4px; font-size: 13px; cursor: pointer;"
                    @onclick="CloseAsync">Schließen</button>
            <button id="ss-support-open" type="button" disabled="@(!canDonate)"
                    style="padding: 6px 16px; background: #d63384; color: white; border: none; border-radius: 4px; font-size: 13px; font-weight: 600; cursor: pointer;"
                    @onclick="OpenDonation">❤ Im Browser öffnen</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly bool canDonate = AppInfo.IsValidDonationUrl(AppInfo.DonationUrl);
    private bool openFailed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("studyScopeLayout.focusElementLater", "ss-support-open"); }
        catch (JSException) { }
    }

    private void OpenDonation()
    {
        // Der Spendenknopf nimmt nur https (strenger als IExternalLinkOpener, der auch http erlaubt)
        openFailed = !canDonate || !LinkOpener.OpenUrl(AppInfo.DonationUrl);
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}

@using Microsoft.JSInterop
@using StudyScope.Core.Common
@using StudyScope.Core.Interfaces
@inject IExternalLinkOpener LinkOpener
@inject IJSRuntime JS

@* Hilfe › „StudyScope unterstützen ❤“: kurzer Spendenaufruf; die Spendenseite öffnet sich im System-Browser. *@
<div class="ss-dialog-overlay" data-ss-dialog @onclick="CloseAsync">
    <div class="ss-dialog" style="width: 460px; padding: 0; overflow: hidden;" role="dialog" aria-modal="true" aria-labelledby="ss-support-title"
         @onclick:stopPropagation="true">
        <div style="padding: 14px 18px; border-bottom: 1px solid var(--ss-border-light); display: flex; justify-content: space-between; align-items: center; background: var(--ss-panel-light);">
            <h4 id="ss-support-title" style="margin: 0; font-size: 15px; color: var(--ss-text);">@UiStrings.Support_Title</h4>
            <button type="button" data-ss-dialog-close aria-label="@UiStrings.Common_Close" style="background: none; border: none; font-size: 16px; cursor: pointer; color: var(--ss-text-muted); font-weight: bold;"
                    @onclick="CloseAsync">✕</button>
        </div>

        <div style="padding: 18px 20px; font-size: 13px; color: var(--ss-text-2); line-height: 1.55; display: flex; flex-direction: column; gap: 10px;">
            <p style="margin: 0;">@UiStrings.Support_Text1</p>
            <p style="margin: 0;">@UiStrings.Support_Text2</p>
            <p style="margin: 0; font-size: 12px; color: var(--ss-text-muted);">@UiStrings.Support_Text3</p>
            @if (openFailed)
            {
                <div role="alert" style="background: var(--ss-warning-bg); color: var(--ss-warning-text); border: 1px solid var(--ss-warning-border); border-radius: 4px; padding: 8px 10px; font-size: 12px;">
                    @UiStrings.Support_OpenFailed
                    <div style="user-select: all; word-break: break-all; margin-top: 4px; font-family: Consolas, monospace;">@AppInfo.DonationUrl</div>
                </div>
            }
        </div>

        <div style="padding: 10px 18px; border-top: 1px solid var(--ss-border-light); display: flex; justify-content: flex-end; gap: 8px; background: var(--ss-panel-light);">
            <button type="button" style="padding: 6px 14px; background: var(--ss-secondary); color: var(--ss-on-accent); border: none; border-radius: 4px; font-size: 13px; cursor: pointer;"
                    @onclick="CloseAsync">@UiStrings.Common_Close</button>
            <button id="ss-support-open" type="button" disabled="@(!canDonate)"
                    style="padding: 6px 16px; background: var(--ss-donate); color: var(--ss-on-accent); border: none; border-radius: 4px; font-size: 13px; font-weight: 600; cursor: pointer;"
                    @onclick="OpenDonation">@UiStrings.Support_Open</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly bool canDonate = AppInfo.IsValidDonationUrl(AppInfo.DonationUrl);
    private bool openFailed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("studyScopeLayout.focusElementLater", "ss-support-open"); }
        catch (JSException) { }
    }

    private void OpenDonation()
    {
        // Der Spendenknopf nimmt nur https (strenger als IExternalLinkOpener, der auch http erlaubt)
        openFailed = !canDonate || !LinkOpener.OpenUrl(AppInfo.DonationUrl);
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}

@using Microsoft.JSInterop
@using StudyScope.UI.Services
@using StudyScope.ViewModels.DataTable
@inject DataTableViewModel DtVm
@inject DocumentListViewModel DocVm
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="dt-root">

    <div class="dt-toolbar">
        <div>
            <h3 style="margin: 0; font-size: 16px; color: var(--ss-text);">@Loc.Format(UiStrings.DataTable_Title, ("profile", DocVm.CurrentProfileDisplayName))</h3>
            <span style="font-size: 12px; color: var(--ss-text-muted);">
                @Loc.Format(UiStrings.Common_BasedOn,
                    ("items", DtVm.Tables.Count == 0 ? UiStrings.DataTable_NoTables : Loc.Format(UiStrings.DataTable_TableCount, ("count", DtVm.Tables.Count))),
                    ("documents", ActiveDocumentsText))
            </span>
        </div>
        @if (!DtVm.IsFormOpen && !DtVm.IsBusy)
        {
            <button type="button" class="dt-btn" style="background: var(--ss-primary);" @onclick="DtVm.OpenForm">@UiStrings.DataTable_New</button>
        }
    </div>

    @if (DtVm.IsBusy)
    {
        <div class="dt-info">
            <div style="font-weight: 600; font-size: 13px;">
                @(DtVm.IsAppending
                    ? UiStrings.DataTable_BusyAppending
                    : Loc.Format(UiStrings.DataTable_BusyGenerating, ("template", TemplateTexts.Name(DtVm.Template))))
            </div>
            <div class="dt-progress"><div class="dt-progress-bar"></div></div>
            <div style="display: flex; justify-content: center; gap: 10px; align-items: center; margin-top: 6px;">
                <span style="font-size: 11px; color: var(--ss-text-muted);">@UiStrings.Common_GenerationWait</span>
                <button type="button" class="dt-btn" style="background: var(--ss-secondary); padding: 4px 10px;" @onclick="DtVm.Cancel">@UiStrings.Common_Cancel</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(DtVm.StatusMessage))
    {
        var (statusBg, statusBorder, statusText) = DtVm.IsError
            ? ("var(--ss-danger-bg)", "var(--ss-danger-border)", "var(--ss-danger-text)")
            : DtVm.IsWarning ? ("var(--ss-warning-bg)", "var(--ss-warning-border)", "var(--ss-warning-text)") : ("var(--ss-success-bg)", "var(--ss-success-border)", "var(--ss-success-text)");

        <div class="dt-status" style="background: @statusBg; border-color: @statusBorder; color: @statusText;">
            <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 600;">@DtVm.StatusMessage</div>
                @if (DtVm.StatusTips.Count > 0)
                {
                    <ul style="margin-block: 4px 0; margin-inline: 18px 0; line-height: 1.5;">
                        @foreach (var tip in DtVm.StatusTips)
                        {
                            <li>@tip</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrEmpty(DtVm.StatusDetails))
                {
                    <details style="margin-top: 6px;">
                        <summary style="cursor: pointer; font-size: 11px; opacity: 0.85;">@UiStrings.Common_TechnicalDetailsAi</summary>
                        <pre class="dt-details-raw">@DtVm.StatusDetails</pre>
                    </details>
                }
            </div>
            <button style="background: none; border: none; cursor: pointer; color: inherit; font-weight: bold; font-size: 14px; align-self: flex-start;" title="@UiStrings.Common_Dismiss" aria-label="@UiStrings.Common_Dismiss" @onclick="DtVm.ClearStatus">✕</button>
        </div>
    }

    <div class="dt-body">
        <!-- Linke Spalte: neue Tabelle + Liste (einklappbar, damit die Tabelle mehr Platz hat) -->
        <div class="dt-side" style="@(sideCollapsed && !DtVm.IsFormOpen ? "display: none;" : "")">
            @if (DtVm.IsFormOpen)
            {
                <div class="dt-card" style="border-color: var(--ss-selected-border);">
                    <h4>@UiStrings.DataTable_FormTitle</h4>

                    <label class="dt-label">@UiStrings.Common_Template</label>
                    <div class="dt-templates">
                        @foreach (var template in DataTableTemplates.All)
                        {
                            var current = template;
                            <button type="button" class="dt-template @(DtVm.Template == current ? "active" : "")" disabled="@DtVm.IsBusy" @onclick="() => DtVm.Template = current">
                                <span style="font-size: 18px;">@DataTableTemplates.Icon(current)</span>
                                <span>
                                    <b>@TemplateTexts.Name(current)</b>
                                    <span class="dt-desc">@TemplateTexts.Description(current)</span>
                                    @if (TemplateTexts.SuggestedColumns(current) is { Length: > 0 } columns)
                                    {
                                        <span class="dt-desc" style="font-style: italic;">@Loc.Format(UiStrings.DataTable_ColumnsExample, ("columns", columns))</span>
                                    }
                                </span>
                            </button>
                        }
                    </div>

                    @if (DtVm.Template == DataTableTemplate.Custom)
                    {
                        <label class="dt-label">@UiStrings.Common_YourInstructions</label>
                        <textarea class="dt-input" rows="3" placeholder="@UiStrings.DataTable_CustomPlaceholder" @bind="DtVm.CustomInstruction" @bind:event="oninput"></textarea>
                    }

                    <label class="dt-label">@UiStrings.DataTable_ColumnsLabel <span style="font-weight: normal; color: var(--ss-text-muted);">@UiStrings.DataTable_ColumnsLabelHint</span></label>
                    <input class="dt-input" placeholder="@ColumnsPlaceholder" @bind="DtVm.CustomColumns" @bind:event="oninput" />
                    <div class="dt-meta" style="margin-top: 3px;">@Loc.Format(UiStrings.DataTable_ColumnsHint, ("source", DataTableDocument.SourceColumnName))</div>

                    <label class="dt-label">@UiStrings.DataTable_TopicLabel <span style="font-weight: normal; color: var(--ss-text-muted);">@UiStrings.Common_OptionalHint</span></label>
                    <input class="dt-input" placeholder="@UiStrings.DataTable_TopicPlaceholder" @bind="DtVm.Topic" @bind:event="oninput" />
                    <div class="dt-meta" style="margin-top: 3px;">@UiStrings.DataTable_TopicHint</div>

                    <label class="dt-label">@UiStrings.Common_TitleLabel <span style="font-weight: normal; color: var(--ss-text-muted);">@UiStrings.Common_TitleOptionalHint</span></label>
                    <input class="dt-input" @bind="DtVm.CustomTitle" @bind:event="oninput" />

                    <button type="button" class="dt-btn" style="background: var(--ss-success); width: 100%; justify-content: center; margin-top: 14px; padding: 9px;"
                            disabled="@(DtVm.IsBusy || ActiveDocumentCount == 0)" @onclick="GenerateAsync">
                        @VmStrings.DataTable_Generate
                    </button>
                    @if (ActiveDocumentCount == 0)
                    {
                        <div class="dt-meta" style="color: var(--ss-danger-fg); margin-top: 6px;">@UiStrings.Common_ActivateDocument</div>
                    }
                    @if (DtVm.Tables.Count > 0 && !DtVm.IsBusy)
                    {
                        <button type="button" class="dt-link" style="margin-top: 8px;" @onclick="() => DtVm.IsFormOpen = false">@UiStrings.Common_Cancel</button>
                    }
                </div>
            }

            @if (DtVm.Tables.Count > 0)
            {
                <div class="dt-card">
                    <h4>@UiStrings.DataTable_Saved</h4>
                    @foreach (var table in DtVm.Tables)
                    {
                        var t = table;
                        var isSelected = DtVm.SelectedTable?.Id == t.Id && !DtVm.IsFormOpen;
                        <div class="dt-item @(isSelected ? "active" : "")" @onclick="() => SelectTable(t.Id)">
                            <span style="font-size: 16px;">@DataTableTemplates.Icon(t.Template)</span>
                            <div style="flex: 1; min-width: 0;">
                                @if (renameId == t.Id)
                                {
                                    <input class="dt-input" style="padding: 3px 6px;" @bind="renameText" @bind:event="oninput" @onclick:stopPropagation="true"
                                           @onkeydown="e => RenameKeyAsync(e, t.Id)" />
                                }
                                else
                                {
                                    <div class="dt-item-title" title="@t.Title">@t.Title</div>
                                }
                                <div class="dt-meta">@Loc.Format(UiStrings.DataTable_ItemMeta, ("template", TemplateTexts.Name(t.Template)), ("rows", t.Rows.Count), ("date", t.CreatedAt.ToString("g")))</div>
                            </div>
                            <div style="display: flex; gap: 2px; flex-shrink: 0;" @onclick:stopPropagation="true">
                                @if (renameId == t.Id)
                                {
                                    <button class="dt-icon" title="@UiStrings.Common_Apply" aria-label="@UiStrings.Common_Apply" @onclick="() => RenameAsync(t.Id)">✔</button>
                                    <button class="dt-icon" title="@UiStrings.Common_Cancel" aria-label="@UiStrings.Common_Cancel" @onclick="() => renameId = null">✕</button>
                                }
                                else if (confirmDeleteId == t.Id)
                                {
                                    <button class="dt-btn" style="background: var(--ss-danger); padding: 2px 8px; font-size: 12px;" @onclick="() => DeleteAsync(t.Id)">@UiStrings.Common_DeleteConfirm</button>
                                    <button class="dt-icon" title="@UiStrings.Common_DontDelete" aria-label="@UiStrings.Common_DontDelete" @onclick="() => confirmDeleteId = null">✕</button>
                                }
                                else
                                {
                                    <button class="dt-icon" title="@UiStrings.Common_Rename" aria-label="@UiStrings.Common_Rename" @onclick="() => StartRename(t)">✏️</button>
                                    <button class="dt-icon" title="@UiStrings.DataTable_DeleteTable" aria-label="@UiStrings.DataTable_DeleteTable" @onclick="() => confirmDeleteId = t.Id">🗑️</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Rechte Spalte: Tabelle -->
        <div class="dt-main">
            @if (DtVm.SelectedTable is { } selected && !DtVm.IsFormOpen)
            {
                var visible = DtVm.VisibleRows;

                <div class="dt-card dt-head dt-noprint">
                    <div style="display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: flex-start;">
                        <div style="min-width: 0; display: flex; gap: 8px; align-items: flex-start;">
                            <button class="ss-icon-btn" title="@(sideCollapsed ? UiStrings.DataTable_ShowList : UiStrings.DataTable_HideList)" aria-label="@(sideCollapsed ? UiStrings.DataTable_ShowList : UiStrings.DataTable_HideList)" @onclick="() => sideCollapsed = !sideCollapsed"><span class="ss-flip-rtl">@(sideCollapsed ? "▶" : "◀")</span></button>
                            <div style="min-width: 0;">
                            <div style="font-size: 15px; font-weight: 700; color: var(--ss-text);">@selected.Title</div>
                            <div class="dt-meta">
                                @TemplateTexts.Name(selected.Template)
                                @if (!string.IsNullOrWhiteSpace(selected.Topic))
                                {
                                    <span> · @Loc.Format(UiStrings.DataTable_TopicMeta, ("topic", selected.Topic))</span>
                                }
                                <span> · @Loc.Format(UiStrings.DataTable_SizeMeta, ("rows", selected.Rows.Count), ("max", DataTableDocument.MaxRows), ("columns", selected.Columns.Count))</span>
                                @if (selected.SourceDocuments.Count > 0)
                                {
                                    <span> · @Loc.Format(UiStrings.DataTable_SourcesMeta, ("sources", string.Join(", ", selected.SourceDocuments)))</span>
                                }
                            </div>
                            </div>
                        </div>
                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                            <button type="button" class="dt-btn" style="background: var(--ss-success);" disabled="@(!DtVm.CanAddMoreRows)"
                                    title="@(DtVm.IsAtRowLimit ? DtVm.RowLimitHint : UiStrings.DataTable_AddMoreRowsTitle)"
                                    @onclick="GenerateMoreRowsAsync">@VmStrings.DataTable_AddMoreRows</button>
                            <button type="button" class="dt-btn" style="background: var(--ss-primary);" disabled="@(DtVm.IsBusy || DtVm.IsAtRowLimit)" title="@UiStrings.DataTable_AddRowTitle" @onclick="AddRowAsync">@UiStrings.DataTable_AddRow</button>
                            <button type="button" class="dt-btn" style="background: var(--ss-primary);" disabled="@(DtVm.IsBusy || selected.Columns.Count >= DataTableDocument.MaxColumns)" title="@UiStrings.DataTable_AddColumnTitle" @onclick="StartAddColumn">@UiStrings.DataTable_AddColumn</button>
                        </div>
                    </div>

                    @if (DtVm.IsAtRowLimit)
                    {
                        <div class="dt-limit">⚠️ @DtVm.RowLimitHint</div>
                    }

                    @if (addingColumn)
                    {
                        <div style="display: flex; gap: 6px; align-items: center; margin-top: 8px;">
                            <input id="dt-newcol" class="dt-input" style="max-width: 260px;" placeholder="@UiStrings.DataTable_NewColumnPlaceholder" @bind="newColumnName" @bind:event="oninput" @onkeydown="AddColumnKeyAsync" />
                            <button class="dt-btn" style="background: var(--ss-success);" @onclick="AddColumnAsync">@UiStrings.DataTable_Add</button>
                            <button class="dt-icon" title="@UiStrings.Common_Cancel" aria-label="@UiStrings.Common_Cancel" @onclick="() => addingColumn = false">✕</button>
                        </div>
                    }

                    <div style="display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 10px;">
                        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            <input class="dt-input" style="width: 260px;" placeholder="@UiStrings.DataTable_FilterPlaceholder" @bind="DtVm.FilterText" @bind:event="oninput" />
                            @if (DtVm.HasFilter)
                            {
                                <span class="dt-meta">@Loc.Format(UiStrings.DataTable_FilterCount, ("visible", visible.Count), ("total", selected.Rows.Count))</span>
                                <button class="dt-link" @onclick='() => DtVm.FilterText = ""'>@UiStrings.DataTable_ClearFilter</button>
                                <label class="dt-check" title="@UiStrings.DataTable_ExportFilteredTitle">
                                    <input type="checkbox" checked="@DtVm.ExportFilteredOnly" @onchange="e => DtVm.ExportFilteredOnly = e.Value is true" />
                                    <span>@UiStrings.DataTable_ExportFilteredOnly</span>
                                </label>
                            }
                            @if (DtVm.SortColumn != null)
                            {
                                <button class="dt-link" @onclick="DtVm.ClearSort">@UiStrings.DataTable_ClearSort</button>
                            }
                        </div>
                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                            <button type="button" class="dt-btn" style="background: #1d6f42;" title="@UiStrings.DataTable_ExcelTitle" @onclick="() => ExportAsync(DataTableExportFormat.Excel)">@UiStrings.DataTable_ExcelButton</button> @* ss:feste-farbe – Excel-Markenfarbe *@
                            <button type="button" class="dt-btn" style="background: var(--ss-strong);" title="@UiStrings.DataTable_CsvTitle" @onclick="() => ExportAsync(DataTableExportFormat.Csv)">🧾 CSV</button>
                            <button type="button" class="dt-btn" style="background: var(--ss-info);" title="@UiStrings.DataTable_MarkdownTitle" @onclick="() => ExportAsync(DataTableExportFormat.Markdown)">📄 Markdown</button>
                            <button type="button" class="dt-btn" style="background: var(--ss-secondary);" title="@UiStrings.DataTable_PdfTitle" @onclick="PrintAsync">🖨️ PDF</button>
                        </div>
                    </div>
                </div>

                <div class="dt-print-area">
                    <div class="dt-print-header">
                        <div style="font-size: 16pt; font-weight: bold;">@selected.Title</div>
                        <div style="font-size: 9pt; color: var(--ss-text-muted);">
                            @Loc.Format(UiStrings.DataTable_PrintMeta, ("template", TemplateTexts.Name(selected.Template)), ("rows", visible.Count), ("date", DateTime.Now.ToString("d")))
                        </div>
                    </div>

                    <div class="dt-scroll">
                        <table class="dt-table">
                            <thead>
                                <tr>
                                    @for (var c = 0; c < selected.Columns.Count; c++)
                                    {
                                        var col = c;
                                        <th>
                                            @if (renameColumn == col)
                                            {
                                                <div style="display: flex; gap: 3px; align-items: center;">
                                                    <input id="dt-colrename" class="dt-input" style="padding: 2px 5px; min-width: 90px;" @bind="renameColumnText" @bind:event="oninput" @onkeydown="e => RenameColumnKeyAsync(e, col)" />
                                                    <button class="dt-icon" title="@UiStrings.Common_Apply" aria-label="@UiStrings.Common_Apply" @onclick="() => RenameColumnAsync(col)">✔</button>
                                                    <button class="dt-icon" title="@UiStrings.Common_Cancel" aria-label="@UiStrings.Common_Cancel" @onclick="() => renameColumn = null">✕</button>
                                                </div>
                                            }
                                            else if (confirmDeleteColumn == col)
                                            {
                                                <div style="display: flex; gap: 3px; align-items: center;">
                                                    <button class="dt-btn" style="background: var(--ss-danger); padding: 2px 8px; font-size: 11px;" @onclick="() => DeleteColumnAsync(col)">@Loc.Format(UiStrings.DataTable_DeleteColumnConfirm, ("name", selected.Columns[col]))</button>
                                                    <button class="dt-icon" title="@UiStrings.Common_DontDelete" aria-label="@UiStrings.Common_DontDelete" @onclick="() => confirmDeleteColumn = null">✕</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="dt-th">
                                                    <button class="dt-sort" title="@UiStrings.DataTable_Sort" @onclick="() => DtVm.ToggleSort(col)">
                                                        @selected.Columns[col] <span class="dt-arrow">@SortArrow(col)</span>
                                                    </button>
                                                    <span class="dt-th-tools dt-noprint">
                                                        <button class="dt-icon small" title="@UiStrings.DataTable_RenameColumn" aria-label="@UiStrings.DataTable_RenameColumn" @onclick="() => StartRenameColumn(col)">✏️</button>
                                                        <button class="dt-icon small" title="@UiStrings.DataTable_DeleteColumn" aria-label="@UiStrings.DataTable_DeleteColumn" @onclick="() => StartDeleteColumn(col)">🗑️</button>
                                                    </span>
                                                </div>
                                            }
                                        </th>
                                    }
                                    <th class="dt-source-col">
                                        <button class="dt-sort" title="@UiStrings.DataTable_SortBySource" @onclick="() => DtVm.ToggleSort(DataTableSorting.SourceColumn)">
                                            @DataTableDocument.SourceColumnName <span class="dt-arrow">@SortArrow(DataTableSorting.SourceColumn)</span>
                                        </button>
                                    </th>
                                    <th class="dt-actions dt-noprint"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in visible)
                                {
                                    var r = row;
                                    <tr @key="r.Id">
                                        @for (var c = 0; c < selected.Columns.Count; c++)
                                        {
                                            var col = c;
                                            @Cell(r, col)
                                        }
                                        @Cell(r, DataTableSorting.SourceColumn)
                                        <td class="dt-actions dt-noprint">
                                            @if (confirmDeleteRowId == r.Id)
                                            {
                                                <button class="dt-btn" style="background: var(--ss-danger); padding: 2px 6px; font-size: 11px;" @onclick="() => DeleteRowAsync(r.Id)">@UiStrings.Common_DeleteConfirm</button>
                                                <button class="dt-icon small" title="@UiStrings.Common_DontDelete" aria-label="@UiStrings.Common_DontDelete" @onclick="() => confirmDeleteRowId = null">✕</button>
                                            }
                                            else
                                            {
                                                <button class="dt-icon small" title="@UiStrings.DataTable_DeleteRow" aria-label="@UiStrings.DataTable_DeleteRow" @onclick="() => confirmDeleteRowId = r.Id">🗑️</button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (visible.Count == 0)
                                {
                                    <tr>
                                        <td colspan="@(selected.Columns.Count + 2)" class="dt-empty-row">
                                            @(DtVm.HasFilter ? UiStrings.DataTable_NoFilterMatch : UiStrings.DataTable_NoRows)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="dt-meta dt-noprint" style="margin-top: 6px;">@UiStrings.DataTable_EditHint</div>
                </div>
            }
            else if (!DtVm.IsBusy)
            {
                <div class="dt-empty">
                    <div style="font-size: 34px; margin-bottom: 10px;">📊</div>
                    <p style="font-size: 14px; font-weight: 600; margin-bottom: 8px; color: var(--ss-text);">@UiStrings.DataTable_EmptyTitle</p>
                    <span style="font-size: 12px; line-height: 1.5; display: block;">
                        @Loc.Format(UiStrings.DataTable_EmptyHint, ("button", VmStrings.DataTable_Generate))
                    </span>
                </div>
            }
        </div>
    </div>

    <style>
        .dt-root { flex: 1; display: flex; flex-direction: column; background: var(--ss-panel-light); padding: 20px; height: 100%; min-height: 0; box-sizing: border-box; }
        .dt-toolbar { display: flex; justify-content: space-between; align-items: center; background: var(--ss-surface); padding: 12px 18px; border-radius: 8px; border: 1px solid var(--ss-border-light); flex-wrap: wrap; gap: 12px; }
        .dt-btn { padding: 6px 11px; color: var(--ss-on-accent); border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 12.5px; display: inline-flex; align-items: center; gap: 5px; }
        .dt-btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .dt-link { background: none; border: none; color: var(--ss-link); cursor: pointer; font-size: 12px; padding: 0; }
        .dt-icon { background: none; border: 1px solid transparent; border-radius: 4px; cursor: pointer; font-size: 13px; padding: 2px 5px; }
        .dt-icon.small { font-size: 11px; padding: 1px 3px; }
        .dt-icon:hover { background: var(--ss-hover); border-color: var(--ss-border-light); }
        .dt-info { margin-top: 14px; padding: 14px 20px; background: var(--ss-info-bg); border: 1px solid var(--ss-info-border); border-radius: 8px; text-align: center; color: var(--ss-info-text); }
        .dt-progress { width: 100%; max-width: 480px; height: 6px; background: var(--ss-info-bg-strong); border-radius: 4px; margin: 10px auto 4px auto; overflow: hidden; position: relative; }
        .dt-progress-bar { width: 40%; height: 100%; background: linear-gradient(90deg, var(--ss-primary), var(--ss-primary-hover)); border-radius: 4px; position: absolute; animation: dt-slide 1.4s ease-in-out infinite; }
        @@keyframes dt-slide { 0% { left: -40%; } 100% { left: 100%; } }  /* ss:physisch – Ladebalken läuft immer von links nach rechts */
        .dt-status { margin-top: 12px; padding: 10px 14px; border: 1px solid; border-radius: 6px; font-size: 12px; display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
        .dt-details-raw { margin-top: 4px; max-height: 160px; overflow: auto; padding: 8px; background: var(--ss-raw-bg); border-radius: 4px; font-family: Consolas, "DejaVu Sans Mono", monospace; font-size: 11px; white-space: pre-wrap; word-break: break-word; color: var(--ss-text); }
        .dt-body { flex: 1; min-height: 0; display: flex; gap: 14px; margin-top: 16px; }
        .dt-side { width: 320px; flex-shrink: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
        .dt-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px; min-height: 0; overflow-y: auto; }
        .dt-card { background: var(--ss-surface); border: 1px solid var(--ss-border-light); border-radius: 8px; padding: 14px 16px; }
        .dt-card h4 { margin: 0 0 8px 0; font-size: 14px; color: var(--ss-text); }
        .dt-head { padding: 10px 14px; }
        .dt-limit { margin-top: 8px; padding: 6px 10px; background: var(--ss-warning-bg); border: 1px solid var(--ss-warning-border); color: var(--ss-warning-text); border-radius: 4px; font-size: 12px; }
        .dt-label { font-size: 12px; font-weight: 600; color: var(--ss-text-2); margin: 12px 0 4px 0; display: block; }
        .dt-input { width: 100%; box-sizing: border-box; padding: 6px 8px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 13px; font-family: inherit; }
        .dt-templates { display: flex; flex-direction: column; gap: 6px; }
        .dt-template { display: flex; gap: 10px; align-items: flex-start; text-align: start; padding: 7px 10px; border: 2px solid var(--ss-border-light); border-radius: 6px; background: var(--ss-surface); cursor: pointer; font-size: 13px; color: var(--ss-text); font-family: inherit; }
        .dt-template.active { border-color: var(--ss-primary); background: var(--ss-selected-bg); }
        .dt-template b { display: block; }
        .dt-desc { display: block; font-size: 11.5px; color: var(--ss-text-muted); line-height: 1.35; }
        .dt-check { display: inline-flex; gap: 5px; align-items: center; font-size: 12px; cursor: pointer; color: var(--ss-text-2); }
        .dt-meta { font-size: 11px; color: var(--ss-text-muted); }
        .dt-item { display: flex; gap: 8px; align-items: flex-start; padding: 8px 6px; border-radius: 6px; cursor: pointer; border: 1px solid transparent; }
        .dt-item:hover { background: var(--ss-panel-light); }
        .dt-item.active { background: var(--ss-selected-bg); border-color: var(--ss-selected-border); }
        .dt-item-title { font-size: 13px; font-weight: 600; color: var(--ss-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .dt-print-area { flex: 1 0 auto; min-height: 0; display: flex; flex-direction: column; }
        .dt-print-header { display: none; }
        .dt-scroll { flex: 1 1 auto; min-height: 340px; max-height: calc(100vh - 160px); overflow: auto; background: var(--ss-surface); border: 1px solid var(--ss-border-light); border-radius: 8px; }
        .dt-table { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 12.5px; }
        .dt-table th { position: sticky; top: 0; z-index: 1; background: var(--ss-selected-bg); color: var(--ss-text); text-align: start; padding: 6px 8px; border-bottom: 2px solid var(--ss-selected-border); border-inline-end: 1px solid var(--ss-border-light); vertical-align: top; min-width: 90px; }
        .dt-table td { padding: 5px 8px; border-bottom: 1px solid var(--ss-border-faint); border-inline-end: 1px solid var(--ss-border-faint); vertical-align: top; white-space: pre-wrap; word-break: break-word; cursor: text; min-width: 60px; }
        .dt-table tbody tr:nth-child(even) td { background: var(--ss-panel-light); }
        .dt-table tbody tr:hover td { background: var(--ss-selected-bg); }
        .dt-table td.dt-source, .dt-table th.dt-source-col { color: var(--ss-text-muted); font-size: 11.5px; min-width: 110px; }
        .dt-table .dt-actions { width: 1%; white-space: nowrap; min-width: 0; text-align: end; cursor: default; }
        .dt-table td.editing { padding: 2px 4px; background: var(--ss-highlight-bg) !important; }
        .dt-cell-input { width: 100%; box-sizing: border-box; min-width: 120px; padding: 3px 5px; border: 1px solid var(--ss-primary); border-radius: 3px; font-size: 12.5px; font-family: inherit; }
        .dt-th { display: flex; align-items: flex-start; justify-content: space-between; gap: 4px; }
        .dt-sort { background: none; border: none; padding: 0; font-weight: 700; font-size: 12.5px; cursor: pointer; text-align: start; color: inherit; font-family: inherit; }
        .dt-arrow { color: var(--ss-link); font-size: 11px; }
        .dt-th-tools { display: inline-flex; opacity: 0.35; flex-shrink: 0; }
        .dt-table th:hover .dt-th-tools { opacity: 1; }
        .dt-empty-row { text-align: center; color: var(--ss-text-muted); padding: 20px !important; cursor: default !important; }
        .dt-empty { margin: auto; text-align: center; color: var(--ss-text-muted); max-width: 480px; background: var(--ss-surface); padding: 30px; border-radius: 8px; border: 1px dashed var(--ss-border); }

        @@media print {
            @@page { size: A4 landscape; margin: 12mm; }
            body * { visibility: hidden; }
            .dt-print-area, .dt-print-area * { visibility: visible; }
            .dt-print-area { position: absolute; left: 0; top: 0; width: 100%; display: block; }  /* ss:physisch – Druckseite */
            .dt-print-header { display: block; margin-bottom: 5mm; }
            .dt-noprint, .dt-noprint * { display: none !important; }
            .dt-scroll { overflow: visible !important; max-height: none !important; min-height: 0 !important; border: none; border-radius: 0; }
            .dt-root, .dt-main, .dt-body { background: var(--ss-surface) !important; overflow: visible !important; }
            .dt-table { font-size: 9pt; }
            .dt-table th { position: static; background: var(--ss-selected-bg) !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .dt-table thead { display: table-header-group; }
            .dt-table tr { page-break-inside: avoid; break-inside: avoid; }
            .dt-table th, .dt-table td { border: 1px solid var(--ss-border-strong); }
        }
    </style>
</div>

@code {
    private string? renameId;
    private string renameText = string.Empty;
    private string? confirmDeleteId;

    private string? editRowId;
    private int editColumn;
    private string editText = string.Empty;
    private bool focusEditor;

    private int? renameColumn;
    private string renameColumnText = string.Empty;
    private int? confirmDeleteColumn;
    private bool addingColumn;
    private string newColumnName = string.Empty;
    private string? focusElementId;

    private string? confirmDeleteRowId;
    private bool sideCollapsed;

    private int ActiveDocumentCount => DocVm.Documents.Count(d => d.IsSelected && !d.IsMissing);

    private string ActiveDocumentsText => ActiveDocumentCount == 0
        ? UiStrings.Common_NoActiveDocument
        : Loc.Format(UiStrings.Common_ActiveDocuments, ("count", ActiveDocumentCount));

    private string ColumnsPlaceholder => TemplateTexts.SuggestedColumns(DtVm.Template) is { Length: > 0 } suggested
        ? suggested
        : UiStrings.DataTable_ColumnsPlaceholder;

    private string SortArrow(int column) =>
        DtVm.SortColumn == column ? (DtVm.SortDescending ? "▼" : "▲") : "";

    /// <summary>Zelle: Anzeige, per Doppelklick Eingabefeld (Enter übernimmt, Esc bricht ab, Verlassen übernimmt).</summary>
    private RenderFragment Cell(DataTableRow row, int column) => __builder =>
    {
        var value = DataTableSorting.CellValue(row, column);
        var isSource = column == DataTableSorting.SourceColumn;
        if (editRowId == row.Id && editColumn == column)
        {
            <td class="editing @(isSource ? "dt-source" : "")">
                <input id="dt-cell-editor" class="dt-cell-input" @bind="editText" @bind:event="oninput"
                       @onkeydown="EditKeyAsync" @onblur="CommitEditAsync" />
            </td>
        }
        else
        {
            <td class="@(isSource ? "dt-source" : "")" title="@(isSource ? UiStrings.DataTable_SourceCellTitle : null)" @ondblclick="() => StartEdit(row, column)">@value</td>
        }
    };

    protected override async Task OnInitializedAsync()
    {
        DtVm.PropertyChanged += OnVmChanged;
        DocVm.PropertyChanged += OnDocVmChanged;
        DocVm.Documents.CollectionChanged += OnDocumentsChanged;
        await DtVm.LoadForProfileAsync(DocVm.CurrentProfile);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string? id = null;
        if (focusEditor)
        {
            focusEditor = false;
            id = "dt-cell-editor";
        }
        else if (focusElementId != null)
        {
            id = focusElementId;
            focusElementId = null;
        }

        if (id != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", $"(function(){{var e=document.getElementById('{id}'); if(e){{e.focus(); if(e.select) e.select();}}}})()");
            }
            catch
            {
                // Fokus ist nur eine Bequemlichkeit
            }
        }
    }

    private void OnVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OnDocumentsChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private async void OnDocVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(DocVm.CurrentProfile))
        {
            ResetEditing();
            renameId = null;
            confirmDeleteId = null;
            await DtVm.LoadForProfileAsync(DocVm.CurrentProfile);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ResetEditing()
    {
        editRowId = null;
        renameColumn = null;
        confirmDeleteColumn = null;
        confirmDeleteRowId = null;
        addingColumn = false;
    }

    private void SelectTable(string id)
    {
        ResetEditing();
        DtVm.SelectTable(id);
    }

    private Task GenerateAsync() => DtVm.GenerateAsync(DocVm.Documents);

    private Task GenerateMoreRowsAsync() => DtVm.GenerateMoreRowsAsync(DocVm.Documents);

    // ---------------- Zellen ----------------

    private void StartEdit(DataTableRow row, int column)
    {
        editRowId = row.Id;
        editColumn = column;
        editText = DataTableSorting.CellValue(row, column);
        focusEditor = true;
    }

    private async Task CommitEditAsync()
    {
        if (editRowId == null) return;

        var rowId = editRowId;
        var column = editColumn;
        var text = editText;
        editRowId = null;
        await DtVm.SetCellAsync(rowId, column, text);
    }

    private async Task EditKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitEditAsync();
        else if (e.Key == "Escape") editRowId = null;
    }

    // ---------------- Zeilen ----------------

    private async Task AddRowAsync()
    {
        ResetEditing();
        // Mit Filter wäre die leere Zeile unsichtbar
        if (DtVm.HasFilter) DtVm.FilterText = string.Empty;

        var id = await DtVm.AddRowAsync();
        var row = id == null ? null : DtVm.SelectedTable?.Rows.FirstOrDefault(r => r.Id == id);
        if (row != null && DtVm.SelectedTable!.Columns.Count > 0)
            StartEdit(row, 0);
    }

    private async Task DeleteRowAsync(string rowId)
    {
        confirmDeleteRowId = null;
        if (editRowId == rowId) editRowId = null;
        await DtVm.DeleteRowAsync(rowId);
    }

    // ---------------- Spalten ----------------

    private void StartAddColumn()
    {
        ResetEditing();
        addingColumn = true;
        newColumnName = string.Empty;
        focusElementId = "dt-newcol";
    }

    private async Task AddColumnAsync()
    {
        if (await DtVm.AddColumnAsync(newColumnName))
        {
            addingColumn = false;
            newColumnName = string.Empty;
        }
    }

    private async Task AddColumnKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddColumnAsync();
        else if (e.Key == "Escape") addingColumn = false;
    }

    private void StartRenameColumn(int column)
    {
        ResetEditing();
        renameColumn = column;
        renameColumnText = DtVm.SelectedTable?.Columns[column] ?? string.Empty;
        focusElementId = "dt-colrename";
    }

    private async Task RenameColumnAsync(int column)
    {
        if (await DtVm.RenameColumnAsync(column, renameColumnText))
            renameColumn = null;
    }

    private async Task RenameColumnKeyAsync(KeyboardEventArgs e, int column)
    {
        if (e.Key == "Enter") await RenameColumnAsync(column);
        else if (e.Key == "Escape") renameColumn = null;
    }

    private void StartDeleteColumn(int column)
    {
        ResetEditing();
        confirmDeleteColumn = column;
    }

    private async Task DeleteColumnAsync(int column)
    {
        confirmDeleteColumn = null;
        await DtVm.DeleteColumnAsync(column);
    }

    // ---------------- Tabellen ----------------

    private void StartRename(DataTableDocument table)
    {
        confirmDeleteId = null;
        renameId = table.Id;
        renameText = table.Title;
    }

    private async Task RenameAsync(string tableId)
    {
        if (await DtVm.RenameTableAsync(tableId, renameText))
            renameId = null;
    }

    private async Task RenameKeyAsync(KeyboardEventArgs e, string tableId)
    {
        if (e.Key == "Enter") await RenameAsync(tableId);
        else if (e.Key == "Escape") renameId = null;
    }

    private async Task DeleteAsync(string tableId)
    {
        confirmDeleteId = null;
        ResetEditing();
        await DtVm.DeleteTableAsync(tableId);
    }

    // ---------------- Export und Druck ----------------

    private async Task ExportAsync(DataTableExportFormat format)
    {
        try
        {
            var extension = DataTableViewModel.Extension(format);
            var path = await DesktopDialogs.SaveFileAsync(
                DtVm.SuggestFileName(format),
                filterExtension: extension,
                filterDescription: DataTableViewModel.FormatDescription(format),
                title: UiStrings.DataTable_SaveAsTitle);

            if (string.IsNullOrWhiteSpace(path))
                return;

            if (!path.EndsWith("." + extension, StringComparison.OrdinalIgnoreCase))
                path += "." + extension;

            await DtVm.ExportAsync(format, path);
        }
        catch (Exception ex)
        {
            DtVm.ShowStatus(Loc.Format(VmStrings.DataTable_ExportFailed, ("error", ex.Message)), isError: true);
        }
    }

    /// <summary>Druckt die aktuelle Ansicht der Tabelle (Filter und Sortierung) über die eigene Druckansicht.</summary>
    private async Task PrintAsync()
    {
        ResetEditing();
        StateHasChanged();
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            DtVm.ShowStatus(Loc.Format(UiStrings.Common_PrintDialogFailed, ("error", ex.Message)), isError: true,
                new[] { Loc.Format(UiStrings.DataTable_PrintTip, ("button", UiStrings.DataTable_ExcelButton)) });
        }
    }

    public void Dispose()
    {
        DtVm.PropertyChanged -= OnVmChanged;
        DocVm.PropertyChanged -= OnDocVmChanged;
        DocVm.Documents.CollectionChanged -= OnDocumentsChanged;
    }
}

@using Microsoft.JSInterop
@using StudyScope.UI.Services
@inject ReportViewModel RepVm
@inject DocumentListViewModel DocVm
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="rp-root">

    <div class="rp-toolbar">
        <div>
            <h3 style="margin: 0; font-size: 16px; color: var(--ss-text);">@Loc.Format(UiStrings.Report_Title, ("profile", DocVm.CurrentProfile))</h3>
            <span style="font-size: 12px; color: var(--ss-text-muted);">
                @Loc.Format(UiStrings.Common_BasedOn,
                    ("items", RepVm.Reports.Count == 0 ? UiStrings.Report_NoReports : Loc.Format(UiStrings.Report_ReportCount, ("count", RepVm.Reports.Count))),
                    ("documents", ActiveDocumentsText))
            </span>
        </div>
        @if (!RepVm.IsFormOpen && !RepVm.IsBusy)
        {
            <button type="button" class="rp-btn" style="background: var(--ss-primary);" @onclick="RepVm.OpenForm">@UiStrings.Report_New</button>
        }
    </div>

    @if (RepVm.IsBusy)
    {
        <div class="rp-info">
            <div style="font-weight: 600; font-size: 13px;">@Loc.Format(UiStrings.Report_Busy, ("template", TemplateTexts.Name(RepVm.Template)))</div>
            <div class="rp-progress"><div class="rp-progress-bar"></div></div>
            <div style="display: flex; justify-content: center; gap: 10px; align-items: center; margin-top: 6px;">
                <span style="font-size: 11px; color: var(--ss-text-muted);">@UiStrings.Common_GenerationWait</span>
                <button type="button" class="rp-btn" style="background: var(--ss-secondary); padding: 4px 10px;" @onclick="RepVm.Cancel">@UiStrings.Common_Cancel</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(RepVm.StatusMessage))
    {
        var (statusBg, statusBorder, statusText) = RepVm.IsError
            ? ("var(--ss-danger-bg)", "var(--ss-danger-border)", "var(--ss-danger-text)")
            : RepVm.IsWarning ? ("var(--ss-warning-bg)", "var(--ss-warning-border)", "var(--ss-warning-text)") : ("var(--ss-success-bg)", "var(--ss-success-border)", "var(--ss-success-text)");

        <div class="rp-status" style="background: @statusBg; border-color: @statusBorder; color: @statusText;">
            <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 600;">@RepVm.StatusMessage</div>
                @if (RepVm.StatusTips.Count > 0)
                {
                    <ul style="margin-block: 4px 0; margin-inline: 18px 0; line-height: 1.5;">
                        @foreach (var tip in RepVm.StatusTips)
                        {
                            <li>@tip</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrEmpty(RepVm.StatusDetails))
                {
                    <details style="margin-top: 6px;">
                        <summary style="cursor: pointer; font-size: 11px; opacity: 0.85;">@UiStrings.Common_TechnicalDetailsAi</summary>
                        <pre class="rp-details-raw">@RepVm.StatusDetails</pre>
                    </details>
                }
            </div>
            <button style="background: none; border: none; cursor: pointer; color: inherit; font-weight: bold; font-size: 14px; align-self: flex-start;" title="@UiStrings.Common_Dismiss" aria-label="@UiStrings.Common_Dismiss" @onclick="RepVm.ClearStatus">✕</button>
        </div>
    }

    <div class="rp-body">
        <!-- Linke Spalte: neuer Bericht + Liste -->
        <div class="rp-side">
            @if (RepVm.IsFormOpen)
            {
                <div class="rp-card" style="border-color: var(--ss-selected-border);">
                    <h4>@UiStrings.Report_FormTitle</h4>

                    <label class="rp-label">@UiStrings.Common_Template</label>
                    <div class="rp-templates">
                        @foreach (var template in ReportTemplates.All)
                        {
                            var current = template;
                            <button type="button" class="rp-template @(RepVm.Template == current ? "active" : "")" disabled="@RepVm.IsBusy" @onclick="() => RepVm.Template = current">
                                <span style="font-size: 18px;">@ReportTemplates.Icon(current)</span>
                                <span>
                                    <b>@TemplateTexts.Name(current)</b>
                                    <span class="rp-desc">@TemplateTexts.Description(current)</span>
                                </span>
                            </button>
                        }
                    </div>

                    @if (RepVm.Template == ReportTemplate.Custom)
                    {
                        <label class="rp-label">@UiStrings.Common_YourInstructions</label>
                        <textarea class="rp-input" rows="3" placeholder="@UiStrings.Report_CustomPlaceholder" @bind="RepVm.CustomInstruction" @bind:event="oninput"></textarea>
                    }

                    <label class="rp-label">@UiStrings.Common_TitleLabel <span style="font-weight: normal; color: var(--ss-text-muted);">@UiStrings.Common_TitleOptionalHint</span></label>
                    <input class="rp-input" @bind="RepVm.CustomTitle" @bind:event="oninput" />

                    <label class="rp-label">@UiStrings.Report_EmbedTitle</label>
                    @EmbedCheckbox("mindmap", UiStrings.Report_EmbedMindmapFull, RepVm.NewEmbeds.Mindmap, RepVm.HasMindmap, RepVm.HasMindmap ? UiStrings.Report_MindmapPresent : UiStrings.Report_MindmapMissing, true)
                    @EmbedCheckbox("flashcards", UiStrings.Report_EmbedFlashcardsFull, RepVm.NewEmbeds.Flashcards, RepVm.FlashcardCount > 0, Number(RepVm.FlashcardCount), true)
                    @EmbedCheckbox("quiz", UiStrings.Report_EmbedQuizFull, RepVm.NewEmbeds.Quiz, RepVm.QuizQuestionCount > 0, Number(RepVm.QuizQuestionCount), true)
                    @EmbedCheckbox("presentation", UiStrings.Report_EmbedPresentationFull, RepVm.NewEmbeds.Presentation, RepVm.PresentationSlideCount > 0, Loc.Format(UiStrings.Report_SlideCount, ("count", RepVm.PresentationSlideCount)), true)
                    @EmbedCheckbox("datatables", UiStrings.Report_EmbedDataTablesFull, RepVm.NewEmbeds.IncludesDataTables, RepVm.DataTableCount > 0, Number(RepVm.DataTableCount), true)
                    @EmbedCheckbox("audio", UiStrings.Report_EmbedAudioFull, RepVm.NewEmbeds.IncludesAudioScripts, RepVm.AudioScriptCount > 0, Number(RepVm.AudioScriptCount), true)
                    @EmbedCheckbox("video", UiStrings.Report_EmbedVideoFull, RepVm.NewEmbeds.IncludesVideoScripts, RepVm.VideoScriptCount > 0, Number(RepVm.VideoScriptCount), true)
                    <div class="rp-meta" style="margin-top: 4px;">@UiStrings.Report_EmbedHint</div>

                    <button type="button" class="rp-btn" style="background: var(--ss-success); width: 100%; justify-content: center; margin-top: 14px; padding: 9px;"
                            disabled="@(RepVm.IsBusy || ActiveDocumentCount == 0)" @onclick="GenerateAsync">
                        @VmStrings.Report_Generate
                    </button>
                    @if (ActiveDocumentCount == 0)
                    {
                        <div class="rp-meta" style="color: var(--ss-danger-fg); margin-top: 6px;">@UiStrings.Common_ActivateDocument</div>
                    }
                    @if (RepVm.Reports.Count > 0 && !RepVm.IsBusy)
                    {
                        <button type="button" class="rp-link" style="margin-top: 8px;" @onclick="() => RepVm.IsFormOpen = false">@UiStrings.Common_Cancel</button>
                    }
                </div>
            }

            @if (RepVm.Reports.Count > 0)
            {
                <div class="rp-card">
                    <h4>@UiStrings.Report_Saved</h4>
                    @foreach (var report in RepVm.Reports)
                    {
                        var r = report;
                        var isSelected = RepVm.SelectedReport?.Id == r.Id && !RepVm.IsFormOpen;
                        <div class="rp-item @(isSelected ? "active" : "")" @onclick="() => RepVm.SelectReport(r.Id)">
                            <span style="font-size: 16px;">@ReportTemplates.Icon(r.Template)</span>
                            <div style="flex: 1; min-width: 0;">
                                @if (renameId == r.Id)
                                {
                                    <input class="rp-input" style="padding: 3px 6px;" @bind="renameText" @bind:event="oninput" @onclick:stopPropagation="true"
                                           @onkeydown="e => RenameKeyAsync(e, r.Id)" />
                                }
                                else
                                {
                                    <div class="rp-item-title" title="@r.Title">@r.Title</div>
                                }
                                <div class="rp-meta">@Loc.Format(UiStrings.Report_ItemMeta, ("template", TemplateTexts.Name(r.Template)), ("date", r.CreatedAt.ToString("g")))</div>
                            </div>
                            <div style="display: flex; gap: 2px; flex-shrink: 0;" @onclick:stopPropagation="true">
                                @if (renameId == r.Id)
                                {
                                    <button class="rp-icon" title="@UiStrings.Common_Apply" aria-label="@UiStrings.Common_Apply" @onclick="() => RenameAsync(r.Id)">✔</button>
                                    <button class="rp-icon" title="@UiStrings.Common_Cancel" aria-label="@UiStrings.Common_Cancel" @onclick="() => renameId = null">✕</button>
                                }
                                else if (confirmDeleteId == r.Id)
                                {
                                    <button class="rp-btn" style="background: var(--ss-danger); padding: 2px 8px; font-size: 12px;" @onclick="() => DeleteAsync(r.Id)">@UiStrings.Common_DeleteConfirm</button>
                                    <button class="rp-icon" title="@UiStrings.Common_DontDelete" aria-label="@UiStrings.Common_DontDelete" @onclick="() => confirmDeleteId = null">✕</button>
                                }
                                else
                                {
                                    <button class="rp-icon" title="@UiStrings.Common_Rename" aria-label="@UiStrings.Common_Rename" @onclick="() => StartRename(r)">✏️</button>
                                    <button class="rp-icon" title="@UiStrings.Report_DeleteReport" aria-label="@UiStrings.Report_DeleteReport" @onclick="() => confirmDeleteId = r.Id">🗑️</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Rechte Spalte: interaktiver Bericht -->
        <div class="rp-main">
            @if (RepVm.SelectedReport is { } selected && !string.IsNullOrEmpty(RepVm.CurrentHtml))
            {
                <div class="rp-card rp-viewer-head">
                    <div style="display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: center;">
                        <div style="font-size: 12px; color: var(--ss-text-2); display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                            <b>@UiStrings.Report_Embedded</b>
                            @EmbedCheckbox("mindmap", UiStrings.Report_EmbedMindmap, selected.Embeds.Mindmap, RepVm.HasMindmap, null, false)
                            @EmbedCheckbox("flashcards", UiStrings.Report_EmbedFlashcards, selected.Embeds.Flashcards, RepVm.FlashcardCount > 0, null, false)
                            @EmbedCheckbox("quiz", UiStrings.Report_EmbedQuiz, selected.Embeds.Quiz, RepVm.QuizQuestionCount > 0, null, false)
                            @EmbedCheckbox("presentation", UiStrings.Report_EmbedPresentation, selected.Embeds.Presentation, RepVm.PresentationSlideCount > 0, null, false)
                            @EmbedCheckbox("datatables", UiStrings.Report_EmbedDataTables, selected.Embeds.IncludesDataTables, RepVm.DataTableCount > 0, null, false)
                            @EmbedCheckbox("audio", UiStrings.Report_EmbedAudio, selected.Embeds.IncludesAudioScripts, RepVm.AudioScriptCount > 0, null, false)
                            @EmbedCheckbox("video", UiStrings.Report_EmbedVideo, selected.Embeds.IncludesVideoScripts, RepVm.VideoScriptCount > 0, null, false)
                        </div>
                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                            <button type="button" class="rp-btn" style="background: #2b579a;" title="@UiStrings.Report_WordTitle" @onclick="() => ExportAsync(ReportExportFormat.Word)">📝 Word</button> @* ss:feste-farbe – Word-Markenfarbe *@
                            <button type="button" class="rp-btn" style="background: var(--ss-secondary);" title="@UiStrings.Report_PdfTitle" @onclick="PrintAsync">🖨️ PDF</button>
                            <button type="button" class="rp-btn" style="background: var(--ss-info);" title="@UiStrings.Report_MarkdownTitle" @onclick="() => ExportAsync(ReportExportFormat.Markdown)">📄 Markdown</button>
                            <button type="button" class="rp-btn" style="background: var(--ss-strong);" title="@UiStrings.Report_TextTitle" @onclick="() => ExportAsync(ReportExportFormat.Text)">🗒️ Text</button>
                            <button type="button" class="rp-btn" style="background: var(--ss-purple);" disabled="@RepVm.IsBusy" title="@UiStrings.Report_HtmlTitle" @onclick="() => ExportAsync(ReportExportFormat.Html)">@UiStrings.Report_HtmlButton</button>
                        </div>
                    </div>
                    @if (RepVm.CanEmbedVideoPlayers)
                    {
                        <div style="margin-top: 8px; font-size: 12px; color: var(--ss-text-2); display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                            <label style="display: flex; gap: 6px; align-items: center; cursor: pointer;"
                                   title="@Loc.Format(UiStrings.Report_EmbedPlayersTitle, ("button", UiStrings.Report_HtmlButton))">
                                <input type="checkbox" checked="@RepVm.EmbedVideoPlayers" @onchange="e => RepVm.EmbedVideoPlayers = (bool)(e.Value ?? false)" />
                                @UiStrings.Report_EmbedPlayers
                            </label>
                            @if (RepVm.EmbedVideoPlayers && RepVm.IsMp3Available)
                            {
                                <label style="display: flex; gap: 6px; align-items: center; cursor: pointer;">
                                    <input type="checkbox" checked="@RepVm.HtmlUseMp3" @onchange="e => RepVm.HtmlUseMp3 = (bool)(e.Value ?? false)" />
                                    @UiStrings.Report_UseMp3
                                </label>
                            }
                            @if (RepVm.VideoPlayersEstimateText is { } estimate)
                            {
                                <span class="rp-meta">📦 @estimate</span>
                            }
                        </div>
                    }
                </div>
                <iframe id="rp-frame" class="rp-frame" title="@UiStrings.Report_FrameTitle" srcdoc="@RepVm.CurrentHtml"></iframe>
            }
            else if (!RepVm.IsBusy)
            {
                <div class="rp-empty">
                    <div style="font-size: 34px; margin-bottom: 10px;">📑</div>
                    <p style="font-size: 14px; font-weight: 600; margin-bottom: 8px; color: var(--ss-text);">@UiStrings.Report_EmptyTitle</p>
                    <span style="font-size: 12px; line-height: 1.5; display: block;">
                        @Loc.Format(UiStrings.Report_EmptyHint, ("button", VmStrings.Report_Generate))
                    </span>
                </div>
            }
        </div>
    </div>

    <style>
        .rp-root { flex: 1; display: flex; flex-direction: column; background: var(--ss-panel-light); padding: 20px; height: 100%; min-height: 0; box-sizing: border-box; }
        .rp-toolbar { display: flex; justify-content: space-between; align-items: center; background: var(--ss-surface); padding: 12px 18px; border-radius: 8px; border: 1px solid var(--ss-border-light); flex-wrap: wrap; gap: 12px; }
        .rp-btn { padding: 6px 11px; color: var(--ss-on-accent); border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 12.5px; display: inline-flex; align-items: center; gap: 5px; }
        .rp-btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .rp-link { background: none; border: none; color: var(--ss-link); cursor: pointer; font-size: 12px; padding: 0; }
        .rp-icon { background: none; border: 1px solid transparent; border-radius: 4px; cursor: pointer; font-size: 13px; padding: 2px 5px; }
        .rp-icon:hover { background: var(--ss-hover); border-color: var(--ss-border-light); }
        .rp-info { margin-top: 14px; padding: 14px 20px; background: var(--ss-info-bg); border: 1px solid var(--ss-info-border); border-radius: 8px; text-align: center; color: var(--ss-info-text); }
        .rp-progress { width: 100%; max-width: 480px; height: 6px; background: var(--ss-info-bg-strong); border-radius: 4px; margin: 10px auto 4px auto; overflow: hidden; position: relative; }
        .rp-progress-bar { width: 40%; height: 100%; background: linear-gradient(90deg, var(--ss-primary), var(--ss-primary-hover)); border-radius: 4px; position: absolute; animation: rp-slide 1.4s ease-in-out infinite; }
        @@keyframes rp-slide { 0% { left: -40%; } 100% { left: 100%; } }  /* ss:physisch – Ladebalken läuft immer von links nach rechts */
        .rp-status { margin-top: 12px; padding: 10px 14px; border: 1px solid; border-radius: 6px; font-size: 12px; display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
        .rp-details-raw { margin-top: 4px; max-height: 160px; overflow: auto; padding: 8px; background: var(--ss-raw-bg); border-radius: 4px; font-family: Consolas, "DejaVu Sans Mono", monospace; font-size: 11px; white-space: pre-wrap; word-break: break-word; color: var(--ss-text); }
        .rp-body { flex: 1; min-height: 0; display: flex; gap: 14px; margin-top: 16px; }
        .rp-side { width: 340px; flex-shrink: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
        .rp-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px; min-height: 0; }
        .rp-card { background: var(--ss-surface); border: 1px solid var(--ss-border-light); border-radius: 8px; padding: 14px 16px; }
        .rp-card h4 { margin: 0 0 8px 0; font-size: 14px; color: var(--ss-text); }
        .rp-viewer-head { padding: 10px 14px; }
        .rp-label { font-size: 12px; font-weight: 600; color: var(--ss-text-2); margin: 12px 0 4px 0; display: block; }
        .rp-input { width: 100%; box-sizing: border-box; padding: 6px 8px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 13px; font-family: inherit; }
        .rp-templates { display: flex; flex-direction: column; gap: 6px; }
        .rp-template { display: flex; gap: 10px; align-items: flex-start; text-align: start; padding: 7px 10px; border: 2px solid var(--ss-border-light); border-radius: 6px; background: var(--ss-surface); cursor: pointer; font-size: 13px; color: var(--ss-text); font-family: inherit; }
        .rp-template.active { border-color: var(--ss-primary); background: var(--ss-selected-bg); }
        .rp-template b { display: block; }
        .rp-desc { display: block; font-size: 11.5px; color: var(--ss-text-muted); line-height: 1.35; }
        .rp-check { display: flex; gap: 8px; align-items: center; font-size: 13px; padding: 2px 0; cursor: pointer; }
        .rp-check.inline { display: inline-flex; font-size: 12px; gap: 4px; }
        /* Nicht verfügbar: gedämpfte Textfarbe statt Deckkraft – bleibt in Hell und Dunkel lesbar (≥ 4,5:1) */
        .rp-check.unavailable { color: var(--ss-text-muted); cursor: default; }
        .rp-check.unavailable input { opacity: .55; }
        .rp-meta { font-size: 11px; color: var(--ss-text-muted); }
        .rp-item { display: flex; gap: 8px; align-items: flex-start; padding: 8px 6px; border-radius: 6px; cursor: pointer; border: 1px solid transparent; }
        .rp-item:hover { background: var(--ss-panel-light); }
        .rp-item.active { background: var(--ss-selected-bg); border-color: var(--ss-selected-border); }
        .rp-item-title { font-size: 13px; font-weight: 600; color: var(--ss-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .rp-frame { flex: 1; min-height: 300px; width: 100%; border: 1px solid var(--ss-border-light); border-radius: 8px; background: var(--ss-hover); }
        .rp-empty { margin: auto; text-align: center; color: var(--ss-text-muted); max-width: 480px; background: var(--ss-surface); padding: 30px; border-radius: 8px; border: 1px dashed var(--ss-border); }
    </style>
</div>

@code {
    private string? renameId;
    private string renameText = string.Empty;
    private string? confirmDeleteId;

    private int ActiveDocumentCount => DocVm.Documents.Count(d => d.IsSelected && !d.IsMissing);

    private string ActiveDocumentsText => ActiveDocumentCount == 0
        ? UiStrings.Common_NoActiveDocument
        : Loc.Format(UiStrings.Common_ActiveDocuments, ("count", ActiveDocumentCount));

    /// <summary>Anzahl in der Zahlschreibweise der Oberflächensprache.</summary>
    private static string Number(int value) => value.ToString("N0");

    /// <summary>Kontrollkästchen für eine Einbettung – im Formular (neuer Bericht) oder für den gewählten Bericht.</summary>
    private RenderFragment EmbedCheckbox(string part, string label, bool isChecked, bool available, string? info, bool forNewReport) => @<label class="rp-check @(forNewReport ? "" : "inline") @(available ? "" : "unavailable")"
               title="@(available ? "" : UiStrings.Report_EmbedUnavailable)">
        <input type="checkbox" checked="@(isChecked && available)" disabled="@(!available)" @onchange="() => ToggleEmbedAsync(part, forNewReport)" />
        <span>@label</span>
        @if (info != null)
        {
            <span class="rp-meta">(@info)</span>
        }
    </label>;

    /// <summary>„▶ Video abspielen“ im Video-Abschnitt: App.razor wechselt in den Reiter „Video“ und startet das Video.</summary>
    [Parameter] public EventCallback<string> OnPlayVideo { get; set; }

    private DotNetObjectReference<ReportView>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        try { await JSRuntime.InvokeVoidAsync("studyScopeReport.listen", selfRef); }
        catch (JSException) { /* Skript fehlt – Knopf ohne Wirkung */ }
    }

    [JSInvokable]
    public Task PlayVideoFromReport(string videoId) => InvokeAsync(() => OnPlayVideo.InvokeAsync(videoId));

    protected override async Task OnInitializedAsync()
    {
        RepVm.PropertyChanged += OnVmChanged;
        DocVm.PropertyChanged += OnDocVmChanged;
        DocVm.Documents.CollectionChanged += OnDocumentsChanged;
        await RepVm.LoadForProfileAsync(DocVm.CurrentProfile);
    }

    private void OnVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OnDocumentsChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private async void OnDocVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(DocVm.CurrentProfile))
        {
            renameId = null;
            confirmDeleteId = null;
            await RepVm.LoadForProfileAsync(DocVm.CurrentProfile);
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task GenerateAsync() => RepVm.GenerateAsync(DocVm.Documents);

    private async Task ToggleEmbedAsync(string part, bool forNewReport)
    {
        if (forNewReport)
            RepVm.ToggleNewEmbed(part);
        else
            await RepVm.ToggleEmbedAsync(part);
    }

    private void StartRename(Report report)
    {
        confirmDeleteId = null;
        renameId = report.Id;
        renameText = report.Title;
    }

    private async Task RenameAsync(string reportId)
    {
        if (await RepVm.RenameReportAsync(reportId, renameText))
            renameId = null;
    }

    private async Task RenameKeyAsync(KeyboardEventArgs e, string reportId)
    {
        if (e.Key == "Enter") await RenameAsync(reportId);
        else if (e.Key == "Escape") renameId = null;
    }

    private async Task DeleteAsync(string reportId)
    {
        confirmDeleteId = null;
        await RepVm.DeleteReportAsync(reportId);
    }

    private async Task ExportAsync(ReportExportFormat format)
    {
        try
        {
            var extension = ReportViewModel.Extension(format);
            var path = await DesktopDialogs.SaveFileAsync(
                RepVm.SuggestFileName(format),
                filterExtension: extension,
                filterDescription: ReportViewModel.FormatDescription(format),
                title: UiStrings.Report_SaveAsTitle);

            if (string.IsNullOrWhiteSpace(path))
                return;

            if (!path.EndsWith("." + extension, StringComparison.OrdinalIgnoreCase))
                path += "." + extension;

            await RepVm.ExportAsync(format, path);
        }
        catch (Exception ex)
        {
            RepVm.ShowStatus(Loc.Format(VmStrings.Report_ExportFailed, ("error", ex.Message)), isError: true);
        }
    }

    /// <summary>Druckt den Bericht im Rahmen (eigene Druckansicht: alles aufgeklappt, mit Lösungen).</summary>
    private async Task PrintAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('rp-frame').contentWindow.print()");
        }
        catch (Exception ex)
        {
            RepVm.ShowStatus(Loc.Format(UiStrings.Common_PrintDialogFailed, ("error", ex.Message)), isError: true,
                new[] { Loc.Format(UiStrings.Report_PrintTip, ("button", UiStrings.Report_HtmlButton)) });
        }
    }

    public void Dispose()
    {
        _ = JSRuntime.InvokeVoidAsync("studyScopeReport.stop").AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
        selfRef?.Dispose();
        RepVm.PropertyChanged -= OnVmChanged;
        DocVm.PropertyChanged -= OnDocVmChanged;
        DocVm.Documents.CollectionChanged -= OnDocumentsChanged;
    }
}

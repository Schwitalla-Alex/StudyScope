@using Microsoft.JSInterop
@using Photino.NET
@using StudyScope.UI.Services
@inject DocumentListViewModel DocVm
@inject SettingsViewModel SettingsVm
@inject IJSRuntime Js

<div style="background: #e9ecef; border-bottom: 1px solid #ced4da; padding: 2px 10px; display: flex; gap: 15px; font-size: 13px; user-select: none; position: relative;">

    <!-- Menüpunkt Datei mit Dropdown -->
    <div style="position: relative;">
        <span style="cursor: pointer; padding: 4px 8px; display: inline-block; border-radius: 3px;"
              class="menu-item"
              @onclick="ToggleFileMenu">
            Datei ▾
        </span>

        @if (isFileMenuOpen)
        {
            <!-- Klick-Fänger zum Schließen bei Klick außerhalb -->
            <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 998;"
                 @onclick="CloseMenu"></div>

            <div style="position: absolute; top: 100%; left: 0; background: #fff; border: 1px solid #ced4da; box-shadow: 0 4px 10px rgba(0,0,0,0.15); border-radius: 4px; min-width: 180px; z-index: 999; display: flex; flex-direction: column; padding: 4px 0;">

                <button class="dropdown-entry" @onclick="HandleOpenFileAsync">
                    📂 Datei öffnen...
                </button>

                <button class="dropdown-entry" @onclick="OpenNewProfileDialog">
                    ➕ Neues Profil anlegen...
                </button>

                <div style="height: 1px; background: #e9ecef; margin: 4px 0;"></div>

                <button class="dropdown-entry" style="color: #dc3545;" @onclick="HandleCloseApp">
                    ✕ Anwendung schließen
                </button>
            </div>
        }
    </div>

    <!-- Menüpunkt Einstellungen -->
   @*  <span style="cursor: pointer; padding: 4px 8px;" @onclick="() => OnOpenSettings.InvokeAsync()">
        Einstellungen
    </span> *@
    <!-- Menüpunkt Einstellungen -->
    <span style="cursor: pointer; padding: 4px 8px;" @onclick="HandleOpenSettingsAsync">
        Einstellungen
    </span>
    <!-- Menüpunkt Hilfe -->
   <span style="cursor: pointer; padding: 4px 8px;" @onclick="ShowAboutAsync">
        Hilfe
    </span> 
</div>

<!-- Kleines Dialog-Modal für neues Profil -->
@if (showProfileModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 2000;">
        <div style="background: white; border-radius: 6px; width: 340px; padding: 18px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
            <h4 style="margin: 0 0 10px 0; font-size: 14px; color: #212529;">Neues Profil anlegen</h4>
            <p style="font-size: 12px; color: #6c757d; margin: 0 0 10px 0;">Geben Sie einen Namen für das neue Themengebiet ein:</p>

            <input type="text" placeholder="z. B. BGB, Steuerrecht, Physik..."
                   style="width: 100%; padding: 7px 10px; border: 1px solid #ced4da; border-radius: 4px; font-size: 13px; box-sizing: border-box; margin-bottom: 14px;"
                   @bind="newProfileInput"
                   @onkeyup="@(async (e) => { if (e.Key == "Enter") await ConfirmCreateProfileAsync(); })" />

            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <button style="padding: 5px 12px; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px;"
                        @onclick="() => { showProfileModal = false; newProfileInput = string.Empty; }">
                    Abbrechen
                </button>
                <button style="padding: 5px 14px; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: bold;"
                        @onclick="ConfirmCreateProfileAsync">
                    Erstellen
                </button>
            </div>
        </div>
    </div>
}

<style>
    .menu-item:hover {
        background-color: #dee2e6;
    }

    .dropdown-entry {
        background: none;
        border: none;
        text-align: left;
        padding: 7px 14px;
        font-size: 13px;
        cursor: pointer;
        width: 100%;
        display: block;
    }

        .dropdown-entry:hover {
            background-color: #f1f3f5;
        }
</style>

@code {
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public EventCallback OnShowAboutAsync { get; set; }
    
    private bool isFileMenuOpen = false;
    private bool showProfileModal = false;
    private string newProfileInput = string.Empty;

    private void ToggleFileMenu() => isFileMenuOpen = !isFileMenuOpen;
    private void CloseMenu() => isFileMenuOpen = false;

    private async Task HandleOpenFileAsync()
    {
        CloseMenu();
        var selectedFilePath = await DesktopDialogs.OpenPdfAsync();
        if (!string.IsNullOrWhiteSpace(selectedFilePath))
        {
            await DocVm.AddDocumentAsync(selectedFilePath);
        }
    }

    private void OpenNewProfileDialog()
    {
        CloseMenu();
        newProfileInput = string.Empty;
        showProfileModal = true;
    }

    private async Task ConfirmCreateProfileAsync()
    {
        if (!string.IsNullOrWhiteSpace(newProfileInput))
        {
            await DocVm.CreateNewProfileAsync(newProfileInput.Trim());
            SettingsVm.ResetForm(); // Maske leeren
            showProfileModal = false;
            newProfileInput = string.Empty;
            StateHasChanged(); // UI sofort neu rendern
        }
    }

    private void HandleCloseApp()
    {
        CloseMenu();
        DesktopDialogs.MainWindow?.Close();
    }

    private async Task ShowAboutAsync()
    {
        if (OnShowAboutAsync.HasDelegate)
        {
            await OnShowAboutAsync.InvokeAsync();
        }
    }

    private async Task HandleOpenSettingsAsync()
    {
        // Lädt die KI-Daten des aktuell gewählten Profils in die Maske
        await SettingsVm.InitializeAsync();
        await OnOpenSettings.InvokeAsync();
    }
}


@using StudyScope.Core.Models
@using StudyScope.ViewModels
@inject SpeechSettingsViewModel SpeechVm
@implements IDisposable

<div style="display: flex; flex-direction: column; gap: 14px;">
    <div style="font-size: 12px; color: var(--ss-text-2); line-height: 1.5;">
        Gemini TTS erzeugt aus dem Sprechskript eine Audiodatei (WAV), beim Podcast mit zwei Stimmen. Das Skript selbst schreibt weiterhin
        die KI aus „🤖 KI-Modell“ – auch eine lokale KI. Welche Sprachausgabe verwendet wird, wählen Sie im Reiter „🎧 Audio“.
    </div>

    <div>
        <label class="ss-label">1. Gemini-API-Schlüssel für die Sprachausgabe:</label>
        <input type="password" class="ss-input" placeholder="@(SpeechVm.ChatProvidesGeminiKey ? "nicht nötig – Schlüssel der Chat-KI wird verwendet" : "API-Schlüssel aus Google AI Studio …")"
               @bind="SpeechVm.GeminiApiKey" @bind:event="oninput" />
        <div class="ss-hint">@SpeechVm.KeySourceText</div>
    </div>

    <div>
        <label class="ss-label">2. Modell:</label>
        <div style="display: flex; gap: 6px;">
            <input type="text" class="ss-input" style="flex: 1;" @bind="SpeechVm.GeminiModel" @bind:event="oninput" />
            <button type="button" class="ss-btn" style="background: var(--ss-secondary);" title="Standardmodell eintragen" @onclick="SpeechVm.ResetModel">Standard</button>
        </div>
        <div class="ss-hint">Standard: <code>@GeminiTtsInfo.DefaultModel</code>. Ändern Sie den Namen nur, wenn Google das Modell umbenennt.</div>
    </div>

    <div>
        <label class="ss-label">3. Stimmen:</label>
        <div style="display: flex; gap: 10px;">
            <label style="flex: 1; font-size: 12px; color: var(--ss-text-2);">Sprecherin / Moderatorin
                <select class="ss-input" @bind="SpeechVm.VoicePrimary">
                    @foreach (var voice in SpeechVm.Voices)
                    {
                        <option value="@voice">@SpeechSettingsViewModel.VoiceLabel(voice)</option>
                    }
                </select>
            </label>
            <label style="flex: 1; font-size: 12px; color: var(--ss-text-2);">Experte (Podcast)
                <select class="ss-input" @bind="SpeechVm.VoiceSecondary">
                    @foreach (var voice in SpeechVm.Voices)
                    {
                        <option value="@voice">@SpeechSettingsViewModel.VoiceLabel(voice)</option>
                    }
                </select>
            </label>
        </div>
    </div>

    <div style="font-size: 11.5px; padding: 7px 10px; border-radius: 4px; background: var(--ss-hover); color: var(--ss-text-2); border: 1px solid var(--ss-border-light);">
        🔒 @SpeechVm.PrivacyHint
    </div>

    @if (!string.IsNullOrEmpty(SpeechVm.StatusMessage))
    {
        <div style="font-size: 12px; padding: 7px 10px; border-radius: 4px; background: @(SpeechVm.IsSuccess ? "var(--ss-success-bg)" : "var(--ss-danger-bg)"); color: @(SpeechVm.IsSuccess ? "var(--ss-success-text)" : "var(--ss-danger-text)"); border: 1px solid @(SpeechVm.IsSuccess ? "var(--ss-success-border)" : "var(--ss-danger-border)");">
            @SpeechVm.StatusMessage
        </div>
    }
</div>

<div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: center; gap: 8px;">
    <button type="button" class="ss-btn" style="background: var(--ss-info);" disabled="@(!SpeechVm.CanTestConnection)"
            title="Prüft Schlüssel und Modell über die kostenlose Modellabfrage – es wird keine Sprache erzeugt"
            @onclick="SpeechVm.TestConnectionAsync">
        @(SpeechVm.IsTesting ? "Prüfe …" : "🔌 Verbindung testen")
    </button>
    <div style="display: flex; gap: 8px;">
        <button type="button" class="ss-btn" style="background: var(--ss-secondary); font-weight: normal;" @onclick="() => OnClose.InvokeAsync()">Schließen</button>
        <button type="button" class="ss-btn" style="background: var(--ss-primary);" @onclick="SaveAsync">Speichern</button>
    </div>
</div>

<style>
    .ss-label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: var(--ss-text-2); }
    .ss-input { width: 100%; padding: 7px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 13px; box-sizing: border-box; background: var(--ss-surface); margin-top: 3px; }
    .ss-hint { font-size: 11.5px; color: var(--ss-text-muted); margin-top: 4px; line-height: 1.4; }
    .ss-btn { padding: 7px 14px; color: var(--ss-on-accent); border: none; border-radius: 4px; cursor: pointer; font-size: 13px; font-weight: bold; white-space: nowrap; }
    .ss-btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnInitializedAsync()
    {
        SpeechVm.PropertyChanged += OnChanged;
        await SpeechVm.InitializeAsync();
    }

    private void OnChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private async Task SaveAsync()
    {
        if (await SpeechVm.SaveAsync())
            await OnClose.InvokeAsync();
    }

    public void Dispose() => SpeechVm.PropertyChanged -= OnChanged;
}

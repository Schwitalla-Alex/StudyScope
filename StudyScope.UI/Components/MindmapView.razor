@using System.Globalization
@using Microsoft.JSInterop
@using StudyScope.UI.Services
@using StudyScope.ViewModels.Mindmap
@inject MindmapViewModel MapVm
@inject DocumentListViewModel DocVm
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="mm-root">

    <!-- Obere Steuerleiste -->
    <div class="mm-toolbar">
        <div>
            <h3 style="margin: 0; font-size: 16px; color: var(--ss-text);">@Loc.Format(UiStrings.Mindmap_Title, ("name", DocVm.CurrentProfileDisplayName))</h3>
            <span style="font-size: 12px; color: var(--ss-text-muted);">
                @(MapVm.HasMindmap ? MapVm.SourceInfoText : UiStrings.Mindmap_NoneForProfile)
            </span>
        </div>

        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            @if (MapVm.IsGenerating)
            {
                <button type="button" class="mm-btn" style="background: var(--ss-secondary);" @onclick="MapVm.CancelGeneration">
                    <span class="mm-spinner"></span> @UiStrings.Common_Cancel
                </button>
            }
            else
            {
                <button type="button" class="mm-btn" style="background: var(--ss-primary);"
                        title="@UiStrings.Mindmap_CreateTitle"
                        @onclick="GenerateAsync">
                    ✨ @(MapVm.HasMindmap ? VmStrings.Common_Regenerate : VmStrings.Mindmap_Create)
                </button>
            }

            @if (MapVm.HasMindmap && !MapVm.IsGenerating)
            {
                <span class="mm-group">
                    <button type="button" class="mm-btn-outline" title="@UiStrings.Mindmap_ExpandAllTitle" @onclick="MapVm.ExpandAll">@UiStrings.Mindmap_ExpandAll</button>
                    <button type="button" class="mm-btn-outline" title="@UiStrings.Mindmap_CollapseAllTitle" @onclick="MapVm.CollapseAll">@UiStrings.Mindmap_CollapseAll</button>
                </span>

                <span class="mm-group">
                    <button type="button" class="mm-btn-outline" title="@UiStrings.Mindmap_ZoomOut" aria-label="@UiStrings.Mindmap_ZoomOut" disabled="@(MapVm.Zoom <= MindmapViewModel.MinZoom)" @onclick="MapVm.ZoomOut">−</button>
                    <button type="button" class="mm-btn-outline" title="@UiStrings.Mindmap_ZoomReset" style="min-width: 62px;" @onclick="MapVm.ResetZoom">@MapVm.ZoomText</button>
                    <button type="button" class="mm-btn-outline" title="@UiStrings.Mindmap_ZoomIn" aria-label="@UiStrings.Mindmap_ZoomIn" disabled="@(MapVm.Zoom >= MindmapViewModel.MaxZoom)" @onclick="MapVm.ZoomIn">+</button>
                </span>

                <button type="button" class="mm-btn" style="background: var(--ss-secondary);"
                        title="@UiStrings.Mindmap_PrintTitle"
                        @onclick="PrintAsync">@UiStrings.Common_PrintPdf</button>
                <button type="button" class="mm-btn" style="background: var(--ss-info);" title="@UiStrings.Mindmap_ExportTitle" @onclick="ExportMarkdownAsync">@UiStrings.Common_ExportMd</button>
                <button type="button" class="mm-btn" style="background: var(--ss-danger);" title="@UiStrings.Mindmap_DeleteTitle" @onclick="DeleteAsync">🗑️ @UiStrings.Common_Delete</button>
            }
        </div>
    </div>

    @if (MapVm.IsGenerating)
    {
        <div class="mm-info">
            <div style="font-weight: 600; font-size: 13px; margin-bottom: 4px;">@UiStrings.Mindmap_GeneratingInfo</div>
            <div class="mm-progress"><div class="mm-progress-bar"></div></div>
            <div style="font-size: 11px; margin-top: 6px; color: var(--ss-text-muted);">@UiStrings.Common_GenerationWait</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(MapVm.StatusMessage))
    {
        var (statusBg, statusBorder, statusText) = MapVm.IsError
            ? ("var(--ss-danger-bg)", "var(--ss-danger-border)", "var(--ss-danger-text)")
            : MapVm.IsWarning ? ("var(--ss-warning-bg)", "var(--ss-warning-border)", "var(--ss-warning-text)") : ("var(--ss-success-bg)", "var(--ss-success-border)", "var(--ss-success-text)");

        <div class="mm-status" style="background: @statusBg; border-color: @statusBorder; color: @statusText;">
            <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 600;">@MapVm.StatusMessage</div>

                @if (MapVm.StatusTips.Count > 0)
                {
                    <div style="margin-top: 6px;">@(MapVm.IsError ? UiStrings.Common_WhatYouCanDo : UiStrings.Common_Tip)</div>
                    <ul style="margin-block: 2px 0; margin-inline: 18px 0; line-height: 1.5;">
                        @foreach (var tip in MapVm.StatusTips)
                        {
                            <li>@tip</li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrEmpty(MapVm.StatusDetails))
                {
                    <details style="margin-top: 6px;">
                        <summary style="cursor: pointer; font-size: 11px; opacity: 0.85;">@UiStrings.Common_TechnicalDetailsAi</summary>
                        <pre class="mm-details-raw">@MapVm.StatusDetails</pre>
                    </details>
                }
            </div>
            <button style="background: none; border: none; cursor: pointer; color: inherit; font-weight: bold; font-size: 14px; align-self: flex-start;" title="@UiStrings.Common_Dismiss" aria-label="@UiStrings.Common_Dismiss" @onclick="MapVm.ClearStatus">✕</button>
        </div>
    }

    <!-- Arbeitsbereich: Zeichenfläche + Detailspalte -->
    <div class="mm-body">
        @if (!MapVm.HasMindmap && !MapVm.IsGenerating)
        {
            <div class="mm-empty">
                <div style="font-size: 34px; margin-bottom: 10px;">🧠</div>
                <p style="font-size: 14px; font-weight: 600; margin-bottom: 8px; color: var(--ss-text);">@UiStrings.Mindmap_Empty</p>
                <span style="font-size: 12px; line-height: 1.4; display: block;">
                    @Loc.Format(UiStrings.Mindmap_EmptyHint, ("button", VmStrings.Mindmap_Create))
                </span>
            </div>
        }
        else if (MapVm.HasMindmap)
        {
            var layout = MapVm.Layout;
            <div class="mm-canvas" @onclick="() => MapVm.SelectNode(null)">
                <!-- Kopfzeile nur für Druck/PDF -->
                <div class="mm-print-header">
                    <div style="font-size: 16pt; font-weight: 600;">@Loc.Format(UiStrings.Mindmap_Title, ("name", MapVm.Mindmap!.Root.Title))</div>
                    <div style="font-size: 9pt; color: var(--ss-text-muted);">@Loc.Format(UiStrings.Mindmap_PrintSource, ("source", MapVm.SourceInfoText), ("profile", DocVm.CurrentProfileDisplayName))</div>
                </div>
                <svg width="@F(layout.Width * MapVm.Zoom)" height="@F(layout.Height * MapVm.Zoom)"
                     viewBox="0 0 @F(layout.Width) @F(layout.Height)" xmlns="http://www.w3.org/2000/svg">

                    <!-- Verbindungslinien (unter den Knoten) -->
                    @foreach (var edge in layout.Edges)
                    {
                        var midX = (edge.FromX + edge.ToX) / 2;
                        <path d="M @F(edge.FromX + ToggleRadius * 2) @F(edge.FromY) C @F(midX) @F(edge.FromY), @F(midX) @F(edge.ToY), @F(edge.ToX) @F(edge.ToY)"
                              fill="none" style="stroke: @BranchColor(edge.BranchIndex);" stroke-width="2" stroke-opacity="0.55" />
                    }

                    <!-- Knoten -->
                    @foreach (var item in layout.Nodes)
                    {
                        var node = item.Node;
                        var color = BranchColor(item.BranchIndex);
                        var isRoot = item.Depth == 0;
                        var isSelected = MapVm.SelectedNode?.Id == node.Id;

                        <g class="mm-node" @onclick="() => MapVm.SelectNode(node.Id)" @onclick:stopPropagation="true"
                           @ondblclick="() => MapVm.ToggleNode(node.Id)">
                            <title>@Tooltip(node)</title>
                            <rect x="@F(item.X)" y="@F(item.Y)" width="@F(item.Width)" height="@F(item.Height)" rx="10" ry="10"
                                  style="fill: @(isRoot ? "var(--ss-mm-root)" : Tint(item.BranchIndex)); stroke: @(isSelected ? "var(--ss-text)" : (isRoot ? "var(--ss-mm-root)" : color));"
                                  stroke-width="@(isSelected ? "2.5" : "1.5")" />
                            <text x="@F(item.X + 14)" y="@F(item.CenterY)" dominant-baseline="central"
                                  font-size="13" font-weight="@(item.Depth <= 1 ? "600" : "400")"
                                  style="fill: @(isRoot ? "var(--ss-on-accent)" : "var(--ss-text)");">@item.DisplayTitle</text>
                        </g>

                        @if (item.HasChildren)
                        {
                            <g class="mm-toggle" @onclick="() => MapVm.ToggleNode(node.Id)" @onclick:stopPropagation="true">
                                <title>@(item.IsExpanded ? UiStrings.Mindmap_Collapse : Loc.Format(UiStrings.Mindmap_ExpandChildren, ("count", node.Children.Count)))</title>
                                <circle cx="@F(item.Right + ToggleRadius)" cy="@F(item.CenterY)" r="@F(ToggleRadius)"
                                        style="fill: var(--ss-surface); stroke: @(isRoot ? "var(--ss-mm-root)" : color);" stroke-width="1.5" />
                                <text x="@F(item.Right + ToggleRadius)" y="@F(item.CenterY)" text-anchor="middle" dominant-baseline="central"
                                      font-size="@(item.IsExpanded ? "13" : "10")" font-weight="700" style="fill: @(isRoot ? "var(--ss-mm-root)" : color);">
                                    @(item.IsExpanded ? "‹" : node.Children.Count.ToString())
                                </text>
                            </g>
                        }
                    }
                </svg>
            </div>

            @if (MapVm.SelectedNode is { } selected)
            {
                <aside class="mm-details">
                    <div style="font-size: 11px; color: var(--ss-text-muted); margin-bottom: 6px; line-height: 1.4;">
                        @string.Join(" › ", MapVm.SelectedPath.Select(n => n.Title))
                    </div>
                    <h4 style="margin: 0 0 8px 0; font-size: 15px; color: var(--ss-text);">@selected.Title</h4>
                    <p style="font-size: 13px; line-height: 1.5; color: var(--ss-text); white-space: pre-wrap;">
                        @(string.IsNullOrWhiteSpace(selected.Summary) ? UiStrings.Mindmap_NoSummary : selected.Summary)
                    </p>

                    @if (selected.Children.Count > 0)
                    {
                        <div style="font-size: 12px; color: var(--ss-text-muted); margin-top: 12px;">@UiStrings.Mindmap_Subtopics</div>
                        <ul style="margin-block: 4px 0; margin-inline: 18px 0; font-size: 12px; color: var(--ss-text); line-height: 1.6;">
                            @foreach (var child in selected.Children)
                            {
                                <li><a href="javascript:void(0)" style="color: var(--ss-link); text-decoration: none;" @onclick="() => MapVm.SelectNode(child.Id)">@child.Title</a></li>
                            }
                        </ul>
                    }

                    <button type="button" class="mm-btn" style="background: var(--ss-success); width: 100%; margin-top: 16px; justify-content: center;"
                            title="@UiStrings.Mindmap_AskInChatTitle"
                            @onclick="() => AskInChatAsync(selected)">
                        @UiStrings.Mindmap_AskInChat
                    </button>
                    <div style="font-size: 11px; color: var(--ss-text-muted); margin-top: 10px; line-height: 1.4;">
                        @UiStrings.Mindmap_DoubleClickTip
                    </div>
                </aside>
            }
        }
    </div>

    <style>
        @TintCss
        .mm-root { flex: 1; display: flex; flex-direction: column; background: var(--ss-panel-light); padding: 20px; height: 100%; min-height: 0; box-sizing: border-box; overflow-y: auto; }
        .mm-toolbar { display: flex; justify-content: space-between; align-items: center; background: var(--ss-surface); padding: 12px 18px; border-radius: 8px; border: 1px solid var(--ss-border-light); flex-wrap: wrap; gap: 12px; }
        .mm-group { display: inline-flex; gap: 2px; }
        .mm-btn { padding: 7px 12px; color: var(--ss-on-accent); border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; }
        .mm-btn-outline { padding: 6px 10px; background: var(--ss-surface); color: var(--ss-text-2); border: 1px solid var(--ss-border); border-radius: 4px; font-weight: 600; cursor: pointer; font-size: 13px; }
        .mm-btn-outline:hover:not(:disabled) { background: var(--ss-hover); }
        .mm-btn-outline:disabled { opacity: 0.45; cursor: not-allowed; }
        .mm-info { margin-top: 14px; padding: 14px 20px; background: var(--ss-info-bg); border: 1px solid var(--ss-info-border); border-radius: 8px; text-align: center; color: var(--ss-info-text); }
        .mm-status { margin-top: 12px; padding: 10px 14px; border: 1px solid; border-radius: 6px; font-size: 12px; display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
        .mm-details-raw { margin-top: 4px; max-height: 160px; overflow: auto; padding: 8px; background: var(--ss-raw-bg); border-radius: 4px; font-family: Consolas, "DejaVu Sans Mono", monospace; font-size: 11px; white-space: pre-wrap; word-break: break-word; color: var(--ss-text); }
        .mm-body { flex: 1; min-height: 320px; /* Zeichenfläche bleibt auch bei Statusmeldung und kleinem Fenster nutzbar */ display: flex; gap: 14px; margin-top: 16px; }
        .mm-canvas { flex: 1; min-width: 0; overflow: auto; background: var(--ss-surface); border: 1px solid var(--ss-border-light); border-radius: 8px; }
        .mm-canvas svg { display: block; user-select: none; }
        .mm-node { cursor: pointer; }
        .mm-node:hover rect { filter: brightness(0.96); }
        .mm-toggle { cursor: pointer; }
        .mm-toggle:hover circle { fill: var(--ss-hover) !important; }
        .mm-details { width: 300px; flex-shrink: 0; overflow-y: auto; background: var(--ss-surface); border: 1px solid var(--ss-border-light); border-radius: 8px; padding: 16px; }
        .mm-empty { margin: auto; text-align: center; color: var(--ss-text-muted); max-width: 440px; background: var(--ss-surface); padding: 30px; border-radius: 8px; border: 1px dashed var(--ss-border); }
        .mm-spinner { display: inline-block; width: 13px; height: 13px; border: 2px solid rgba(255,255,255,0.35); border-radius: 50%; border-top-color: var(--ss-on-accent); animation: mm-spin 0.8s linear infinite; }  /* ss:feste-farbe – Ladekreis auf farbigem Knopf */
        @@keyframes mm-spin { to { transform: rotate(360deg); } }
        .mm-progress { width: 100%; max-width: 480px; height: 6px; background: var(--ss-info-bg-strong); border-radius: 4px; margin: 10px auto 4px auto; overflow: hidden; position: relative; }
        .mm-progress-bar { width: 40%; height: 100%; background: linear-gradient(90deg, var(--ss-primary), var(--ss-primary-hover)); border-radius: 4px; position: absolute; animation: mm-slide 1.4s ease-in-out infinite; }
        @@keyframes mm-slide { 0% { left: -40%; } 100% { left: 100%; } }  /* ss:physisch – Ladebalken läuft immer von links nach rechts */
        .mm-print-header { display: none; }

        /* Druck / PDF: nur die Mindmap als Grafik, auf eine A4-Seite quer eingepasst */
        @@media print {
            @@page { size: A4 landscape; margin: 12mm; }
            body * { visibility: hidden; }
            .mm-canvas, .mm-canvas * { visibility: visible; }
            .mm-canvas { position: absolute; left: 0; top: 0;  /* ss:physisch – Druckseite */ width: 100%; overflow: visible !important; border: none !important; border-radius: 0; }
            .mm-print-header { display: block; margin-bottom: 6mm; }
            .mm-root { overflow: visible !important; }
            .mm-canvas svg {
                width: 100% !important;
                height: auto !important;
                max-height: 160mm;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</div>

@code {
    /// <summary>Wird ausgelöst, wenn zu einem Thema eine Frage im Chat gestellt werden soll.</summary>
    [Parameter] public EventCallback<string> OnAskQuestion { get; set; }

    private const double ToggleRadius = 10;

    // Farben der Hauptäste (Rand/Linie) und passende helle Füllung. Beide Paletten gelten für Hell und Dunkel;
    // im Dunkelmodus entsteht die Füllung aus Astfarbe und dunkler Fläche (TintCss). Druck: immer die helle Füllung.
    private static readonly string[] BranchColors = { "#4c6ef5", "#12b886", "#f76707", "#ae3ec9", "#e64980", "#2f9e44", "#e8a900", "#1c7ed6" };  // ss:feste-farbe
    private static readonly string[] BranchTints = { "#edf2ff", "#e6fcf5", "#fff4e6", "#f8f0fc", "#fff0f6", "#ebfbee", "#fff9db", "#e7f5ff" };  // ss:feste-farbe

    private static string BranchColor(int index) => index < 0 ? "var(--ss-mm-root)" : BranchColors[index % BranchColors.Length];
    private static string Tint(int index) => index < 0 ? "var(--ss-hover)" : $"var(--mm-tint-{index % BranchTints.Length})";

    /// <summary>Füllungen je Ast als CSS-Variablen: hell aus <see cref="BranchTints"/>, dunkel per color-mix (nur am Bildschirm).</summary>
    private static readonly string TintCss =
        ".mm-canvas { " + string.Concat(BranchTints.Select((t, i) => $"--mm-tint-{i}: {t}; ")) + "} " +
        "@media screen { :root[data-theme-effective='dark'] .mm-canvas { " +
        string.Concat(BranchColors.Select((c, i) => $"--mm-tint-{i}: color-mix(in srgb, {c} 24%, var(--ss-surface)); ")) + "} }";

    /// <summary>SVG-Zahlen immer mit Punkt als Dezimaltrenner (deutsche Kultur würde ein Komma schreiben).</summary>
    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Tooltip(MindmapNode node) =>
        string.IsNullOrWhiteSpace(node.Summary) ? node.Title : $"{node.Title}\n{node.Summary}";

    protected override async Task OnInitializedAsync()
    {
        MapVm.PropertyChanged += OnMapVmChanged;
        DocVm.PropertyChanged += OnDocVmChanged;
        await MapVm.LoadForProfileAsync(DocVm.CurrentProfile);
    }

    private void OnMapVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private async void OnDocVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(DocVm.CurrentProfile))
        {
            await MapVm.LoadForProfileAsync(DocVm.CurrentProfile);
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task GenerateAsync() => MapVm.GenerateAsync(DocVm.CurrentProfile, DocVm.Documents);

    private Task DeleteAsync() => MapVm.DeleteAsync(DocVm.CurrentProfile);

    private async Task AskInChatAsync(MindmapNode node)
    {
        await OnAskQuestion.InvokeAsync(MapVm.BuildQuestionFor(node));
    }

    /// <summary>
    /// Öffnet den Druckdialog des Systems. Dort lässt sich die Mindmap drucken oder als PDF speichern
    /// („Als PDF speichern“ / „Microsoft Print to PDF“, unter Linux „In Datei drucken“).
    /// </summary>
    private async Task PrintAsync()
    {
        // Auswahlrahmen soll nicht mitgedruckt werden
        MapVm.SelectNode(null);
        StateHasChanged();
        await Task.Yield();

        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            MapVm.ShowStatus(Loc.Format(UiStrings.Common_PrintDialogFailed, ("error", ex.Message)), isError: true);
        }
    }

    private async Task ExportMarkdownAsync()
    {
        try
        {
            var path = await DesktopDialogs.SaveFileAsync(
                Loc.Format(UiStrings.Mindmap_ExportFileName, ("profile", DocVm.CurrentProfileDisplayName), ("stamp", DateTime.Now.ToString("yyyyMMdd_HHmm"))),
                filterExtension: "md",
                title: UiStrings.Mindmap_ExportDialogTitle);

            if (string.IsNullOrWhiteSpace(path))
                return;

            await File.WriteAllTextAsync(path, MapVm.GetMarkdownExport());
            MapVm.ShowStatus(Loc.Format(UiStrings.Common_Exported, ("file", Path.GetFileName(path))), isError: false);
        }
        catch (Exception ex)
        {
            MapVm.ShowStatus(Loc.Format(UiStrings.Common_ExportFailed, ("error", ex.Message)), isError: true);
        }
    }

    public void Dispose()
    {
        MapVm.PropertyChanged -= OnMapVmChanged;
        DocVm.PropertyChanged -= OnDocVmChanged;
    }
}

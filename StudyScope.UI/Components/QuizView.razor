@using StudyScope.ViewModels.Quiz
@inject QuizViewModel QuizVm
@inject DocumentListViewModel DocVm
@implements IDisposable

<div class="qz-root" tabindex="0" @ref="rootRef" @onkeydown="HandleKey">

    <!-- Kopfzeile -->
    <div class="qz-toolbar">
        <div>
            <h3 style="margin: 0; font-size: 16px; color: var(--ss-text);">@Loc.Format(UiStrings.Quiz_Title, ("profile", DocVm.CurrentProfileDisplayName))</h3>
            <span style="font-size: 12px; color: var(--ss-text-muted);">
                @(QuizVm.Topics.Count == 0
                    ? UiStrings.Quiz_NoTopicsYet
                    : Loc.Format(UiStrings.Quiz_Summary, ("topics", QuizVm.Topics.Count), ("questions", QuizVm.Topics.Sum(t => t.Questions.Count)), ("runs", QuizVm.History.Count)))
            </span>
        </div>
        @if (QuizVm.Screen == QuizScreen.Library && !QuizVm.IsBusy)
        {
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <button type="button" class="qz-btn" style="background: var(--ss-primary);" title="@UiStrings.Quiz_NewTopicTitle" @onclick="OpenNewTopic">@VmStrings.Quiz_NewTopic</button>
                <button type="button" class="qz-btn" style="background: var(--ss-purple);" title="@UiStrings.Quiz_SuggestTitle" @onclick="SuggestAsync">@VmStrings.Quiz_SuggestTopics</button>
            </div>
        }
    </div>

    @if (QuizVm.IsBusy)
    {
        <div class="qz-info">
            <div style="font-weight: 600; font-size: 13px;">@QuizVm.ProgressText</div>
            <div class="qz-progress"><div class="qz-progress-fill" style="width: @Css(Math.Max(4, QuizVm.ProgressPercent))%;"></div></div>
            <div style="display: flex; justify-content: center; gap: 10px; align-items: center; margin-top: 6px;">
                <span style="font-size: 11px; color: var(--ss-text-muted);">@UiStrings.Quiz_BusyHint</span>
                <button type="button" class="qz-btn" style="background: var(--ss-secondary); padding: 4px 10px;" @onclick="QuizVm.Cancel">@UiStrings.Common_Cancel</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(QuizVm.StatusMessage))
    {
        var (statusBg, statusBorder, statusText) = QuizVm.IsError
            ? ("var(--ss-danger-bg)", "var(--ss-danger-border)", "var(--ss-danger-text)")
            : QuizVm.IsWarning ? ("var(--ss-warning-bg)", "var(--ss-warning-border)", "var(--ss-warning-text)") : ("var(--ss-success-bg)", "var(--ss-success-border)", "var(--ss-success-text)");

        <div class="qz-status" style="background: @statusBg; border-color: @statusBorder; color: @statusText;">
            <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 600;">@QuizVm.StatusMessage</div>
                @if (QuizVm.StatusTips.Count > 0)
                {
                    <ul style="margin-block: 4px 0; margin-inline: 18px 0; line-height: 1.5;">
                        @foreach (var tip in QuizVm.StatusTips)
                        {
                            <li>@tip</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrEmpty(QuizVm.StatusDetails))
                {
                    <details style="margin-top: 6px;">
                        <summary style="cursor: pointer; font-size: 11px; opacity: 0.85;">@UiStrings.Common_TechnicalDetailsAi</summary>
                        <pre class="qz-details-raw">@QuizVm.StatusDetails</pre>
                    </details>
                }
            </div>
            <button style="background: none; border: none; cursor: pointer; color: inherit; font-weight: bold; font-size: 14px; align-self: flex-start;" title="@UiStrings.Common_Dismiss" aria-label="@UiStrings.Common_Dismiss" @onclick="QuizVm.ClearStatus">✕</button>
        </div>
    }

    <div class="qz-body">
        @if (QuizVm.Screen == QuizScreen.Running)
        {
            @RenderRunning()
        }
        else if (QuizVm.Screen == QuizScreen.Result)
        {
            @RenderResult()
        }
        else
        {
            @RenderLibrary()
        }
    </div>

    <style>
        .qz-root { flex: 1; display: flex; flex-direction: column; background: var(--ss-panel-light); padding: 20px; height: 100%; min-height: 0; box-sizing: border-box; outline: none; }
        .qz-toolbar { display: flex; justify-content: space-between; align-items: center; background: var(--ss-surface); padding: 12px 18px; border-radius: 8px; border: 1px solid var(--ss-border-light); flex-wrap: wrap; gap: 12px; }
        .qz-btn { padding: 7px 12px; color: var(--ss-on-accent); border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; }
        .qz-btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .qz-btn-outline { padding: 6px 12px; background: var(--ss-surface); color: var(--ss-text-2); border: 1px solid var(--ss-border); border-radius: 4px; font-weight: 600; cursor: pointer; font-size: 13px; }
        .qz-btn-outline:hover:not(:disabled) { background: var(--ss-hover); }
        .qz-btn-outline:disabled { opacity: 0.45; cursor: not-allowed; }
        .qz-icon-btn { background: none; border: 1px solid transparent; border-radius: 4px; cursor: pointer; font-size: 14px; padding: 2px 6px; }
        .qz-icon-btn:hover { background: var(--ss-hover); border-color: var(--ss-border-light); }
        .qz-link { background: none; border: none; color: var(--ss-link); cursor: pointer; font-size: 12px; padding: 0; }
        .qz-info { margin-top: 14px; padding: 14px 20px; background: var(--ss-info-bg); border: 1px solid var(--ss-info-border); border-radius: 8px; text-align: center; color: var(--ss-info-text); }
        .qz-progress { width: 100%; max-width: 520px; height: 8px; background: var(--ss-info-bg-strong); border-radius: 4px; margin: 10px auto 4px auto; overflow: hidden; }
        .qz-progress-fill { height: 100%; background: linear-gradient(90deg, var(--ss-primary), var(--ss-primary-hover)); border-radius: 4px; transition: width 0.3s; }
        .qz-status { margin-top: 12px; padding: 10px 14px; border: 1px solid; border-radius: 6px; font-size: 12px; display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
        .qz-details-raw { margin-top: 4px; max-height: 160px; overflow: auto; padding: 8px; background: var(--ss-raw-bg); border-radius: 4px; font-family: Consolas, "DejaVu Sans Mono", monospace; font-size: 11px; white-space: pre-wrap; word-break: break-word; color: var(--ss-text); }
        .qz-body { flex: 1; min-height: 0; margin-top: 16px; display: flex; flex-direction: column; overflow-y: auto; }

        .qz-grid { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
        .qz-col-main { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
        .qz-col-side { flex: 0 1 380px; min-width: 300px; display: flex; flex-direction: column; gap: 12px; }
        .qz-card { background: var(--ss-surface); border: 1px solid var(--ss-border-light); border-radius: 8px; padding: 14px 16px; }
        .qz-card h4 { margin: 0 0 10px 0; font-size: 14px; color: var(--ss-text); }
        .qz-label { font-size: 12px; font-weight: 600; color: var(--ss-text-2); margin: 10px 0 4px 0; display: block; }
        .qz-input { width: 100%; box-sizing: border-box; padding: 6px 8px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 13px; font-family: inherit; }
        .qz-check { display: flex; gap: 8px; align-items: flex-start; font-size: 13px; padding: 3px 0; cursor: pointer; }
        .qz-topic { display: flex; gap: 10px; padding: 10px 0; border-top: 1px solid var(--ss-border-faint); align-items: flex-start; }
        .qz-topic:first-of-type { border-top: none; }
        .qz-topic input[type=checkbox] { margin-top: 3px; width: 16px; height: 16px; cursor: pointer; }
        .qz-badge { display: inline-block; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 8px; margin-inline-start: 6px; vertical-align: middle; }
        .qz-meta { font-size: 11px; color: var(--ss-text-muted); margin-top: 3px; }
        .qz-empty { text-align: center; color: var(--ss-text-muted); padding: 26px 10px; font-size: 13px; line-height: 1.5; }
        .qz-mode { display: flex; gap: 8px; }
        .qz-mode-option { flex: 1; border: 2px solid var(--ss-border-light); border-radius: 6px; padding: 8px 10px; cursor: pointer; font-size: 12px; color: var(--ss-text-2); background: var(--ss-surface); text-align: start; }
        .qz-mode-option.active { border-color: var(--ss-primary); background: var(--ss-selected-bg); }
        .qz-mode-option b { display: block; font-size: 13px; color: var(--ss-text); margin-bottom: 2px; }
        .qz-history-row { display: flex; gap: 10px; align-items: center; padding: 6px 0; border-top: 1px solid var(--ss-border-faint); font-size: 12px; }
        .qz-bar { height: 6px; background: var(--ss-panel); border-radius: 3px; overflow: hidden; }
        .qz-bar > div { height: 100%; border-radius: 3px; }

        .qz-run { max-width: 860px; width: 100%; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
        .qz-run-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
        .qz-chip { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 10px; background: var(--ss-panel); color: var(--ss-text-2); margin-inline-end: 6px; }
        .qz-nav-dots { display: flex; flex-wrap: wrap; gap: 4px; }
        .qz-dot { width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--ss-border); background: var(--ss-surface); font-size: 11px; cursor: pointer; color: var(--ss-text-2); }
        .qz-dot.answered { background: var(--ss-info-bg-strong); border-color: var(--ss-selected-border); }
        .qz-dot.current { border: 2px solid var(--ss-primary); font-weight: 700; }
        .qz-dot.correct { background: var(--ss-success-bg); border-color: var(--ss-success-border); }
        .qz-dot.wrong { background: var(--ss-danger-bg); border-color: var(--ss-danger-border); }
        .qz-question { font-size: 17px; font-weight: 600; color: var(--ss-text); line-height: 1.45; margin: 4px 0 2px 0; }
        .qz-hint { font-size: 12px; color: var(--ss-text-muted); }
        .qz-options { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
        .qz-option { display: flex; gap: 12px; align-items: center; text-align: start; padding: 11px 14px; border: 2px solid var(--ss-border-light); border-radius: 8px; background: var(--ss-surface); cursor: pointer; font-size: 14px; color: var(--ss-text); font-family: inherit; }
        .qz-option:hover:not(:disabled) { border-color: var(--ss-selected-border); }
        .qz-option:disabled { cursor: default; }
        .qz-option.selected { border-color: var(--ss-primary); background: var(--ss-selected-bg); }
        .qz-option.correct { border-color: var(--ss-success); background: var(--ss-success-bg); }
        .qz-option.wrong { border-color: var(--ss-danger); background: var(--ss-danger-bg); }
        .qz-option.missed { border-color: var(--ss-success); border-style: dashed; }
        .qz-marker { width: 22px; height: 22px; flex-shrink: 0; border: 2px solid var(--ss-border-strong); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: var(--ss-text-muted); }
        .qz-marker.round { border-radius: 50%; }
        .qz-marker.square { border-radius: 4px; }
        .qz-option.selected .qz-marker { background: var(--ss-primary); border-color: var(--ss-primary); color: var(--ss-on-accent); }
        .qz-option.correct .qz-marker { background: var(--ss-success); border-color: var(--ss-success); color: var(--ss-on-accent); }
        .qz-option.wrong .qz-marker { background: var(--ss-danger); border-color: var(--ss-danger); color: var(--ss-on-accent); }
        .qz-feedback { border-radius: 8px; padding: 10px 14px; font-size: 13px; line-height: 1.5; }
        .qz-actions { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; align-items: center; }

        .qz-score { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
        .qz-ring { width: 120px; height: 120px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .qz-ring-inner { width: 94px; height: 94px; border-radius: 50%; background: var(--ss-surface); display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .qz-review { border-top: 1px solid var(--ss-border-faint); padding: 12px 0; }
        .qz-review-option { font-size: 13px; padding-block: 2px; padding-inline: 22px 0; position: relative; color: var(--ss-text-2); }
        .qz-review-option::before { position: absolute; inset-inline-start: 0; }
        .qz-review-option.correct { color: var(--ss-success-text); font-weight: 600; }
        .qz-review-option.correct::before { content: "✓"; }
        .qz-review-option.wrong { color: var(--ss-danger-fg); text-decoration: line-through; }
        .qz-review-option.wrong::before { content: "✗"; text-decoration: none; }
    </style>
</div>

@code {
    private ElementReference rootRef;
    private bool focusRoot;
    private bool confirmAbort;
    private bool confirmSubmit;
    private bool confirmClearHistory;
    private string? confirmDeleteTopicId;
    private bool onlyWrong;
    private bool showAllHistory;

    private static string Css(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Prozentwert für sichtbaren Text in der Schreibweise der Oberflächensprache (66,7 % bzw. 66.7%).</summary>
    private static string Percent(double value) => Loc.Format(UiStrings.Quiz_Percent, ("percent", value.ToString("0.#")));
    private static string Letter(int index) => ((char)('A' + index)).ToString();
    private static string ScoreColor(double percent) => percent >= 75 ? "var(--ss-success-fg)" : percent >= 50 ? "var(--ss-amber)" : "var(--ss-danger-fg)";

    // ---------------- Übersicht: Themen, Start, Verlauf ----------------

    private RenderFragment RenderLibrary() => @<div class="qz-grid">
        <div class="qz-col-main">

            @if (QuizVm.IsTopicFormOpen)
            {
                <div class="qz-card" style="border-color: var(--ss-selected-border);">
                    <h4>@(QuizVm.IsEditingTopic ? UiStrings.Quiz_EditTopic : VmStrings.Quiz_NewTopic)</h4>
                    <label class="qz-label">@UiStrings.Quiz_Name</label>
                    <input class="qz-input" placeholder="@UiStrings.Quiz_NamePlaceholder" @bind="QuizVm.FormName" @bind:event="oninput" />
                    <label class="qz-label">@UiStrings.Quiz_Description <span style="font-weight: normal; color: var(--ss-text-muted);">@UiStrings.Quiz_DescriptionHint</span></label>
                    <textarea class="qz-input" rows="2" placeholder="@UiStrings.Quiz_DescriptionPlaceholder" @bind="QuizVm.FormDescription" @bind:event="oninput"></textarea>
                    <label class="qz-label">@UiStrings.Quiz_Documents</label>
                    @if (DocVm.Documents.Count == 0)
                    {
                        <div class="qz-meta">@UiStrings.Quiz_NoDocuments</div>
                    }
                    @foreach (var doc in DocVm.Documents)
                    {
                        var path = doc.FilePath;
                        <label class="qz-check" style="@(doc.IsMissing ? "color: var(--ss-text-muted);" : "")">
                            <input type="checkbox" checked="@QuizVm.IsFormDocumentSelected(path)" disabled="@doc.IsMissing" @onchange="() => QuizVm.ToggleFormDocument(path)" />
                            <span>@doc.FileName @(doc.IsMissing ? UiStrings.Quiz_NotFound : "")</span>
                        </label>
                    }
                    @if (!string.IsNullOrEmpty(QuizVm.FormError))
                    {
                        <div style="color: var(--ss-danger-fg); font-size: 12px; margin-top: 6px;">@QuizVm.FormError</div>
                    }
                    <div style="display: flex; gap: 8px; margin-top: 12px;">
                        <button type="button" class="qz-btn" style="background: var(--ss-success);" @onclick="SaveTopicAsync">@UiStrings.Common_Save</button>
                        <button type="button" class="qz-btn-outline" @onclick="QuizVm.CloseTopicForm">@UiStrings.Common_Cancel</button>
                    </div>
                </div>
            }

            @if (QuizVm.Suggestions.Count > 0)
            {
                <div class="qz-card" style="border-color: var(--ss-purple-border);">
                    <h4>@UiStrings.Quiz_Suggestions</h4>
                    <div class="qz-meta" style="margin-bottom: 6px;">@UiStrings.Quiz_SuggestionsHint</div>
                    @foreach (var item in QuizVm.Suggestions)
                    {
                        var current = item;
                        <label class="qz-check">
                            <input type="checkbox" checked="@current.IsChecked" @onchange="() => QuizVm.ToggleSuggestion(current)" />
                            <span><b>@current.Suggestion.Name</b>@(string.IsNullOrWhiteSpace(current.Suggestion.Description) ? "" : " – " + current.Suggestion.Description)</span>
                        </label>
                    }
                    <div style="display: flex; gap: 8px; margin-top: 10px;">
                        <button type="button" class="qz-btn" style="background: var(--ss-purple);" @onclick="QuizVm.AcceptSuggestionsAsync">@UiStrings.Quiz_AcceptSelected</button>
                        <button type="button" class="qz-btn-outline" @onclick="QuizVm.DismissSuggestions">@UiStrings.Quiz_Dismiss</button>
                    </div>
                </div>
            }

            <div class="qz-card">
                <div style="display: flex; justify-content: space-between; align-items: baseline;">
                    <h4>@UiStrings.Quiz_Topics</h4>
                    @if (QuizVm.Topics.Count > 1)
                    {
                        <span>
                            <button class="qz-link" @onclick="() => QuizVm.SelectAllTopics(true)">@UiStrings.Quiz_SelectAll</button> ·
                            <button class="qz-link" @onclick="() => QuizVm.SelectAllTopics(false)">@UiStrings.Quiz_SelectNone</button>
                        </span>
                    }
                </div>

                @if (QuizVm.Topics.Count == 0)
                {
                    <div class="qz-empty">
                        <div style="font-size: 30px; margin-bottom: 6px;">❓</div>
                        @LocHtml.Format(UiStrings.Quiz_Empty, ("newTopic", VmStrings.Quiz_NewTopic), ("suggest", VmStrings.Quiz_SuggestTopics))
                    </div>
                }

                @foreach (var topic in QuizVm.Topics)
                {
                    var t = topic;
                    var stats = QuizVm.TopicStatistics(t.Id);
                    <div class="qz-topic">
                        <input type="checkbox" checked="@QuizVm.IsTopicSelected(t.Id)" title="@UiStrings.Quiz_SelectForQuiz" @onchange="() => QuizVm.ToggleTopic(t.Id)" />
                        <div style="flex: 1; min-width: 0; cursor: pointer;" @onclick="() => QuizVm.ToggleTopic(t.Id)">
                            <div style="font-size: 14px; font-weight: 600; color: var(--ss-text);">
                                @t.Name
                                @if (t.Origin == StudyScope.Core.Models.QuizTopicOrigin.Ai)
                                {
                                    <span class="qz-badge" style="background: var(--ss-purple-bg); color: var(--ss-purple-text);">@UiStrings.Quiz_AiBadge</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(t.Description))
                            {
                                <div style="font-size: 12px; color: var(--ss-text-2); margin-top: 2px;">@t.Description</div>
                            }
                            <div class="qz-meta">
                                📄 @string.Join(", ", t.Documents.Select(d => d.FileName))
                                · @Loc.Format(UiStrings.Quiz_TopicPool, ("count", t.Questions.Count))
                                @if (stats is { } s)
                                {
                                    <span> · <span style="color: @ScoreColor(s.Percent); font-weight: 600;">Ø @Percent(s.Percent)</span> @Loc.Format(UiStrings.Quiz_TopicStats, ("count", s.Answered))</span>
                                }
                            </div>
                        </div>
                        <div style="display: flex; gap: 2px; flex-shrink: 0;">
                            @if (confirmDeleteTopicId == t.Id)
                            {
                                <button class="qz-btn" style="background: var(--ss-danger); padding: 3px 8px; font-size: 12px;" @onclick="() => DeleteTopicAsync(t.Id)">@UiStrings.Quiz_DeleteConfirm</button>
                                <button class="qz-icon-btn" title="@UiStrings.Quiz_DontDelete" aria-label="@UiStrings.Quiz_DontDelete" @onclick="() => confirmDeleteTopicId = null">✕</button>
                            }
                            else
                            {
                                <button class="qz-icon-btn" title="@UiStrings.Quiz_EditTopicTitle" aria-label="@UiStrings.Quiz_EditTopicTitle" @onclick="() => QuizVm.OpenEditTopicForm(t.Id)">✏️</button>
                                <button class="qz-icon-btn" title="@UiStrings.Quiz_ResetQuestionsTitle" aria-label="@UiStrings.Quiz_ResetQuestionsTitle" disabled="@(t.Questions.Count == 0)" @onclick="() => QuizVm.ResetTopicQuestionsAsync(t.Id)">🔄</button>
                                <button class="qz-icon-btn" title="@UiStrings.Quiz_DeleteTopicTitle" aria-label="@UiStrings.Quiz_DeleteTopicTitle" @onclick="() => confirmDeleteTopicId = t.Id">🗑️</button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="qz-col-side">
            <div class="qz-card">
                <h4>@VmStrings.Quiz_Start</h4>
                <div style="font-size: 13px; color: var(--ss-text-2);">
                    @LocHtml.Format(UiStrings.Quiz_SelectedTopics, ("selected", QuizVm.SelectedTopicCount), ("total", QuizVm.Topics.Count))
                </div>

                <label class="qz-label">@Loc.Format(UiStrings.Quiz_QuestionCount, ("min", QuizViewModel.MinQuestions), ("max", QuizViewModel.MaxQuestions))</label>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <input type="range" min="@QuizViewModel.MinQuestions" max="@QuizViewModel.MaxQuestions" style="flex: 1;"
                           value="@QuizVm.QuestionCount" @oninput="e => QuizVm.QuestionCount = int.TryParse(e.Value?.ToString(), out var v) ? v : QuizVm.QuestionCount" />
                    <input type="number" class="qz-input" style="width: 64px; text-align: center;" min="@QuizViewModel.MinQuestions" max="@QuizViewModel.MaxQuestions" @bind="QuizVm.QuestionCount" />
                </div>

                <label class="qz-label">@UiStrings.Quiz_Mode</label>
                <div class="qz-mode">
                    <button type="button" class="qz-mode-option @(QuizVm.Mode == StudyScope.Core.Models.QuizMode.Learn ? "active" : "")" @onclick="() => QuizVm.Mode = StudyScope.Core.Models.QuizMode.Learn">
                        <b>@UiStrings.Quiz_LearnMode</b>@UiStrings.Quiz_LearnModeHint
                    </button>
                    <button type="button" class="qz-mode-option @(QuizVm.Mode == StudyScope.Core.Models.QuizMode.Exam ? "active" : "")" @onclick="() => QuizVm.Mode = StudyScope.Core.Models.QuizMode.Exam">
                        <b>@UiStrings.Quiz_ExamMode</b>@UiStrings.Quiz_ExamModeHint
                    </button>
                </div>

                <label class="qz-label">@UiStrings.Quiz_QuestionTypes</label>
                @foreach (var (type, label) in TypeLabels)
                {
                    var current = type;
                    <label class="qz-check">
                        <input type="checkbox" checked="@QuizVm.IsTypeAllowed(current)" @onchange="() => QuizVm.ToggleType(current)" />
                        <span>@label</span>
                    </label>
                }

                <button type="button" class="qz-btn" style="background: var(--ss-success); width: 100%; justify-content: center; margin-top: 14px; padding: 10px;"
                        disabled="@(QuizVm.IsBusy || QuizVm.SelectedTopicCount == 0)" @onclick="StartAsync">
                    @Loc.Format(UiStrings.Quiz_StartWithCount, ("count", QuizVm.QuestionCount))
                </button>
                <div class="qz-meta" style="margin-top: 8px; line-height: 1.4;">
                    @UiStrings.Quiz_StartHint
                </div>
            </div>

            <div class="qz-card">
                <div style="display: flex; justify-content: space-between; align-items: baseline;">
                    <h4>@UiStrings.Quiz_History</h4>
                    @if (QuizVm.History.Count > 0)
                    {
                        @if (confirmClearHistory)
                        {
                            <span style="font-size: 12px;">
                                <button class="qz-link" style="color: var(--ss-danger-fg); font-weight: 600;" @onclick="ClearHistoryAsync">@UiStrings.Quiz_ReallyDelete</button> ·
                                <button class="qz-link" @onclick="() => confirmClearHistory = false">@UiStrings.Quiz_No</button>
                            </span>
                        }
                        else
                        {
                            <button class="qz-link" @onclick="() => confirmClearHistory = true">@UiStrings.Quiz_ClearHistory</button>
                        }
                    }
                </div>
                @if (QuizVm.History.Count == 0)
                {
                    <div class="qz-meta">@UiStrings.Quiz_NoHistory</div>
                }
                @foreach (var result in QuizVm.History.Take(showAllHistory ? QuizViewModel.MaxHistoryEntries : 8))
                {
                    <div class="qz-history-row">
                        <div style="min-width: 74px; white-space: nowrap; color: var(--ss-text-muted); flex-shrink: 0;">@result.CompletedAt.ToString(UiStrings.Quiz_HistoryDateFormat)</div>
                        <div style="flex: 1; min-width: 0;">
                            <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@string.Join(", ", result.TopicNames)">
                                @(result.Mode == StudyScope.Core.Models.QuizMode.Learn ? "🎓" : "📝") @string.Join(", ", result.TopicNames)
                            </div>
                            <div class="qz-bar" style="margin-top: 3px;"><div style="width: @Css(result.Percent)%; background: @ScoreColor(result.Percent);"></div></div>
                        </div>
                        <div style="width: 70px; text-align: end; flex-shrink: 0;"><b>@result.Correct/@result.Total</b> · @Percent(result.Percent)</div>
                    </div>
                }
                @if (QuizVm.History.Count > 8)
                {
                    <button class="qz-link" style="margin-top: 6px;" @onclick="() => showAllHistory = !showAllHistory">@(showAllHistory ? UiStrings.Quiz_ShowLess : Loc.Format(UiStrings.Quiz_ShowAll, ("count", QuizVm.History.Count)))</button>
                }
            </div>
        </div>
    </div>;

    // Als Eigenschaft, damit die Texte bei einem Sprachwechsel neu gelesen werden
    private static (StudyScope.Core.Models.QuizQuestionType, string)[] TypeLabels =>
    [
        (StudyScope.Core.Models.QuizQuestionType.SingleChoice, UiStrings.Quiz_Type_Single),
        (StudyScope.Core.Models.QuizQuestionType.TrueFalse, UiStrings.Quiz_Type_TrueFalse),
        (StudyScope.Core.Models.QuizQuestionType.MultipleChoice, UiStrings.Quiz_Type_Multiple)
    ];

    // ---------------- Laufendes Quiz ----------------

    private RenderFragment RenderRunning() => @<div class="qz-run">
        @if (QuizVm.Session is { Current: { } item } session)
        {
            var question = item.Question;
            var isLearn = session.Mode == StudyScope.Core.Models.QuizMode.Learn;
            var showSolution = item.IsChecked;
            var round = question.Type != StudyScope.Core.Models.QuizQuestionType.MultipleChoice;

            <div class="qz-card">
                <div class="qz-run-head">
                    <div>
                        <span style="font-size: 15px; font-weight: 700; color: var(--ss-text); margin-inline-end: 10px;">@Loc.Format(UiStrings.Quiz_QuestionOf, ("number", session.CurrentIndex + 1), ("total", session.Count))</span>
                        <span class="qz-chip">@item.TopicName</span>
                        <span class="qz-chip">@(isLearn ? UiStrings.Quiz_LearnMode : UiStrings.Quiz_ExamMode)</span>
                        @if (isLearn && session.CheckedCount > 0)
                        {
                            <span class="qz-chip" style="background: var(--ss-success-bg); color: var(--ss-success-text);">@Loc.Format(UiStrings.Quiz_CorrectSoFar, ("correct", session.CorrectCount), ("checked", session.CheckedCount))</span>
                        }
                    </div>
                    @if (confirmAbort)
                    {
                        <span style="font-size: 12px;">
                            @UiStrings.Quiz_AbortConfirm
                            <button class="qz-link" style="color: var(--ss-danger-fg); font-weight: 600;" @onclick="AbortQuiz">@UiStrings.Quiz_AbortYes</button> ·
                            <button class="qz-link" @onclick="() => confirmAbort = false">@UiStrings.Quiz_KeepPlaying</button>
                        </span>
                    }
                    else
                    {
                        <button class="qz-btn-outline" style="font-size: 12px; padding: 4px 10px;" @onclick="() => confirmAbort = true">@UiStrings.Quiz_Abort</button>
                    }
                </div>
                <div class="qz-bar" style="margin-top: 10px;">
                    <div style="width: @Css(100.0 * (isLearn ? session.CheckedCount : session.AnsweredCount) / session.Count)%; background: var(--ss-primary);"></div>
                </div>
                @if (!isLearn)
                {
                    <div class="qz-nav-dots" style="margin-top: 10px;">
                        @for (var i = 0; i < session.Count; i++)
                        {
                            var index = i;
                            <button class="qz-dot @(session.Items[index].IsAnswered ? "answered" : "") @(index == session.CurrentIndex ? "current" : "")"
                                    title="@Loc.Format(session.Items[index].IsAnswered ? UiStrings.Quiz_DotTitleAnswered : UiStrings.Quiz_DotTitle, ("number", index + 1))" @onclick="() => GoTo(index)">@(index + 1)</button>
                        }
                    </div>
                }
            </div>

            <div class="qz-card">
                <div class="qz-hint">
                    @(question.Type switch
                    {
                        StudyScope.Core.Models.QuizQuestionType.TrueFalse => UiStrings.Quiz_Hint_TrueFalse,
                        StudyScope.Core.Models.QuizQuestionType.MultipleChoice => Loc.Format(UiStrings.Quiz_Hint_Multiple, ("count", question.CorrectIndices.Count)),
                        _ => UiStrings.Quiz_Hint_Single
                    })
                </div>
                <div class="qz-question">@question.Text</div>

                <div class="qz-options">
                    @for (var i = 0; i < question.Options.Count; i++)
                    {
                        var index = i;
                        var isSelected = item.Selected.Contains(index);
                        var isCorrect = question.CorrectIndices.Contains(index);
                        var css = !showSolution ? (isSelected ? "selected" : "")
                            : isCorrect && isSelected ? "correct"
                            : isSelected ? "wrong"
                            : isCorrect ? "missed" : "";
                        <button type="button" class="qz-option @css" disabled="@(!session.CanAnswer)" @onclick="() => Select(index)">
                            <span class="qz-marker @(round ? "round" : "square")">@(showSolution && isCorrect ? "✓" : showSolution && isSelected ? "✗" : Letter(index))</span>
                            <span>@question.Options[index]</span>
                        </button>
                    }
                </div>
            </div>

            @if (showSolution)
            {
                <div class="qz-feedback" style="background: @(item.IsCorrect ? "var(--ss-success-bg)" : "var(--ss-danger-bg)"); color: @(item.IsCorrect ? "var(--ss-success-text)" : "var(--ss-danger-fg)");">
                    <b>@(item.IsCorrect ? UiStrings.Quiz_Correct : item.IsAnswered ? UiStrings.Quiz_Wrong : UiStrings.Quiz_NotAnswered)</b>
                    @if (!string.IsNullOrWhiteSpace(question.Explanation))
                    {
                        <div style="margin-top: 4px; color: var(--ss-text);">@question.Explanation</div>
                    }
                </div>
            }

            <div class="qz-actions">
                <button type="button" class="qz-btn-outline" disabled="@(!session.CanGoPrevious)" @onclick="Previous"><span class="ss-flip-rtl">◀</span> @UiStrings.Common_Back</button>
                <span class="qz-meta">@Loc.Format(isLearn ? UiStrings.Quiz_KeyboardLearn : UiStrings.Quiz_KeyboardExam, ("keys", question.Options.Count > 2 ? "A–" + Letter(question.Options.Count - 1) : "A/B"))</span>
                <div style="display: flex; gap: 8px; align-items: center;">
                    @if (isLearn)
                    {
                        @if (!item.IsChecked)
                        {
                            <button type="button" class="qz-btn" style="background: var(--ss-primary);" disabled="@(!session.CanCheck)" @onclick="Check">@UiStrings.Quiz_CheckAnswer</button>
                        }
                        else if (!session.IsLastQuestion)
                        {
                            <button type="button" class="qz-btn" style="background: var(--ss-primary);" @onclick="Next">@UiStrings.Common_Next <span class="ss-flip-rtl">▶</span></button>
                        }
                        else
                        {
                            <button type="button" class="qz-btn" style="background: var(--ss-success);" @onclick="FinishAsync">@UiStrings.Quiz_ShowResult</button>
                        }
                    }
                    else
                    {
                        @if (confirmSubmit)
                        {
                            <span style="font-size: 12px; color: var(--ss-warning-text);">@Loc.Format(UiStrings.Quiz_Unanswered, ("count", session.UnansweredCount))</span>
                            <button type="button" class="qz-btn" style="background: var(--ss-success);" @onclick="FinishAsync">@UiStrings.Quiz_SubmitAnyway</button>
                            <button class="qz-link" @onclick="() => confirmSubmit = false">@UiStrings.Common_Back</button>
                        }
                        else
                        {
                            @if (!session.IsLastQuestion)
                            {
                                <button type="button" class="qz-btn" style="background: var(--ss-primary);" @onclick="Next">@UiStrings.Common_Next <span class="ss-flip-rtl">▶</span></button>
                            }
                            <button type="button" class="qz-btn" style="background: var(--ss-success);" @onclick="SubmitExam">@UiStrings.Quiz_Submit</button>
                        }
                    }
                </div>
            </div>
        }
    </div>;

    // ---------------- Ergebnis ----------------

    private RenderFragment RenderResult() => @<div class="qz-run">
        @if (QuizVm.LastResult is { } result)
        {
            var color = ScoreColor(result.Percent);
            var session = QuizVm.Session;

            <div class="qz-card">
                <div class="qz-score">
                    <div class="qz-ring" style="background: conic-gradient(@color @Css(result.Percent * 3.6)deg, var(--ss-panel) 0deg);">
                        <div class="qz-ring-inner">
                            <div style="font-size: 24px; font-weight: 800; color: @color;">@Percent(result.Percent)</div>
                            <div style="font-size: 11px; color: var(--ss-text-muted);">@Loc.Format(UiStrings.Quiz_ScoreOf, ("correct", result.Correct), ("total", result.Total))</div>
                        </div>
                    </div>
                    <div style="flex: 1; min-width: 220px;">
                        <div style="font-size: 18px; font-weight: 700; color: var(--ss-text);">@QuizViewModel.Verdict(result.Percent)</div>
                        <div class="qz-meta" style="font-size: 12px;">
                            @(result.Mode == StudyScope.Core.Models.QuizMode.Learn ? UiStrings.Quiz_LearnMode : UiStrings.Quiz_ExamMode) · @string.Join(", ", result.TopicNames)
                        </div>

                        @if (result.TopicNames.Count > 1 && session != null)
                        {
                            <div style="margin-top: 10px; display: flex; flex-direction: column; gap: 6px;">
                                @foreach (var group in session.Items.GroupBy(i => i.TopicName))
                                {
                                    var groupPercent = 100.0 * group.Count(i => i.IsCorrect) / group.Count();
                                    <div style="font-size: 12px;">
                                        <div style="display: flex; justify-content: space-between;"><span>@group.Key</span><span>@group.Count(i => i.IsCorrect)/@group.Count()</span></div>
                                        <div class="qz-bar"><div style="width: @Css(groupPercent)%; background: @ScoreColor(groupPercent);"></div></div>
                                    </div>
                                }
                            </div>
                        }

                        <div style="display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap;">
                            @if (QuizVm.WrongCount > 0)
                            {
                                <button type="button" class="qz-btn" style="background: var(--ss-orange);" @onclick="RepeatWrong">@Loc.Format(UiStrings.Quiz_RetryWrong, ("count", QuizVm.WrongCount))</button>
                            }
                            <button type="button" class="qz-btn" style="background: var(--ss-primary);" @onclick="QuizVm.BackToLibrary">@UiStrings.Quiz_BackToLibrary</button>
                        </div>
                    </div>
                </div>
            </div>

            @if (session != null)
            {
                <div class="qz-card">
                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                        <h4>@UiStrings.Quiz_AllWithSolutions</h4>
                        <label class="qz-check" style="font-size: 12px;"><input type="checkbox" @bind="onlyWrong" /> @UiStrings.Quiz_OnlyWrong</label>
                    </div>
                    @for (var i = 0; i < session.Count; i++)
                    {
                        var entry = session.Items[i];
                        if (onlyWrong && entry.IsCorrect) continue;
                        var number = i + 1;
                        <div class="qz-review">
                            <div style="font-size: 13px; font-weight: 600; color: var(--ss-text);">
                                <span style="color: @(entry.IsCorrect ? "var(--ss-success-text)" : "var(--ss-danger-fg)");">@(entry.IsCorrect ? "✓" : "✗")</span>
                                @number. @entry.Question.Text <span class="qz-chip" style="font-weight: normal;">@entry.TopicName</span>
                            </div>
                            <div style="margin-top: 4px;">
                                @for (var o = 0; o < entry.Question.Options.Count; o++)
                                {
                                    var isCorrect = entry.Question.CorrectIndices.Contains(o);
                                    var isSelected = entry.Selected.Contains(o);
                                    <div class="qz-review-option @(isCorrect ? "correct" : isSelected ? "wrong" : "")">
                                        @entry.Question.Options[o] @(isSelected ? UiStrings.Quiz_YourAnswer : "")
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(entry.Question.Explanation))
                            {
                                <div style="font-size: 12px; color: var(--ss-text-2); margin-top: 4px; background: var(--ss-panel-light); padding: 6px 10px; border-radius: 4px;">💡 @entry.Question.Explanation</div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>;

    // ---------------- Ereignisse ----------------

    protected override async Task OnInitializedAsync()
    {
        QuizVm.PropertyChanged += OnVmChanged;
        DocVm.PropertyChanged += OnDocVmChanged;
        await QuizVm.LoadForProfileAsync(DocVm.CurrentProfile);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusRoot)
        {
            focusRoot = false;
            try { await rootRef.FocusAsync(); } catch { /* ignorieren */ }
        }
    }

    private void OnVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private async void OnDocVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(DocVm.CurrentProfile))
        {
            ResetConfirmations();
            await QuizVm.LoadForProfileAsync(DocVm.CurrentProfile);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetConfirmations()
    {
        confirmAbort = false;
        confirmSubmit = false;
        confirmClearHistory = false;
        confirmDeleteTopicId = null;
    }

    private void OpenNewTopic() => QuizVm.OpenNewTopicForm(DocVm.Documents);
    private Task SaveTopicAsync() => QuizVm.SaveTopicFormAsync(DocVm.Documents);
    private Task SuggestAsync() => QuizVm.SuggestTopicsAsync(DocVm.Documents);

    private async Task DeleteTopicAsync(string topicId)
    {
        confirmDeleteTopicId = null;
        await QuizVm.DeleteTopicAsync(topicId);
    }

    private async Task ClearHistoryAsync()
    {
        confirmClearHistory = false;
        await QuizVm.ClearHistoryAsync();
    }

    private async Task StartAsync()
    {
        ResetConfirmations();
        onlyWrong = false;
        await QuizVm.StartQuizAsync();
        focusRoot = true;
    }

    private void Select(int index)
    {
        QuizVm.SelectOption(index);
        focusRoot = true;
    }

    private void Check()
    {
        QuizVm.CheckAnswer();
        focusRoot = true;
    }

    private void Next()
    {
        confirmSubmit = false;
        QuizVm.NextQuestion();
        focusRoot = true;
    }

    private void Previous()
    {
        confirmSubmit = false;
        QuizVm.PreviousQuestion();
        focusRoot = true;
    }

    private void GoTo(int index)
    {
        confirmSubmit = false;
        QuizVm.GoToQuestion(index);
        focusRoot = true;
    }

    private async Task SubmitExam()
    {
        if (QuizVm.Session is { UnansweredCount: > 0 })
        {
            confirmSubmit = true;
            return;
        }

        await FinishAsync();
    }

    private async Task FinishAsync()
    {
        ResetConfirmations();
        await QuizVm.FinishQuizAsync();
    }

    private void AbortQuiz()
    {
        ResetConfirmations();
        QuizVm.AbortQuiz();
    }

    private void RepeatWrong()
    {
        onlyWrong = false;
        QuizVm.RepeatWrongQuestions();
        focusRoot = true;
    }

    /// <summary>Tastatur im laufenden Quiz: A–F bzw. 1–6 wählen, Enter prüfen/weiter.</summary>
    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (QuizVm.Screen != QuizScreen.Running || QuizVm.Session is not { Current: { } item } session)
            return;

        var key = e.Key ?? string.Empty;
        if (key.Length == 1)
        {
            var c = char.ToUpperInvariant(key[0]);
            var index = c >= 'A' && c <= 'F' ? c - 'A' : c >= '1' && c <= '6' ? c - '1' : -1;
            if (index >= 0 && index < item.Question.Options.Count)
            {
                QuizVm.SelectOption(index);
                return;
            }
        }

        if (key == "Enter")
        {
            if (session.Mode == StudyScope.Core.Models.QuizMode.Learn)
            {
                if (!item.IsChecked) Check();
                else if (!session.IsLastQuestion) Next();
                else await FinishAsync();
            }
            else if (!session.IsLastQuestion)
            {
                Next();
            }
        }
        else if (key == "ArrowRight" && session.CanGoNext)
        {
            Next();
        }
        else if (key == "ArrowLeft" && session.CanGoPrevious)
        {
            Previous();
        }
    }

    public void Dispose()
    {
        QuizVm.PropertyChanged -= OnVmChanged;
        DocVm.PropertyChanged -= OnDocVmChanged;
    }
}

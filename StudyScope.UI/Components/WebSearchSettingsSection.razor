@using StudyScope.Core.Models
@using StudyScope.ViewModels
@inject WebSearchSettingsViewModel WebVm
@using Microsoft.JSInterop
@inject IJSRuntime Js
@implements IDisposable

@* Einstellungen › „🌐 Websuche“: Suchdienst, Schlüssel bzw. Adresse, Trefferzahl (global für alle Profile) *@

<div style="display: flex; flex-direction: column; gap: 14px;">
    <div class="ws-info">@UiStrings.WebSearch_Intro</div>

    <div>
        <label class="ss-label" for="ws-provider">@UiStrings.WebSearch_ProviderLabel</label>
        <select id="ws-provider" class="ss-input" @bind="WebVm.Provider">
            @foreach (var option in WebVm.ProviderOptions)
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
        @if (WebVm.Provider == WebSearchProviderType.None)
        {
            <div class="ss-hint">@UiStrings.WebSearch_NoneHint</div>
        }
    </div>

    @if (WebVm.IsTavily)
    {
        <div>
            <label class="ss-label" for="ws-key">@UiStrings.WebSearch_TavilyKeyLabel</label>
            <input id="ws-key" type="password" class="ss-input" autocomplete="off" spellcheck="false"
                   placeholder="@UiStrings.WebSearch_TavilyKeyPlaceholder"
                   @bind="WebVm.TavilyApiKey" @bind:event="oninput" @onblur="WebVm.CheckKeyFormat" />
            @if (!string.IsNullOrEmpty(WebVm.KeyFormatWarning))
            {
                <div class="ws-key-warning" role="status">@WebVm.KeyFormatWarning</div>
            }
            <div class="ss-hint">@UiStrings.WebSearch_TavilyHint</div>
            <button type="button" class="ss-link-btn ws-link" @onclick="() => WebVm.OpenTavilySignup()">@UiStrings.WebSearch_TavilySignup</button>
            <div class="ss-hint">@UiStrings.WebSearch_TavilyPrivacy</div>
        </div>
    }
    else if (WebVm.IsSearxng)
    {
        <div>
            <label class="ss-label" for="ws-url">@UiStrings.WebSearch_SearxngUrlLabel</label>
            <input id="ws-url" type="text" class="ss-input" autocomplete="off" spellcheck="false"
                   placeholder="http://localhost:8888"
                   @bind="WebVm.SearxngUrl" @bind:event="oninput" />
            <div class="ss-hint">@LocHtml.Format(UiStrings.WebSearch_SearxngHint)</div>
        </div>
    }

    @if (WebVm.Provider != WebSearchProviderType.None)
    {
        <div>
            <label class="ss-label" for="ws-max">@UiStrings.WebSearch_MaxResultsLabel</label>
            <select id="ws-max" class="ss-input ws-narrow" @bind="WebVm.MaxResults">
                @foreach (var count in WebVm.MaxResultsOptions)
                {
                    <option value="@count">@count</option>
                }
            </select>
            <div class="ss-hint">@UiStrings.WebSearch_MaxResultsHint</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(WebVm.StatusMessage))
    {
        <div id="ws-status" role="status" class="ws-status @StatusClass">@WebVm.StatusMessage</div>
    }
    @if (WebVm.ShowTavilyAccountLink)
    {
        <button type="button" class="ss-link-btn ws-link" @onclick="() => WebVm.OpenTavilyAccount()">@UiStrings.WebSearch_TavilyAccount</button>
    }
</div>

<div class="st-footer">
    <button type="button" class="ss-btn" style="background: var(--ss-info);" disabled="@(!WebVm.CanTest)"
            title="@UiStrings.WebSearch_TestTitle"
            @onclick="WebVm.TestAsync">
        @(WebVm.IsTesting ? UiStrings.WebSearch_Testing : UiStrings.WebSearch_Test)
    </button>
    <div style="display: flex; gap: 8px;">
        <button type="button" class="ss-btn" style="background: var(--ss-secondary); font-weight: normal;" @onclick="() => OnClose.InvokeAsync()">@UiStrings.Common_Close</button>
        @if (WebVm.CanSaveAnyway)
        {
            <button type="button" class="ss-btn" style="background: var(--ss-orange);" @onclick="SaveAnywayAsync">@UiStrings.WebSearch_SaveAnyway</button>
        }
        <button type="button" class="ss-btn" style="background: var(--ss-primary);" disabled="@(!WebVm.CanSave)"
                title="@UiStrings.WebSearch_SaveTitle" @onclick="SaveAsync">
            @(WebVm.IsVerifying ? UiStrings.WebSearch_Testing : UiStrings.Common_Save)
        </button>
    </div>
</div>

<style>
    .ss-label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; color: var(--ss-text-2); }
    .ss-input { width: 100%; padding: 7px; border: 1px solid var(--ss-border); border-radius: 4px; font-size: 13px; box-sizing: border-box; background: var(--ss-surface); margin-top: 3px; }
    .ss-hint { font-size: 11.5px; color: var(--ss-text-muted); margin-top: 4px; line-height: 1.4; }
    .ss-btn { padding: 7px 14px; color: var(--ss-on-accent); border: none; border-radius: 4px; cursor: pointer; font-size: 13px; font-weight: bold; white-space: nowrap; }
    .ss-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .ws-info { font-size: 12px; padding: 8px 10px; border-radius: 4px; line-height: 1.5; background: var(--ss-info-bg); color: var(--ss-info-text); border: 1px solid var(--ss-info-border); }
    .ws-narrow { width: auto; min-width: 80px; }
    .ws-link { margin-top: 6px; font-size: 12px; }
    .ws-status { font-size: 12px; padding: 7px 10px; border-radius: 4px; word-break: break-word; }
    .ws-ok { background: var(--ss-success-bg); color: var(--ss-success-text); border: 1px solid var(--ss-success-border); }
    .ws-error { background: var(--ss-danger-bg); color: var(--ss-danger-text); border: 1px solid var(--ss-danger-border); }
    .ws-warn { background: var(--ss-warning-bg); color: var(--ss-warning-text); border: 1px solid var(--ss-warning-border); }
    .ws-progress { background: var(--ss-info-bg); color: var(--ss-info-text); border: 1px solid var(--ss-info-border); }
    .ws-status { white-space: pre-line; scroll-margin-block-end: 90px; }
    .ws-key-warning { font-size: 11.5px; margin-top: 4px; line-height: 1.4; padding-block: 4px; padding-inline: 8px; border-radius: 4px; background: var(--ss-warning-bg); color: var(--ss-warning-text); border: 1px solid var(--ss-warning-border); }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnInitializedAsync()
    {
        WebVm.PropertyChanged += OnChanged;
        await WebVm.LoadAsync();
    }

    private void OnChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private string? shownStatus;

    // Neue Meldung (Prüfung, Ergebnis) ins Bild holen – sie steht unter dem Formular, der Bereich scrollt
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (WebVm.StatusMessage == shownStatus) return;
        shownStatus = WebVm.StatusMessage;
        if (string.IsNullOrEmpty(shownStatus)) return;
        try
        {
            await Js.InvokeVoidAsync("eval", "(function(){var e=document.getElementById('ws-status'); if(e){e.scrollIntoView({block:'nearest'});}})()");
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    private string StatusClass => WebVm.IsProgress ? "ws-progress" : WebVm.IsSuccess ? "ws-ok" : WebVm.IsWarning ? "ws-warn" : "ws-error";

    // Gespeichert und nichts weiter zu lesen → schließen; Verbrauch oder Warnung → Dialog bleibt offen
    private async Task SaveAsync()
    {
        if (await WebVm.SaveAsync() && !WebVm.KeepOpenAfterSave)
            await OnClose.InvokeAsync();
    }

    private async Task SaveAnywayAsync()
    {
        if (await WebVm.SaveAnywayAsync() && !WebVm.KeepOpenAfterSave)
            await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        // Schließen während der Prüfung bricht sie ab – es wird nichts gespeichert
        WebVm.CancelVerification();
        WebVm.PropertyChanged -= OnChanged;
    }
}

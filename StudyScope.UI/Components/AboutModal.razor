@using StudyScope.Core.Common
@using StudyScope.Core.Interfaces
@inject IExternalLinkOpener LinkOpener

<!-- Hintergrund-Overlay -->
<div style="position: fixed; inset: 0; width: 100vw; height: 100vh; background: var(--ss-overlay); display: flex; justify-content: center; align-items: center; z-index: 1050;"
     @onclick="Close">

    <!-- Dialogfenster -->
    <div style="background: var(--ss-surface); border-radius: 8px; width: 470px; max-width: 90vw; box-shadow: var(--ss-dialog-shadow); overflow: hidden; display: flex; flex-direction: column;"
         @onclick:stopPropagation="true">

        <!-- Kopfzeile -->
        <div style="padding: 14px 18px; border-bottom: 1px solid var(--ss-border-light); display: flex; justify-content: space-between; align-items: center; background: var(--ss-panel-light);">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 18px;">ℹ️</span>
                <h4 style="margin: 0; font-size: 15px; color: var(--ss-text);">@UiStrings.About_Title</h4>
            </div>
            <button type="button" aria-label="@UiStrings.Common_Close" style="background: none; border: none; font-size: 16px; cursor: pointer; color: var(--ss-text-muted); font-weight: bold;"
                    @onclick="Close">
                ✕
            </button>
        </div>

        <!-- Inhalt -->
        <div style="padding: 20px; font-size: 13px; color: var(--ss-text-2); display: flex; flex-direction: column; gap: 12px; line-height: 1.5;">
            <div>
                <strong style="font-size: 16px; color: var(--ss-text);">@AppInfo.ProductName v@(AppInfo.Version)</strong><br />
                <span>@UiStrings.About_Tagline</span>
            </div>

            <div style="background: var(--ss-panel); padding: 10px 12px; border-radius: 6px; font-size: 12px; display: flex; flex-direction: column; gap: 4px;">
                <div><b>@UiStrings.About_Developer</b> @UiStrings.About_DeveloperValue</div>
                <div><b>@UiStrings.About_Formats</b> PDF, TXT, CSV</div>
                <div><b>@UiStrings.About_Architecture</b> Photino.NET, Blazor, RAG-Pipeline</div>
            </div>

            <div style="font-size: 12px; color: var(--ss-text-muted);">
                @UiStrings.About_Description
            </div>

            <hr style="border: none; border-top: 1px solid var(--ss-border-faint); margin: 2px 0;" />

            <!-- Lizenz & Kontaktbereich -->
            <div style="font-size: 12px; display: flex; flex-direction: column; gap: 6px; color: var(--ss-text-2);">
                <div>
                    <b>@UiStrings.About_License</b> @UiStrings.About_LicensedUnder
                    <button type="button" class="ss-link-btn" title="@AppInfo.LicenseUrl" @onclick="() => Open(AppInfo.LicenseUrl)">Apache License 2.0</button>
                </div>
                <div>
                    <b>@UiStrings.About_Source</b>
                    <button type="button" class="ss-link-btn" title="@AppInfo.RepositoryUrl" @onclick="() => Open(AppInfo.RepositoryUrl)">github.com/Schwitalla-Alex/StudyScope</button>
                </div>
                <div>
                    <b>@UiStrings.About_Contact</b>
                    <a href="mailto:info.schwitalla@gmail.com" style="color: var(--ss-link); text-decoration: none;">
                        info.schwitalla@gmail.com
                    </a>
                </div>
            </div>
        </div>

        <!-- Fußzeile -->
        <div style="padding: 10px 18px; border-top: 1px solid var(--ss-border-light); display: flex; justify-content: flex-end; background: var(--ss-panel-light);">
            <button type="button"
                    style="padding: 6px 18px; background: var(--ss-primary); color: var(--ss-on-accent); border: none; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer;"
                    @onclick="Close">
                @UiStrings.Common_Close
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Links öffnen im System-Browser, nie in der WebView der App.</summary>
    private void Open(string url) => LinkOpener.OpenUrl(url);

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
@using StudyScope.ViewModels
@inject DocumentListViewModel DocVm
@implements IDisposable

<div style="background: #e9ecef; border-top: 1px solid #ced4da; padding: 4px 15px; font-size: 12px; color: #495057; display: flex; justify-content: space-between; align-items: center; user-select: none;">
    <!-- Linker Bereich: Dokumente & Textstellen -->
    <div style="display: flex; gap: 20px;">
        <span>Dokumente: <b>@DocVm.TotalDocumentCount</b> (@DocVm.FilteredDocuments.Count(d => d.IsSelected && !d.IsMissing) aktiv)</span>
        <span>Geladene Textstellen: <b>@DocVm.TotalChunkCount</b></span>
    </div>

    <!-- Rechter Bereich: Aktives KI-Modell & Profil -->
    <div style="display: flex; gap: 20px;">
        <span>KI: <b>@DocVm.CurrentAiModelDisplayName</b></span>
        <span>Profil: <b>@DocVm.CurrentProfile</b></span>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        DocVm.PropertyChanged += OnDocVmPropertyChanged;
    }

    private void OnDocVmPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DocVm.PropertyChanged -= OnDocVmPropertyChanged;
    }
}
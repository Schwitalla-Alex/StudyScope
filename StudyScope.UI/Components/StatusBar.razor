@using StudyScope.ViewModels
@inject DocumentListViewModel DocVm
@implements IDisposable

<div style="height: 28px; background: #f8f9fa; border-top: 1px solid #dee2e6; display: flex; align-items: center; justify-content: space-between; padding: 0 14px; font-size: 11px; color: #6c757d; user-select: none;">
    <div style="display: flex; gap: 16px;">
        <span>Dokumente: <strong>@DocVm.Documents.Count</strong> (@DocVm.Documents.Count(d => d.IsSelected && !d.IsMissing) aktiv)</span>
        <span>Geladene Textstellen: <strong>@TotalChunkCount</strong></span>
    </div>

    <div>
        <span>Profil: <strong>@DocVm.CurrentProfile</strong></span>
    </div>
</div>

@code {
    private int TotalChunkCount => DocVm.Documents
        .Where(d => d.IsSelected && !d.IsMissing)
        .Sum(d => d.ExtractedChunkCount);

    protected override void OnInitialized()
    {
        DocVm.PropertyChanged += OnDocVmChanged;
    }

    private void OnDocVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DocVm.PropertyChanged -= OnDocVmChanged;
    }
}
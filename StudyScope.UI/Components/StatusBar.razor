@using StudyScope.ViewModels
@inject DocumentListViewModel DocVm
@inject AudioViewModel AuVm
@inject VideoViewModel VdVm
@implements IDisposable

<div style="background: var(--ss-panel); border-top: 1px solid var(--ss-border); padding: 4px 15px; font-size: 12px; color: var(--ss-text-2); display: flex; justify-content: space-between; align-items: center; user-select: none;">
    <!-- Linker Bereich: Dokumente & Textstellen -->
    <div style="display: flex; gap: 20px;">
        <span>@LocHtml.Format(UiStrings.Status_Documents, ("total", DocVm.TotalDocumentCount), ("active", DocVm.ActiveDocumentCount))</span>
        <span>@LocHtml.Format(UiStrings.Status_Chunks, ("count", DocVm.TotalChunkCount))</span>
    </div>

    <!-- Rechter Bereich: laufende Wiedergabe, aktives KI-Modell & Profil -->
    <div style="display: flex; gap: 20px; align-items: center;">
        @if (AuVm.NowPlayingTitle is { } playing)
        {
            <span class="sb-audio" title="@UiStrings.Status_AudioTitle">
                🎧 <b>@playing</b> @(AuVm.IsPaused ? UiStrings.Status_AudioPaused : UiStrings.Status_AudioPlaying)
                <button class="sb-audio-btn" title="@(AuVm.IsPaused ? UiStrings.Common_Resume : UiStrings.Common_Pause)" @onclick="AuVm.TogglePlayPauseAsync">@(AuVm.IsPaused ? "▶" : "⏸")</button>
                <button class="sb-audio-btn" title="@UiStrings.Common_Stop" @onclick="AuVm.StopAsync">⏹</button>
            </span>
        }
        @if (VdVm.NowPlayingTitle is { } video)
        {
            <span class="sb-audio" title="@UiStrings.Status_VideoTitle">
                🎬 <b>@video</b> @(VdVm.IsPaused ? UiStrings.Status_VideoPaused : UiStrings.Status_VideoPlaying)
                <button class="sb-audio-btn" title="@(VdVm.IsPaused ? UiStrings.Common_Resume : UiStrings.Common_Pause)" @onclick="VdVm.TogglePlayPauseAsync">@(VdVm.IsPaused ? "▶" : "⏸")</button>
                <button class="sb-audio-btn" title="@UiStrings.Common_Stop" @onclick="VdVm.StopAsync">⏹</button>
            </span>
        }
        <span>@UiStrings.Status_Ai <b>@DocVm.CurrentAiModelDisplayName</b></span>
        <span>@UiStrings.Status_Profile <b>@DocVm.CurrentProfile</b></span>
    </div>
</div>

<style>
    .sb-audio { display: inline-flex; align-items: center; gap: 5px; max-width: 460px; white-space: nowrap; background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 10px; padding-block: 0; padding-inline: 8px 4px; }
    .sb-audio b { overflow: hidden; text-overflow: ellipsis; max-width: 220px; display: inline-block; vertical-align: bottom; }
    .sb-audio-btn { border: none; background: transparent; cursor: pointer; font-size: 12px; padding: 1px 4px; border-radius: 4px; }
    .sb-audio-btn:hover { background: var(--ss-panel); }
</style>

@code {
    protected override void OnInitialized()
    {
        DocVm.PropertyChanged += OnDocVmPropertyChanged;
        AuVm.PropertyChanged += OnAudioChanged;
        VdVm.PropertyChanged += OnVideoChanged;
    }

    private void OnDocVmPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        // Profilwechsel beendet eine laufende Wiedergabe (auch wenn der Audio-Reiter nicht offen ist)
        if (e.PropertyName == nameof(DocumentListViewModel.CurrentProfile))
        {
            _ = InvokeAsync(() => AuVm.HandleProfileChangedAsync(DocVm.CurrentProfile));
            _ = InvokeAsync(() => VdVm.HandleProfileChangedAsync(DocVm.CurrentProfile));
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnAudioChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(AudioViewModel.NowPlayingTitle) or nameof(AudioViewModel.IsPaused))
            InvokeAsync(StateHasChanged);
    }

    private void OnVideoChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(VideoViewModel.NowPlayingTitle) or nameof(VideoViewModel.IsPaused))
            InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        VdVm.PropertyChanged -= OnVideoChanged;
        DocVm.PropertyChanged -= OnDocVmPropertyChanged;
        AuVm.PropertyChanged -= OnAudioChanged;
    }
}
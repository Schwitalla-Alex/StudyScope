            @if (VdVm.SlideSource == VideoSlideSource.NewPresentation)
            {
                <div style="display: flex; gap: 8px; align-items: center; margin-top: 8px; font-size: 12px; color: #495057;">
                    Inhaltsfolien: <input type="number" min="3" max="20" class="vd-number" @bind="VdVm.SlideCount" />
                    <span class="vd-meta">(@ActiveDocumentCount aktivierte Dokumente)</span>

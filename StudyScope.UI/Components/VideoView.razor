            else if (VdVm.CanUseNotes)
            {
                <label style="display: flex; gap: 6px; align-items: flex-start; margin-top: 10px; font-size: 12.5px; color: #212529; cursor: pointer;">
                    <input type="checkbox" checked="@VdVm.UseNotesDirectly" @onchange="e => VdVm.UseNotesDirectly = e.Value is true" />
                    <span>Sprechernotizen direkt verwenden<span class="vd-desc">Die Präsentation hat ausführliche Notizen – sie werden ohne KI-Aufruf als Sprechtext übernommen.</span></span>
                </label>
            }

            <label class="vd-label">Titel <span style="font-weight: normal; color: #6c757d;">(optional)</span></label>
            <input class="vd-input" @bind="VdVm.CustomTitle" @bind:event="oninput" />

            <button type="button" class="vd-btn" style="background: #28a745; width: 100%; justify-content: center; margin-top: 14px; padding: 9px;"
                    disabled="@(!VdVm.CanGenerate)" @onclick="GenerateAsync">
                🎬 Video erstellen
            </button>
            @if (VdVm.SlideSource == VideoSlideSource.NewPresentation && ActiveDocumentCount == 0)
            {
                <div class="vd-meta" style="color: #b02a37; margin-top: 6px;">Bitte links mindestens ein Dokument aktivieren.</div>
            }
            <div class="vd-meta" style="margin-top: 6px;">Die Sprechtexte schreibt die KI aus Ihren Einstellungen; vorgelesen wird mit der gewählten Sprachausgabe.</div>
            @if (VdVm.Items.Count > 0)
            {
                <button type="button" class="vd-link" style="margin-top: 8px;" @onclick="() => VdVm.IsFormOpen = false">Abbrechen</button>
            }
        </div>
    };

    /// <summary>Auswahl der Sprachausgabe (gleiche Einstellung wie im Audio-Reiter) mit Status, Hinweisen und Stimme.</summary>
    private RenderFragment SpeechPanel() => __builder =>
    {
        var current = VdVm.CurrentAvailability;
        var (currentCss, currentIcon) = AvailabilityStyle(current);

        <div class="vd-card">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                <h4 style="margin: 0;">🔊 Sprachausgabe</h4>
                <button class="vd-link" title="Verfügbarkeit und Stimmen neu prüfen (z. B. nach Installation einer Stimme)" @onclick="RecheckAsync">↻ Neu prüfen</button>
            </div>
            <div class="vd-providers" style="margin-top: 8px;">
                @foreach (var service in VdVm.SpeechServices)
                {
                    var provider = service.Provider;
                    var availability = VdVm.AvailabilityOf(provider);
                    var (css, icon) = AvailabilityStyle(availability);
                    var selectable = VdVm.CanSelectProvider(provider);
                    <button type="button" class="vd-provider @(VdVm.SelectedProvider == provider ? "active" : "")" disabled="@(!selectable)"
                            title="@(selectable ? service.DisplayName : $"Nicht verfügbar: {availability.Message} {availability.Hint}")"
                            @onclick="() => VdVm.SetProviderAsync(provider)">
                        <span style="font-size: 16px;">@(provider == SpeechProviderType.SystemVoice ? "🖥️" : "☁️")</span>
                        <span>
                            <b>@service.DisplayName</b>
                            <span class="vd-avail @css">@icon @availability.Message</span>
                        </span>
                    </button>
                }
            </div>
            <div class="vd-meta" style="margin-top: 8px;">
                Aktuell: <b>@(VdVm.CurrentSpeechService?.DisplayName ?? "–")</b> · <span class="vd-avail @currentCss" style="display: inline;">@currentIcon @current.Message</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(current.Hint))
            {
                <div class="vd-note @(current.Status == SpeechAvailabilityStatus.Unavailable ? "warn" : "info")">💡 @current.Hint</div>
            }
            @if (VdVm.AvailabilityOf(SpeechProviderType.GeminiTts).Status == SpeechAvailabilityStatus.Unavailable)
            {
                <button type="button" class="vd-link" style="margin-top: 6px;" @onclick="() => OnOpenSpeechSettings.InvokeAsync()">⚙️ Gemini TTS einrichten (Einstellungen › Sprachausgabe)</button>
            }

            @if (VdVm.SelectedProvider == SpeechProviderType.SystemVoice)
            {
                @if (VdVm.SystemVoices.Count > 0)
                {
                    <label class="vd-voice-row">Stimme
                        <select class="vd-select" value="@VdVm.SpeechSettings.SystemVoicePrimary" @onchange="VoiceChangedAsync">
                            <option value="">Automatisch (@VoiceName(VdVm.NarratorVoice))</option>
                            @foreach (var voice in VdVm.SystemVoices)
                            {
                                <option value="@voice.Id">@VoiceLabel(voice)</option>
                            }
                        </select>
                    </label>
                }
                <div class="vd-meta" style="margin-top: 6px;">⏱️ Die Folienwechsel richten sich nach dem Ende jedes Sprechtexts; die Gesamtdauer ist anfangs geschätzt.</div>
                <div class="vd-meta" style="margin-top: 4px;">💾 Dateiexport: @SpeechProviderState.NoFileExportHint</div>
            }
            else if (VdVm.SelectedProvider == SpeechProviderType.GeminiTts)
            {
                <div class="vd-note info">☁️ Gemini TTS erzeugt das Audio vorab – je Folie eine eigene Anfrage, damit die Folienwechsel exakt zum Ton passen (Stimme <b>@VdVm.SpeechSettings.GeminiVoicePrimary</b>). Nach Änderungen werden nur die geänderten Szenen neu erzeugt.</div>
                <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px;">
                    <button type="button" class="vd-btn" style="background: #17a2b8;" disabled="@(!VdVm.CurrentAvailability.IsAvailable || VdVm.IsTestingConnection)"
                            title="Prüft Schlüssel und Modell über die kostenlose Modellabfrage – es wird keine Sprache erzeugt" @onclick="VdVm.TestSpeechConnectionAsync">
                        @(VdVm.IsTestingConnection ? "Prüfe …" : "🔌 Verbindung testen")
                    </button>
                    <button type="button" class="vd-btn" style="background: #6c757d;" title="Schlüssel, Modell und Stimmen ändern" @onclick="() => OnOpenSpeechSettings.InvokeAsync()">⚙️ Schlüssel, Modell, Stimmen</button>
                </div>
            }

            @if (VdVm.ShowPrivacyHint)
            {
                <div class="vd-note privacy">🔒 @SpeechProviderState.GeminiPrivacyHint</div>
            }
            @if (VdVm.IsLocalChatAi)
            {
                <div class="vd-note info">ℹ️ @SpeechProviderState.LocalAiHint Ollama und LM Studio selbst können keine Sprache erzeugen.</div>
            }
        </div>
    };

    /// <summary>Audio mit Gemini TTS: Stand, Erzeugen (nur geänderte Szenen) mit Kostenschätzung und Bestätigung, Löschen.</summary>
    private RenderFragment AudioPanel(VideoDocument video) => __builder =>
    {
        var service = VdVm.CurrentSpeechService;
        var canCreate = service is { SupportsFileExport: true };
        if (!video.HasAudioFile && !canCreate)
            return;

        var needing = VdVm.ScenesNeedingAudio.Count;
        <div class="vd-file">
            @if (video.HasAudioFile)
            {
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <span style="font-weight: 600;">🎵 Audio:</span>
                    <span class="vd-meta" style="font-size: 12px;">
                        @Clock(video.AudioDurationSeconds) Min.
                        @if (video.AudioCreatedAt is { } created) { <span> · erzeugt am @created.ToString("dd.MM.yyyy HH:mm")</span> }
                        @if (!string.IsNullOrWhiteSpace(video.AudioCreatedWith)) { <span> · @video.AudioCreatedWith</span> }
                    </span>
                    <span style="flex: 1;"></span>
                    @if (confirmDeleteAudio)
                    {
                        <button type="button" class="vd-btn" style="background: #dc3545;" @onclick="DeleteAudioAsync">Audio löschen?</button>
                        <button class="vd-icon" title="Nicht löschen" @onclick="() => confirmDeleteAudio = false">✕</button>
                    }
                    else
                    {
                        <button class="vd-icon" title="Alle Audiodateien dieses Videos löschen (die Sprechtexte bleiben)" disabled="@VdVm.IsBusy" @onclick="() => confirmDeleteAudio = true">🗑️</button>
                    }
                </div>
                @if (VdVm.SelectedAudioFilePath == null)
                {
                    <div class="vd-hint">⚠️ Die Audiodatei wurde nicht gefunden (verschoben oder gelöscht). Erzeugen Sie das Audio bei Bedarf neu.</div>
                }
                else if (video.IsAudioOutdated)
                {
                    <div class="vd-hint">✏️ Sprechtexte oder Folien wurden nach dem Erzeugen geändert. @(needing > 0 ? $"{needing} Szene(n) müssen neu erzeugt werden – die übrigen bleiben." : "Das Audio muss nur neu zusammengesetzt werden (kostenlos).")</div>
                }
                else if (!VdVm.UsesFilePlayback && service is { SupportsLivePlayback: true })
                {
                    <div class="vd-meta" style="margin-top: 4px;">▶ liest mit der Systemstimme vor. Zum Abspielen des Gemini-Audios oben „Gemini TTS“ wählen.</div>
                }
            }

            @if (canCreate)
            {
                var upToDate = video.HasAudioFile && !video.IsAudioOutdated && VdVm.SelectedAudioFilePath != null && needing == 0;
                <div style="margin-top: @(video.HasAudioFile ? "8px" : "0");">
                    @if (confirmGenerateAudio && VdVm.CanGenerateAudio)
                    {
                        <div class="vd-confirm">
                            <div style="font-weight: 600;">🎙️ Audio mit @service!.DisplayName @(confirmGenerateAll ? "für alle Szenen neu erzeugen" : "erzeugen")?</div>
                            @if (VdVm.EstimateText(confirmGenerateAll) is { } estimate)
                            {
                                <div class="vd-meta" style="margin-top: 3px; font-size: 12px;">Geschätzt: @estimate</div>
                            }
                            else
                            {
                                <div class="vd-meta" style="margin-top: 3px; font-size: 12px;">Alle Szenen sind aktuell – das Audio wird nur neu zusammengesetzt (kostenlos).</div>
                            }
                            <div class="vd-meta" style="margin-top: 3px;">🔒 Die Sprechtexte werden dazu an Google gesendet. Jede Szene entsteht vollständig oder gar nicht.</div>
                            <div style="display: flex; gap: 6px; margin-top: 8px;">
                                <button type="button" class="vd-btn" style="background: #28a745;" @onclick="GenerateAudioAsync">Jetzt erzeugen</button>
                                <button type="button" class="vd-link" @onclick="() => confirmGenerateAudio = false">Abbrechen</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            @if (!upToDate)
                            {
                                <button type="button" class="vd-btn" style="background: #6f42c1;" disabled="@(!VdVm.CanGenerateAudio)"
                                        title="@(VdVm.GenerateAudioDisabledReason ?? "Audio erzeugen (vorher werden Kosten und Größe angezeigt)")"
                                        @onclick="() => AskGenerate(false)">
                                    🎙️ @(VdVm.NeedsOnlyAssembly ? "Audio zusammensetzen" : video.HasAudioFile ? $"Geänderte Szenen neu erzeugen ({needing})" : "Audio erzeugen")
                                </button>
                                @if (VdVm.EstimateText(false) is { } estimate)
                                {
                                    <span class="vd-meta">@estimate</span>
                                }
                            }
                            else
                            {
                                <span class="vd-meta">✓ Audio ist aktuell.</span>
                            }
                            @if (video.Scenes.Any(s => s.HasAudio))
                            {
                                <button type="button" class="vd-link" disabled="@(!VdVm.CanGenerateAudio)" title="Z. B. nach einem Wechsel der Stimme oder des Modells" @onclick="() => AskGenerate(true)">Alle Szenen neu erzeugen</button>
                            }
                        </div>
                        @if (VdVm.GenerateAudioDisabledReason is { } reason && !VdVm.IsBusy)
                        {
                            <div class="vd-hint">🔇 @reason</div>
                        }
                    }
                </div>
            }
        </div>
    };

    private void AskGenerate(bool all)
    {
        confirmGenerateAll = all;
        confirmGenerateAudio = true;
        confirmDeleteAudio = false;
    }

    private static string Clock(double seconds)
    {
        var t = TimeSpan.FromSeconds(Math.Round(seconds));
        return t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");
    }

    private string VoiceName(string id) => VdVm.SystemVoices.FirstOrDefault(v => v.Id == id)?.Name ?? "Standard";

    private static string VoiceLabel(SpeechVoice voice) => $"{voice.Name} ({voice.Language}{(voice.IsLocal ? "" : ", online")})";

    // ---------------- Lebenszyklus ----------------

    protected override async Task OnInitializedAsync()
    {
        VdVm.PropertyChanged += OnVmChanged;
        DocVm.PropertyChanged += OnDocVmChanged;
        DocVm.Documents.CollectionChanged += OnDocumentsChanged;
        await VdVm.EnsureLoadedForProfileAsync(DocVm.CurrentProfile);
        _ = RunTickerAsync();
    }

    /// <summary>Zeitsteuerung der Systemstimme: Position und Stichpunkte regelmäßig nachführen.</summary>
    private async Task RunTickerAsync()
    {
        ticker = new PeriodicTimer(TimeSpan.FromMilliseconds(150));
        try
        {
            while (await ticker.WaitForNextTickAsync())
            {
                if (VdVm.IsPlaying && !VdVm.IsPaused && !VdVm.UsesFilePlayback)
                    await InvokeAsync(VdVm.Tick);
            }
        }
        catch (ObjectDisposedException)
        {
            // Komponente geschlossen
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            FilePlayer.Attach(JSRuntime);
            if (!SystemSpeech.IsAttached)
                SystemSpeech.Attach(JSRuntime);
            await VdVm.RefreshAvailabilityAsync();
        }

        if (VdVm.IsPresenting != wasPresenting)
        {
            wasPresenting = VdVm.IsPresenting;
            WindowControl.SetFullScreen(VdVm.IsPresenting);
            if (VdVm.IsPresenting) focusPresentation = true;
        }

        if (focusPresentation && VdVm.IsPresenting)
        {
            focusPresentation = false;
            try { await presentRef.FocusAsync(); } catch { /* Element noch nicht bereit */ }
        }

        if (focusEditor)
        {
            focusEditor = false;
            await EvalAsync("(function(){var e=document.getElementById('vd-editor'); if(e){e.focus();}})()");
        }

        // Gezeigte Szene in der Liste sichtbar halten
        var index = VdVm.CurrentSceneIndex;
        if (VdVm.IsPlaying && !VdVm.IsPresenting && index >= 0 && index != lastScrolledIndex)
        {
            lastScrolledIndex = index;
            await EvalAsync($"(function(){{var e=document.getElementById('vd-scene-{index}'); if(e){{e.scrollIntoView({{block:'nearest', behavior:'smooth'}});}}}})()");
        }
        else if (!VdVm.IsPlaying)
        {
            lastScrolledIndex = -1;
        }
    }

    private async Task EvalAsync(string script)
    {
        try { await JSRuntime.InvokeVoidAsync("eval", script); }
        catch { /* nur Bequemlichkeit */ }
    }

    private void OnVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OnDocumentsChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private async void OnDocVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(DocVm.CurrentProfile))
        {
            ResetEditing();
            await VdVm.LoadForProfileAsync(DocVm.CurrentProfile);
        }
        await InvokeAsync(StateHasChanged);
    }

    private void ResetEditing()
    {
        renameId = null;
        confirmDeleteId = null;
        editIndex = null;
        confirmGenerateAudio = false;
        confirmDeleteAudio = false;
    }

    private void SelectItem(string id)
    {
        ResetEditing();
        VdVm.SelectVideo(id);
    }

    private Task GenerateAsync() => VdVm.GenerateAsync(DocVm.Documents);

    private Task GenerateFromSelectedAsync() => VdVm.GenerateFromSelectedDocumentsAsync(DocVm.Documents);

    private async Task RecheckAsync()
    {
        SystemSpeech.Refresh();
        await VdVm.RefreshAvailabilityAsync();
    }

    private Task VoiceChangedAsync(ChangeEventArgs e) => VdVm.SetSystemVoiceAsync(e.Value?.ToString() ?? string.Empty);

    private async Task RateChangedAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var rate))
            await VdVm.SetRateAsync(rate);
    }

    private async Task SeekAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
            await VdVm.SeekAsync(value / 1000.0);
    }

    private async Task PlayFromAsync(int index)
    {
        await VdVm.GoToSceneAsync(index);
        if (!VdVm.IsPlaying)
            await VdVm.PlayAsync();
    }

    private Task StartPresentingAsync() => VdVm.StartPresentingAsync();

    private async Task ExitPresentingAsync() => await VdVm.ExitPresentingAsync();

    private async Task HandlePresentKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await ExitPresentingAsync();
            return;
        }
        await VdVm.HandleKeyAsync(e.Key);
    }

    private async Task GenerateAudioAsync()
    {
        confirmGenerateAudio = false;
        await VdVm.GenerateAudioAsync(confirmGenerateAll);
    }

    private async Task DeleteAudioAsync()
    {
        confirmDeleteAudio = false;
        await VdVm.DeleteAudioAsync();
    }

    // ---------------- Bearbeiten ----------------

    private void StartEdit(int index, string text)
    {
        editIndex = index;
        editText = text;
        focusEditor = true;
    }

    private async Task CommitEditAsync()
    {
        if (editIndex is not { } index) return;
        editIndex = null;
        await VdVm.SetNarrationAsync(index, editText);
    }

    private async Task EditKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey) await CommitEditAsync();
        else if (e.Key == "Escape") editIndex = null;
    }

    private void StartRename(VideoDocument item)
    {
        renameId = item.Id;
        renameText = item.Title;
    }

    private async Task RenameAsync(string id)
    {
        if (await VdVm.RenameAsync(id, renameText))
            renameId = null;
    }

    private async Task RenameKeyAsync(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter") await RenameAsync(id);
        else if (e.Key == "Escape") renameId = null;
    }

    private async Task DeleteAsync(string id)
    {
        confirmDeleteId = null;
        await VdVm.DeleteAsync(id);
    }

    private async Task ExportScriptAsync(VideoScriptExportFormat format)
    {
        try
        {
            var extension = VideoViewModel.Extension(format);
            var path = await DesktopDialogs.SaveFileAsync(VdVm.SuggestFileName(extension), filterExtension: extension,
                filterDescription: VideoViewModel.FormatDescription(format), title: "Sprechtexte speichern als...");
            if (string.IsNullOrWhiteSpace(path)) return;
            if (!path.EndsWith("." + extension, StringComparison.OrdinalIgnoreCase)) path += "." + extension;
            await VdVm.ExportScriptAsync(format, path);
        }
        catch (Exception ex)
        {
            VdVm.ShowStatus($"⚠️ Fehler beim Export: {ex.Message}", isError: true);
        }
    }

    public void Dispose()
    {
        VdVm.PropertyChanged -= OnVmChanged;
        DocVm.PropertyChanged -= OnDocVmChanged;
        DocVm.Documents.CollectionChanged -= OnDocumentsChanged;
        ticker?.Dispose();
        // Vollbild beim Verlassen des Reiters beenden; die Wiedergabe selbst läuft weiter (Statusleiste)
        if (VdVm.IsPresenting)
        {
            _ = VdVm.ExitPresentingAsync();
            WindowControl.SetFullScreen(false);
        }
    }
}

<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Versionsnummer steht zentral in Directory.Build.props -->
		<!-- Icon der exe (Startmenü, Desktop-Verknüpfung, „Apps & Features“) -->
		<ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Photino.Blazor" Version="4.0.13" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
	</ItemGroup>

	<!-- Texte der Oberfläche: neutrale Sprache Deutsch, Übersetzungen in UiStrings.<kultur>.resx,
	     die typisierte Klasse UiStrings wird beim Bauen erzeugt -->
	<ItemGroup>
		<EmbeddedResource Update="Resources\UiStrings.resx">
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>StudyScope.UI.Resources</StronglyTypedNamespace>
			<StronglyTypedClassName>UiStrings</StronglyTypedClassName>
			<StronglyTypedFileName>$(IntermediateOutputPath)UiStrings.Designer.cs</StronglyTypedFileName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\StudyScope.Core\StudyScope.Core.csproj" />
		<ProjectReference Include="..\StudyScope.Infrastructure\StudyScope.Infrastructure.csproj" />
		<ProjectReference Include="..\StudyScope.ViewModels\StudyScope.ViewModels.csproj" />
	</ItemGroup>

	<!-- Keine Debug-Symbole ausliefern: SkiaSharp.NativeAssets.Win32 bringt libSkiaSharp.pdb (~100 MB) mit,
	     die DebugType=none nicht erfasst (sie ist ein natives Paket-Asset, kein eigenes Symbol) -->
	<Target Name="StudyScopeRemovePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
		</ItemGroup>
	</Target>

	<!-- Sorgt dafür, dass wwwroot und index.html ins Ausgabeverzeichnis kopiert werden -->
	<ItemGroup>
		<Content Update="wwwroot\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
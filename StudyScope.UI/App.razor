@using StudyScope.UI.Components
@using Microsoft.JSInterop
@inject DocumentListViewModel DocVm
@inject ChatViewModel ChatVm
@inject SettingsViewModel SettingsVm
@inject AudioViewModel AuVm
@inject VideoViewModel VdVm
@inject ReportViewModel RepVm
@inject LayoutViewModel LayoutVm
@inject PresentationViewModel PresVm
@inject AppMenuViewModel MenuVm
@inject AppearanceViewModel AppearanceVm
@inject IJSRuntime JS
@using StudyScope.ViewModels.Menu
@implements IDisposable

<!-- Sprachwechsel (☰ › Einstellungen › Darstellung): Der Schlüssel baut alle Komponenten neu auf, damit jeder Text
     in der neuen Sprache gelesen wird. Zustand in den ViewModels (Chat, Dokumente, Wiedergabe) bleibt erhalten. -->
<div style="display: contents;" @key="languageKey">
<!-- root-Komponente: Füllt 100vh aus -->
<div style="display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: var(--ss-surface); color: var(--ss-text);">
    <!-- 1. Kopfzeile: ☰ ganz links (Datei, Einstellungen, Hilfe), daneben die einzeilige Reiterleiste -->
    <div class="ss-topbar">
        @if (AppMenuViewModel.IsAvailable(IsPresenting))
        {
            <AppMenu OnOpenSettings="OpenSettings" OnShowAbout="OpenAboutModal" />
        }
        <TabBar @bind-ActiveTab="activeTab" />
    </div>

    <!-- 2. Hauptbereich (nimmt dynamisch den gesamten mittleren Platz ein) -->
    <div style="display: flex; flex: 1; min-height: 0; overflow: hidden;">
        <!-- Linke Leiste: Dokumentenliste, Profilauswahl & Verknüpfung zum Öffnen der Einstellungen -->
        <SidebarPanel OnOpenSettings="OpenSettingsModal" />

        <!-- Rechter Bereich: Inhalt des aktiven Reiters -->
        <div style="flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden;">

            <!-- Aktiver Arbeitsbereich -->
            <div style="flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column;">
                @if (activeTab == "chat")
                {
                    <ChatArea />
                }
                else if (activeTab == "cards")
                {
                    <FlashcardView />
                }
                else if (activeTab == "mindmap")
                {
                    <MindmapView OnAskQuestion="AskFromMindmapAsync" />
                }
                else if (activeTab == "presentation")
                {
                    <PresentationView />
                }
                else if (activeTab == "quiz")
                {
                    <QuizView />
                }
                else if (activeTab == "tables")
                {
                    <DataTableView />
                }
                else if (activeTab == "audio")
                {
                    <AudioView OnOpenSpeechSettings="OpenSpeechSettings" OnOpenExportSettings="OpenExportSettings" />
                }
                else if (activeTab == "video")
                {
                    <VideoView OnOpenSpeechSettings="OpenSpeechSettings" OnOpenExportSettings="OpenExportSettings" />
                }
                else
                {
                    <ReportView OnPlayVideo="PlayVideoFromReport" />
                }
            </div>
        </div>
    </div>

    <!-- 3. Statusleiste: Fest unten verankert -->
    <StatusBar />
</div>

@if (showSettings)
{
    <SettingsModal OnClose="CloseSettingsModal" InitialSection="@settingsSection" />
}

@if (showAbout)
{
    <AboutModal OnClose="CloseAboutModal" />
}
</div>

@code {
    private bool showSettings = false;
    private bool showAbout = false;
    private string activeTab = "chat";

    private DotNetObjectReference<App>? selfRef;

    /// <summary>Zähler für den Neuaufbau nach einem Sprachwechsel (siehe <c>@key</c> oben).</summary>
    private int languageKey;

    /// <summary>Vortrag (Präsentation) oder Vollbild-Wiedergabe (Video): kein Menü, kein Strg+B.</summary>
    private bool IsPresenting => PresVm.IsPresenting || VdVm.IsPresenting;


    protected override async Task OnInitializedAsync()
    {
        PresVm.PropertyChanged += OnPresentingChanged;
        VdVm.PropertyChanged += OnPresentingChanged;
        AppearanceVm.LanguageChanged += OnLanguageChanged;
        // Zuerst den gemerkten Zustand der Seitenleiste, damit sie nicht sichtbar auf- und zuklappt
        await LayoutVm.LoadAsync();
        await AppearanceVm.LoadAsync();
        await DocVm.InitializeAsync();
        await SettingsVm.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        await SetPageLanguageAsync();
        try
        {
            // Farbschema aus config.json anwenden und den Startspiegel (localStorage) angleichen
            await JS.InvokeAsync<string>("studyScopeTheme.apply", AppearanceViewModel.ThemeAttribute(AppearanceVm.SavedTheme), true);
        }
        catch (JSException) { /* Skript fehlt: helle Darstellung */ }
        try
        {
            var width = await JS.InvokeAsync<double>("studyScopeLayout.attach", selfRef);
            LayoutVm.SetWindowWidth(width);
        }
        catch (JSException)
        {
            // Skript nicht geladen – Strg+B und automatisches Einklappen entfallen, der Knopf funktioniert weiter
        }
    }

    /// <summary>Strg+B aus <c>studyscope-layout.js</c>; die Bedingungen prüft <see cref="LayoutViewModel"/>.</summary>
    [JSInvokable]
    public async Task OnLayoutShortcut(string key, bool ctrl, bool alt, bool shift, bool meta, bool repeat,
        string focusTag, string focusType, bool focusEditable)
    {
        await LayoutVm.HandleShortcutAsync(new ShortcutKey(key, ctrl, alt, shift, meta, repeat, focusTag, focusType, focusEditable),
            IsPresenting, MenuVm.IsAnyMenuOpen);
    }

    /// <summary>Nur auf den Wechsel in den/aus dem Vortrag reagieren (das Video meldet sonst sehr häufig Änderungen).</summary>
    private void OnPresentingChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName != nameof(PresentationViewModel.IsPresenting)) return;
        if (IsPresenting) MenuVm.CloseAll();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Sprache und Schreibrichtung der Oberfläche auf &lt;html&gt; (Vorlesen, Silbentrennung, dir="rtl").</summary>
    private async Task SetPageLanguageAsync()
    {
        try
        {
            var culture = System.Globalization.CultureInfo.CurrentUICulture;
            await JS.InvokeVoidAsync("studyScopeLayout.setLanguage", culture.TwoLetterISOLanguageName, culture.TextInfo.IsRightToLeft);
        }
        catch (JSException) { /* Skript fehlt: lang aus index.html */ }
    }

    /// <summary>
    /// Sprache gewechselt (nach „Speichern“ in der Darstellung, Kultur ist bereits umgestellt): Menüs schließen,
    /// lang/dir setzen und alles neu aufbauen. Der Einstellungsdialog bleibt offen, im Abschnitt „Darstellung“.
    /// </summary>
    private void OnLanguageChanged(object? sender, EventArgs e) => _ = InvokeAsync(async () =>
    {
        MenuVm.CloseAll();
        MenuVm.RefreshTexts();
        if (showSettings) settingsSection = "appearance";
        languageKey++;
        StateHasChanged();
        await SetPageLanguageAsync();
        // Modellname in der Statusleiste (z. B. „Fake-KI (Testmodus)“) in der neuen Sprache
        await DocVm.RefreshCurrentAiModelAsync(announceProfile: false);
    });

    /// <summary>Fensterbreite aus <c>studyscope-layout.js</c> (beim Ändern der Größe, entprellt).</summary>
    [JSInvokable]
    public void OnWindowWidth(double width) => LayoutVm.SetWindowWidth(width);

    public void Dispose()
    {
        PresVm.PropertyChanged -= OnPresentingChanged;
        VdVm.PropertyChanged -= OnPresentingChanged;
        AppearanceVm.LanguageChanged -= OnLanguageChanged;
        try { _ = JS.InvokeVoidAsync("studyScopeLayout.detach"); } catch { /* Fenster wird geschlossen */ }
        selfRef?.Dispose();
    }

    private string settingsSection = "ai";

    /// <summary>Einstellungsdialog im genannten Abschnitt öffnen („ai“, „speech“, „export“) – aus dem Hamburger-Menü,
    /// der Seitenleiste und den Reitern Audio/Video.</summary>
    private void OpenSettings(string section)
    {
        settingsSection = section;
        showSettings = true;
    }

    private void OpenSettingsModal() => OpenSettings("ai");
    private void OpenSpeechSettings() => OpenSettings("speech");
    private void OpenExportSettings() => OpenSettings("export");

    private async Task CloseSettingsModal()
    {
        showSettings = false;
        // Schlüssel/Modell der Sprachausgabe, die Chat-KI oder der ffmpeg-Pfad können sich geändert haben
        await AuVm.ReloadSpeechSettingsAsync();
        await VdVm.ReloadSpeechSettingsAsync();
        await AuVm.RefreshMp3AvailabilityAsync();
        await VdVm.RefreshExportAvailabilityAsync(refresh: true);
        await RepVm.RefreshMp3AvailabilityAsync();
    }

    /// <summary>
    /// Frage aus der Mindmap: zum Chat wechseln und die Frage dort mit den aktivierten Dokumenten stellen.
    /// </summary>
    private async Task AskFromMindmapAsync(string question)
    {
        activeTab = "chat";
        if (ChatVm.IsBusy)
        {
            // Läuft gerade eine Antwort, die Frage nur ins Eingabefeld übernehmen
            ChatVm.CurrentInputPrompt = question;
            return;
        }

        ChatVm.CurrentInputPrompt = question;
        StateHasChanged();
        await ChatVm.SendPromptAsync();
    }

    /// <summary>
    /// „▶ Video abspielen“ im Bericht: Video vormerken und in den Reiter „Video“ wechseln; der Reiter startet die
    /// Wiedergabe nach dem ersten Zeichnen (erst dann sind Player und Systemstimme verbunden).
    /// </summary>
    private void PlayVideoFromReport(string videoId)
    {
        VdVm.RequestPlayback(videoId);
        activeTab = "video";
        StateHasChanged();
    }

    private void OpenAboutModal() => showAbout = true;
    private void CloseAboutModal() => showAbout = false;
}
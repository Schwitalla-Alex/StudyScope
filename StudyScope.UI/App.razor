@using StudyScope.UI.Components
@using Microsoft.JSInterop
@inject DocumentListViewModel DocVm
@inject ChatViewModel ChatVm
@inject SettingsViewModel SettingsVm
@inject AudioViewModel AuVm
@inject VideoViewModel VdVm
@inject ReportViewModel RepVm
@inject LayoutViewModel LayoutVm
@inject PresentationViewModel PresVm
@inject IJSRuntime JS
@implements IDisposable

<!-- root-Komponente: Füllt 100vh aus -->
<div style="display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #fff;">
    <!-- 1. Menüleiste mit beiden Callbacks -->
    <MenuBar OnOpenSettings="OpenSettingsModal" OnShowAboutAsync="OpenAboutModal" />

    <!-- 2. Hauptbereich (nimmt dynamisch den gesamten mittleren Platz ein) -->
    <div style="display: flex; flex: 1; min-height: 0; overflow: hidden;">
        <!-- Linke Leiste: Dokumentenliste, Profilauswahl & Verknüpfung zum Öffnen der Einstellungen -->
        <SidebarPanel OnOpenSettings="OpenSettingsModal" />

        <!-- Rechter Bereich mit Reiter-Umschaltung zwischen Chat und Karteikarten -->
        <div style="flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden;">

            <!-- Reiterleiste oben -->
            <div style="display: flex; flex-wrap: wrap; background: #e9ecef; border-bottom: 1px solid #ced4da; padding-left: 10px; gap: 4px;">
                <button style="padding: 6px 16px; white-space: nowrap; border: 1px solid @(activeTab == "chat" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "chat" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "chat" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "chat"'>
                    💬 Chat & Fragen
                </button>
                <button style="padding: 6px 16px; white-space: nowrap; border: 1px solid @(activeTab == "cards" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "cards" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "cards" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "cards"'>
                    🎴 Lernkarteikarten
                </button>
                <button style="padding: 6px 16px; white-space: nowrap; border: 1px solid @(activeTab == "mindmap" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "mindmap" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "mindmap" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "mindmap"'>
                    🧠 Mindmap
                </button>
                <button style="padding: 6px 16px; white-space: nowrap; border: 1px solid @(activeTab == "presentation" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "presentation" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "presentation" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "presentation"'>
                    📽️ Präsentation
                </button>
                <button style="padding: 6px 16px; white-space: nowrap; border: 1px solid @(activeTab == "quiz" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "quiz" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "quiz" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "quiz"'>
                    ❓ Quiz
                </button>
                <button style="padding: 6px 16px; white-space: nowrap; border: 1px solid @(activeTab == "tables" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "tables" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "tables" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "tables"'>
                    📊 Datentabelle
                </button>
                <button style="padding: 6px 16px; white-space: nowrap; border: 1px solid @(activeTab == "audio" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "audio" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "audio" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "audio"'>
                    🎧 Audio
                </button>
                <button style="padding: 6px 16px; white-space: nowrap; border: 1px solid @(activeTab == "video" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "video" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "video" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "video"'>
                    🎬 Video
                </button>
                <button style="padding: 6px 16px; white-space: nowrap; border: 1px solid @(activeTab == "reports" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "reports" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "reports" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "reports"'>
                    📑 Berichte
                </button>
            </div>

            <!-- Aktiver Arbeitsbereich -->
            <div style="flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column;">
                @if (activeTab == "chat")
                {
                    <ChatArea />
                }
                else if (activeTab == "cards")
                {
                    <FlashcardView />
                }
                else if (activeTab == "mindmap")
                {
                    <MindmapView OnAskQuestion="AskFromMindmapAsync" />
                }
                else if (activeTab == "presentation")
                {
                    <PresentationView />
                }
                else if (activeTab == "quiz")
                {
                    <QuizView />
                }
                else if (activeTab == "tables")
                {
                    <DataTableView />
                }
                else if (activeTab == "audio")
                {
                    <AudioView OnOpenSpeechSettings="OpenSpeechSettings" OnOpenExportSettings="OpenExportSettings" />
                }
                else if (activeTab == "video")
                {
                    <VideoView OnOpenSpeechSettings="OpenSpeechSettings" OnOpenExportSettings="OpenExportSettings" />
                }
                else
                {
                    <ReportView OnPlayVideo="PlayVideoFromReport" />
                }
            </div>
        </div>
    </div>

    <!-- 3. Statusleiste: Fest unten verankert -->
    <StatusBar />
</div>

@if (showSettings)
{
    <SettingsModal OnClose="CloseSettingsModal" InitialSection="@settingsSection" />
}

@if (showAbout)
{
    <AboutModal OnClose="CloseAboutModal" />
}

@code {
    private bool showSettings = false;
    private bool showAbout = false;
    private string activeTab = "chat";

    private DotNetObjectReference<App>? selfRef;

    protected override async Task OnInitializedAsync()
    {
        // Zuerst den gemerkten Zustand der Seitenleiste, damit sie nicht sichtbar auf- und zuklappt
        await LayoutVm.LoadAsync();
        await DocVm.InitializeAsync();
        await SettingsVm.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        try
        {
            var width = await JS.InvokeAsync<double>("studyScopeLayout.attach", selfRef);
            LayoutVm.SetWindowWidth(width);
        }
        catch (JSException)
        {
            // Skript nicht geladen – Strg+B und automatisches Einklappen entfallen, der Knopf funktioniert weiter
        }
    }

    /// <summary>Strg+B aus <c>studyscope-layout.js</c>; die Bedingungen prüft <see cref="LayoutViewModel"/>.</summary>
    [JSInvokable]
    public async Task OnLayoutShortcut(string key, bool ctrl, bool alt, bool shift, bool meta, bool repeat,
        string focusTag, string focusType, bool focusEditable)
    {
        var isPresenting = PresVm.IsPresenting || VdVm.IsPresenting;
        await LayoutVm.HandleShortcutAsync(new ShortcutKey(key, ctrl, alt, shift, meta, repeat, focusTag, focusType, focusEditable), isPresenting);
    }

    /// <summary>Fensterbreite aus <c>studyscope-layout.js</c> (beim Ändern der Größe, entprellt).</summary>
    [JSInvokable]
    public void OnWindowWidth(double width) => LayoutVm.SetWindowWidth(width);

    public void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("studyScopeLayout.detach"); } catch { /* Fenster wird geschlossen */ }
        selfRef?.Dispose();
    }

    private string settingsSection = "ai";

    private void OpenSettingsModal()
    {
        settingsSection = "ai";
        showSettings = true;
    }

    /// <summary>Aus dem Audio- bzw. Video-Reiter: Einstellungen direkt im Abschnitt „Sprachausgabe“ öffnen.</summary>
    private void OpenSpeechSettings()
    {
        settingsSection = "speech";
        showSettings = true;
    }

    /// <summary>Aus dem Audio- bzw. Video-Reiter: Einstellungen im Abschnitt „Export“ (ffmpeg) öffnen.</summary>
    private void OpenExportSettings()
    {
        settingsSection = "export";
        showSettings = true;
    }

    private async Task CloseSettingsModal()
    {
        showSettings = false;
        // Schlüssel/Modell der Sprachausgabe, die Chat-KI oder der ffmpeg-Pfad können sich geändert haben
        await AuVm.ReloadSpeechSettingsAsync();
        await VdVm.ReloadSpeechSettingsAsync();
        await AuVm.RefreshMp3AvailabilityAsync();
        await VdVm.RefreshExportAvailabilityAsync(refresh: true);
        await RepVm.RefreshMp3AvailabilityAsync();
    }

    /// <summary>
    /// Frage aus der Mindmap: zum Chat wechseln und die Frage dort mit den aktivierten Dokumenten stellen.
    /// </summary>
    private async Task AskFromMindmapAsync(string question)
    {
        activeTab = "chat";
        if (ChatVm.IsBusy)
        {
            // Läuft gerade eine Antwort, die Frage nur ins Eingabefeld übernehmen
            ChatVm.CurrentInputPrompt = question;
            return;
        }

        ChatVm.CurrentInputPrompt = question;
        StateHasChanged();
        await ChatVm.SendPromptAsync();
    }

    /// <summary>
    /// „▶ Video abspielen“ im Bericht: Video vormerken und in den Reiter „Video“ wechseln; der Reiter startet die
    /// Wiedergabe nach dem ersten Zeichnen (erst dann sind Player und Systemstimme verbunden).
    /// </summary>
    private void PlayVideoFromReport(string videoId)
    {
        VdVm.RequestPlayback(videoId);
        activeTab = "video";
        StateHasChanged();
    }

    private void OpenAboutModal() => showAbout = true;
    private void CloseAboutModal() => showAbout = false;
}
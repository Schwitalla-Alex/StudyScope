@using StudyScope.UI.Components
@inject DocumentListViewModel DocVm
@inject ChatViewModel ChatVm
@inject SettingsViewModel SettingsVm

<!-- root-Komponente: Füllt 100vh aus -->
<div style="display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #fff;">
    <!-- 1. Menüleiste mit beiden Callbacks -->
    <MenuBar OnOpenSettings="OpenSettingsModal" OnShowAboutAsync="OpenAboutModal" />

    <!-- 2. Hauptbereich (nimmt dynamisch den gesamten mittleren Platz ein) -->
    <div style="display: flex; flex: 1; min-height: 0; overflow: hidden;">
        <!-- Linke Leiste: Dokumentenliste, Profilauswahl & Verknüpfung zum Öffnen der Einstellungen -->
        <SidebarPanel OnOpenSettings="OpenSettingsModal" />

        <!-- Rechter Bereich mit Reiter-Umschaltung zwischen Chat und Karteikarten -->
        <div style="flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden;">

            <!-- Reiterleiste oben -->
            <div style="display: flex; background: #e9ecef; border-bottom: 1px solid #ced4da; padding-left: 10px; gap: 4px;">
                <button style="padding: 6px 16px; border: 1px solid @(activeTab == "chat" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "chat" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "chat" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "chat"'>
                    💬 Chat & Fragen
                </button>
                <button style="padding: 6px 16px; border: 1px solid @(activeTab == "cards" ? "#ced4da" : "transparent"); border-bottom: none; background: @(activeTab == "cards" ? "#fff" : "transparent"); border-top-left-radius: 4px; border-top-right-radius: 4px; font-weight: @(activeTab == "cards" ? "bold" : "normal"); cursor: pointer; font-size: 13px;"
                        @onclick='() => activeTab = "cards"'>
                    🎴 Lernkarteikarten
                </button>
            </div>

            <!-- Aktiver Arbeitsbereich -->
            <div style="flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column;">
                @if (activeTab == "chat")
                {
                    <ChatArea />
                }
                else
                {
                    <FlashcardView />
                }
            </div>
        </div>
    </div>

    <!-- 3. Statusleiste: Fest unten verankert -->
    <StatusBar />
</div>

@if (showSettings)
{
    <SettingsModal OnClose="CloseSettingsModal" />
}

@if (showAbout)
{
    <AboutModal OnClose="CloseAboutModal" />
}

@code {
    private bool showSettings = false;
    private bool showAbout = false;
    private string activeTab = "chat";

    protected override async Task OnInitializedAsync()
    {
        await DocVm.InitializeAsync();
        await SettingsVm.InitializeAsync();
    }

    private void OpenSettingsModal() => showSettings = true;
    private void CloseSettingsModal() => showSettings = false;

    private void OpenAboutModal() => showAbout = true;
    private void CloseAboutModal() => showAbout = false;
}
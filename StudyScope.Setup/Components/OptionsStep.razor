@inherits ViewModelComponent
@inject SetupWizardViewModel Vm

<h2>@SetupStrings.Options_Title</h2>
<p class="lead">@SetupStrings.Options_Lead</p>

<label class="check">
    <input type="checkbox" id="opt-menu" checked="@Vm.CreateMenuShortcut" disabled="@(!Vm.IsMenuShortcutOptional)"
           @onchange="e => Vm.CreateMenuShortcut = (bool)(e.Value ?? false)" />
    <span>@Vm.MenuShortcutLabel</span>
</label>
<label class="check">
    <input type="checkbox" id="opt-desktop" checked="@Vm.CreateDesktopShortcut"
           @onchange="e => Vm.CreateDesktopShortcut = (bool)(e.Value ?? false)" />
    <span>@SetupStrings.Options_DesktopShortcut</span>
</label>

<h3>@SetupStrings.Options_Summary</h3>
<table class="summary">
    <tr><th>@SetupStrings.Options_Action</th><td>@ActionText</td></tr>
    <tr><th>@SetupStrings.Folder_Label</th><td><code>@Vm.InstallDirectory</code></td></tr>
    <tr><th>@SetupStrings.Options_UserData</th><td>@LocHtml.Format(SetupStrings.Options_UserDataKept, ("folder", Vm.UserDataDirectory))</td></tr>
</table>

<p class="hint">@Loc.Format(SetupStrings.Hint_ClickToStart, ("button", Vm.IsUpdate ? SetupStrings.Button_Update : SetupStrings.Button_Install))</p>

@code {
    private string ActionText => Vm.IsUpdate
        ? Loc.Format(SetupStrings.Options_ActionUpdate, ("from", Vm.InstalledVersion), ("to", Vm.Version))
        : Loc.Format(SetupStrings.Options_ActionNew, ("version", Vm.Version));

    protected override IEnumerable<INotifyPropertyChanged> ViewModels => new INotifyPropertyChanged[] { Vm };
}

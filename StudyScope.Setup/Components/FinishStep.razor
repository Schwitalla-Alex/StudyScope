@inherits ViewModelComponent
@inject SetupWizardViewModel Vm

<div class="done-icon">✓</div>
<h2>@(Vm.IsUpdate ? SetupStrings.Finish_TitleUpdate : SetupStrings.Finish_TitleInstall)</h2>
<p class="lead">@Loc.Format(Vm.IsUpdate ? SetupStrings.Finish_LeadUpdate : SetupStrings.Finish_LeadInstall, ("version", Vm.Version))</p>

<table class="summary">
    <tr><th>@SetupStrings.Finish_InstalledIn</th><td><code>@Vm.InstallDirectory</code></td></tr>
    <tr><th>@SetupStrings.Finish_Uninstall</th><td>@UninstallHint</td></tr>
</table>

<label class="check">
    <input type="checkbox" id="opt-launch" checked="@Vm.LaunchAfterFinish"
           @onchange="e => Vm.LaunchAfterFinish = (bool)(e.Value ?? false)" />
    <span>@SetupStrings.Finish_Launch</span>
</label>

@code {
    private static string UninstallHint => OperatingSystem.IsWindows()
        ? SetupStrings.Finish_UninstallHintWindows
        : Loc.Format(SetupStrings.Finish_UninstallHintLinux, ("action", SetupCoreStrings.Desktop_UninstallAction));

    protected override IEnumerable<INotifyPropertyChanged> ViewModels => new INotifyPropertyChanged[] { Vm };
}

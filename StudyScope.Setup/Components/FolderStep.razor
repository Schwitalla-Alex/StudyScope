@inherits ViewModelComponent
@inject SetupWizardViewModel Vm

<h2>@SetupStrings.Folder_Title</h2>

@if (Vm.IsUpdate)
{
    <p class="lead">@SetupStrings.Folder_LeadUpdate</p>
}
else
{
    <p class="lead">@SetupStrings.Folder_LeadNew</p>
}

<label class="field-label" for="install-dir">@SetupStrings.Folder_Label</label>
<div class="folder-row">
    <input id="install-dir" type="text" class="@(Vm.FolderError == null ? "" : "invalid")"
           value="@Vm.InstallDirectory"
           disabled="@Vm.IsUpdate"
           @oninput="e => Vm.InstallDirectory = e.Value?.ToString() ?? string.Empty" />
    <button class="btn btn-secondary" id="btn-browse" disabled="@Vm.IsUpdate" @onclick="Vm.BrowseFolderAsync">@SetupStrings.Button_Browse</button>
</div>

@if (Vm.FolderError != null)
{
    <div class="field-error" id="folder-error">@Vm.FolderError</div>
}
@if (!Vm.IsUpdate && Vm.InstallDirectory != Vm.DefaultInstallDirectory)
{
    <button class="link" id="btn-default-folder" @onclick="Vm.ResetFolderToDefault">@Loc.Format(SetupStrings.Folder_UseDefault, ("folder", Vm.DefaultInstallDirectory))</button>
}

<div class="box box-info">
    <strong>@SetupStrings.Folder_DataSeparateTitle</strong><br />
    @LocHtml.Format(SetupStrings.Folder_DataSeparateText, ("folder", Vm.UserDataDirectory))
</div>

@code {
    protected override IEnumerable<INotifyPropertyChanged> ViewModels => new INotifyPropertyChanged[] { Vm };
}

@inherits ViewModelComponent
@inject SetupWizardViewModel Vm

<h2>@SetupStrings.Welcome_Title</h2>
<p class="lead">@LocHtml.Format(SetupStrings.Welcome_Lead, ("version", Vm.Version))</p>

@if (!Vm.IsPayloadAvailable)
{
    <div class="box box-warning" id="welcome-no-payload">
        <strong>@SetupStrings.Welcome_NoPayloadTitle</strong><br />
        @SetupStrings.Welcome_NoPayloadText
    </div>
}
else if (Vm.IsUpdate)
{
    <div class="box box-info" id="welcome-update">
        <strong>@Loc.Format(SetupStrings.Welcome_UpdateTitle, ("version", Vm.InstalledVersion))</strong><br />
        @LocHtml.Format(SetupStrings.Welcome_UpdateText, ("folder", Vm.InstallDirectory), ("version", Vm.Version))
    </div>
}

<ul class="checklist">
    <li>@SetupStrings.Welcome_PerUser</li>
    <li>@SetupStrings.Welcome_KeepsData</li>
    <li>@SetupStrings.Welcome_Uninstall</li>
    <li>@SetupStrings.Welcome_Ffmpeg</li>
</ul>

<p class="hint">@Loc.Format(SetupStrings.Hint_ClickToContinue, ("button", SetupStrings.Button_Next))</p>

@code {
    protected override IEnumerable<INotifyPropertyChanged> ViewModels => new INotifyPropertyChanged[] { Vm };
}

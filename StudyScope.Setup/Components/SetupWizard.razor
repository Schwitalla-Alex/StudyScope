@inherits ViewModelComponent
@inject SetupWizardViewModel Vm
@inject SetupContext Context

<div class="wizard">
    <header class="wizard-header">
        <img src="favicon.ico" alt="" class="wizard-logo" />
        <div class="wizard-title">
            <h1>@SetupStrings.Window_SetupTitle</h1>
            <span>@Loc.Format(SetupStrings.Header_Version, ("version", Vm.Version))</span>
            @if (Context.IsSandbox)
            {
                <span class="sandbox-badge">@SetupStrings.Header_Sandbox</span>
            }
        </div>
        <ol class="wizard-steps">
            @foreach (var (step, label) in Steps)
            {
                <li class="@StepClass(step)">@Loc.Format(SetupStrings.Step_Label, ("number", (int)step + 1), ("label", label))</li>
            }
        </ol>
    </header>

    <main class="wizard-content">
        @switch (Vm.CurrentStep)
        {
            case WizardStep.Welcome:
                <WelcomeStep />
                break;
            case WizardStep.Folder:
                <FolderStep />
                break;
            case WizardStep.Options:
                <OptionsStep />
                break;
            case WizardStep.Progress:
                <ProgressStep />
                break;
            case WizardStep.Finished:
                <FinishStep />
                break;
        }
    </main>

    <footer class="wizard-footer">
        @if (Vm.CurrentStep != WizardStep.Finished)
        {
            <button class="btn btn-secondary" id="btn-cancel" @onclick="Vm.Cancel">@SetupStrings.Button_Cancel</button>
        }
        <span class="spacer"></span>
        @if (Vm.CanGoBack)
        {
            <button class="btn btn-secondary" id="btn-back" @onclick="Vm.GoBack">@SetupStrings.Button_Back</button>
        }
        @switch (Vm.CurrentStep)
        {
            case WizardStep.Welcome:
            case WizardStep.Folder:
                <button class="btn btn-primary" id="btn-next" disabled="@(!Vm.CanGoNext)" @onclick="Vm.GoNextAsync">@SetupStrings.Button_Next</button>
                break;
            case WizardStep.Options:
                <button class="btn btn-success" id="btn-next" @onclick="Vm.GoNextAsync">@(Vm.IsUpdate ? SetupStrings.Button_Update : SetupStrings.Button_Install)</button>
                break;
            case WizardStep.Progress when Vm.Install.HasError:
                <button class="btn btn-primary" id="btn-retry" @onclick="Vm.RetryAsync">@SetupStrings.Button_Retry</button>
                break;
            case WizardStep.Finished:
                <button class="btn btn-primary" id="btn-finish" @onclick="Vm.Finish">@SetupStrings.Button_Finish</button>
                break;
        }
    </footer>
</div>

@code {
    // Eigenschaft statt Feld: die Beschriftungen werden bei jedem Zeichnen in der aktuellen Sprache gelesen
    private static (WizardStep Step, string Label)[] Steps =>
    [
        (WizardStep.Welcome, SetupStrings.Step_Welcome),
        (WizardStep.Folder, SetupStrings.Step_Folder),
        (WizardStep.Options, SetupStrings.Step_Options),
        (WizardStep.Progress, SetupStrings.Step_Installation),
        (WizardStep.Finished, SetupStrings.Step_Finished)
    ];

    protected override IEnumerable<INotifyPropertyChanged> ViewModels => new INotifyPropertyChanged[] { Vm, Vm.Install };

    protected override void OnInitialized()
    {
        Vm.Initialize();
        base.OnInitialized();
    }

    private string StepClass(WizardStep step) =>
        step == Vm.CurrentStep ? "active" : step < Vm.CurrentStep ? "done" : "";
}

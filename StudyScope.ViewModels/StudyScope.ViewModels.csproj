<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Texte der Oberfläche: neutrale Sprache Deutsch, typisierte Klasse VmStrings wird beim Bauen erzeugt -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\VmStrings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>StudyScope.ViewModels.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>VmStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)VmStrings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudyScope.Core\StudyScope.Core.csproj" />
  </ItemGroup>

</Project>

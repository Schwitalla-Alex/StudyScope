<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- ICU-MessageFormat mit CLDR-Pluralregeln für die Texte der Oberfläche (MIT, ohne weitere Abhängigkeiten) -->
  <ItemGroup>
    <PackageReference Include="MessageFormat" Version="8.0.0" />
  </ItemGroup>

  <!-- Sprachabhängige Daten je Sprache als Datei (Languages/<sprache>/…), siehe LanguageData.
       WithCulture=false: Ordnernamen wie „de“ sind keine Satellitenassemblies. -->
  <ItemGroup>
    <EmbeddedResource Include="Languages\**\*.txt" WithCulture="false" />
  </ItemGroup>

  <!-- Texte (Meldungen): neutrale Sprache Deutsch, typisierte Klasse CoreStrings wird beim Bauen erzeugt -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\CoreStrings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>StudyScope.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>CoreStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)CoreStrings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>

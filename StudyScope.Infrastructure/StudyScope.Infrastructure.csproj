<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.157.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Folien-CSS der App für den HTML-Video-Player (VideoPlayerHtml) – eine Quelle, gleiches Aussehen -->
    <EmbeddedResource Include="..\StudyScope.UI\wwwroot\css\studyscope-slides.css" Link="Resources\studyscope-slides.css" LogicalName="StudyScope.Infrastructure.studyscope-slides.css" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudyScope.Core\StudyScope.Core.csproj" />
  </ItemGroup>

  <!-- Texte (Meldungen InfraStrings, Exporte ExportStrings): neutrale Sprache Deutsch, typisierte Klassen werden beim Bauen erzeugt -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\InfraStrings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>StudyScope.Infrastructure.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>InfraStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)InfraStrings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ExportStrings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>StudyScope.Infrastructure.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>ExportStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)ExportStrings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>
